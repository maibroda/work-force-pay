model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String       @unique
  name            String
  passwordHash    String
  role            Role
  active          Boolean      @default(true)
  employeeId      String?      @unique
  employee        Employee?    @relation(fields: [employeeId], references: [id])
  supervisedBeats Beat[]       @relation("BeatSupervisor")
  lastLoginAt     DateTime?

  // Login rate limiting — reset on success, incremented on failure.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Bumped on logout-everywhere / password change — invalidates every outstanding session JWT at once.
  sessionVersion Int @default(1)

  // TOTP two-factor authentication (optional; not yet enforced by role).
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?
  /// Bcrypt-hashed one-time backup codes; a code is removed from the array once used.
  backupCodes    String[]  @default([])

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Single-use, short-lived password reset tokens — only the bcrypt hash is stored, never the raw token.
model PasswordResetToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
}

model NumberingRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         String // EMPLOYEE, CLIENT, CONTRACT, BEAT, PAYMENT_BATCH
  prefix         String
  separator      String       @default("-")
  digits         Int          @default(6)
  nextNumber     Int          @default(1)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entity])
}

// ─────────────────────────────── WORKFORCE ───────────────────────────────

model Department {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  employees      Employee[]
  costCenterId   String?
  costCenter     CostCenter?      @relation(fields: [costCenterId], references: [id])
  requisitions   JobRequisition[]
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// An independent cost-grouping dimension — assignable to departments, contracts, and beats — for
/// grouping costs your own way (e.g. by region or business unit) independent of the client/contract
/// structure. Feeds budgeting and cost-center reporting.
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments      Department[]
  contracts        Contract[]
  beats            Beat[]
  budgets          CostCenterBudget[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  fixedAssets      FixedAsset[]
  jobRequisitions  JobRequisition[]
  journalLines     JournalLine[]

  @@unique([organizationId, code])
}

/// A per-cost-center, per-period budget for budget-vs-actual variance reporting.
model CostCenterBudget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  costCenterId   String
  costCenter     CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  budgetedAmount Decimal      @db.Decimal(16, 2)
  notes          String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([costCenterId, year, month])
  @@index([organizationId, year, month])
}

model EmployeeCategory {
  id                   String                  @id @default(cuid())
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id])
  code                 String
  name                 String
  description          String?
  employees            Employee[]
  contractRates        ContractRate[]
  deployments          Deployment[]
  workRegister         WorkRegister[]
  requisitions         JobRequisition[]
  checklistItems       ChecklistTemplateItem[]
  kitPacks             KitPack[]
  trainingRequirements TrainingRequirement[]
  companyPolicies      CompanyPolicy[]

  @@unique([organizationId, code])
}

model Employee {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  employeeNumber     String
  firstName          String
  middleName         String?
  lastName           String
  gender             Gender?
  dateOfBirth        DateTime?        @db.Date
  phone              String?
  email              String?
  address            String?
  employmentDate     DateTime         @db.Date
  exitDate           DateTime?        @db.Date
  /// Set when the personal details were removed after the retention period (the record, employee number and pay figures stay).
  anonymizedAt       DateTime?
  status             EmployeeStatus   @default(ACTIVE)
  categoryId         String
  category           EmployeeCategory @relation(fields: [categoryId], references: [id])
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id])
  bankName           String?
  accountNumber      String?
  accountName        String?
  taxId              String?
  pensionPin         String?
  pfa                String?
  annualRent         Decimal?         @db.Decimal(14, 2) // declared rent for NTA 2025 rent relief
  currentClientId    String?
  currentClient      Client?          @relation(fields: [currentClientId], references: [id])
  currentBeatId      String?
  currentBeat        Beat?            @relation("CurrentBeat", fields: [currentBeatId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?        @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user                    User?
  deployments             Deployment[]
  movements               StaffMovement[]
  workRegister            WorkRegister[]
  salaryOverrides         EmployeeSalaryOverride[]
  payRates                EmployeePayRate[]
  payrollRecords          PayrollRecord[]
  overtime                Overtime[]
  arrears                 Arrears[]
  deductions              Deduction[]
  otherEarnings           OtherEarning[]
  validationIssues        PayrollValidationIssue[]
  paymentTxns             PaymentTransaction[]
  leaveRequests           LeaveRequest[]
  directReports           Employee[]               @relation("ReportingLine")
  documents               EmployeeDocument[]
  trainings               EmployeeTraining[]
  disciplinaryRecords     DisciplinaryRecord[]
  onboardingTasks         OnboardingTask[]
  exitRecords             ExitRecord[]
  recurringDeductionRules RecurringDeductionRule[]
  assignedFixedAssets     FixedAsset[]
  employmentContracts     EmploymentContract[]
  relationsCases          RelationsCase[]
  exitSettlements         ExitSettlement[]
  candidateRecord         Candidate?               @relation("CandidateEmployee")
  managedRequisitions     JobRequisition[]         @relation("RequisitionManager")
  stockMovements          StockMovement[]
  staffLoans              StaffLoan[]
  generatedLetters        GeneratedLetter[]
  contacts                EmployeeContact[]
  guarantors              EmployeeGuarantor[]
  changeRequests          EmployeeChangeRequest[]
  policyAcknowledgements  PolicyAcknowledgement[]
  dataAccessRequests      DataAccessRequest[]
  appraisals              Appraisal[]
  erasures                EmployeeErasure[]
  journalLines            JournalLine[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
}

// ─────────────────────────── HR / HRIS RECORDS ───────────────────────────

/// Employee documents (ID, licenses, contracts, certificates). Metadata-only — fileReference is a
/// filename/reference/description, matching the ClientInvoiceDeduction.supportingDocument convention
/// (this app has no object storage configured).
model EmployeeDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  documentNumber String?
  issueDate      DateTime?    @db.Date
  expiryDate     DateTime?    @db.Date
  fileReference  String // filename / reference / description — proof of the physical/scanned document
  notes          String?
  uploadedBy     String
  createdAt      DateTime     @default(now())

  @@index([organizationId, employeeId])
  @@index([organizationId, expiryDate])
}

/// Training & certifications — critical for a security workforce (firearms license, first aid,
/// tactical training). expiryDate drives compliance/expiry reports and alerts.
model EmployeeTraining {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseName        String
  provider          String?
  certificateNumber String?
  issueDate         DateTime       @db.Date
  expiryDate        DateTime?      @db.Date
  status            TrainingStatus @default(VALID)
  fileReference     String?
  recordedBy        String
  createdAt         DateTime       @default(now())

  @@index([organizationId, employeeId])
  @@index([organizationId, expiryDate])
}

/// Disciplinary actions and commendations — maker/checker: raised PENDING, then approved/rejected
/// (mirrors StaffMovement's request→approve pattern).
model DisciplinaryRecord {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           DisciplinaryType
  incidentDate   DateTime         @db.Date
  description    String
  actionTaken    String?
  issuedBy       String
  status         ApprovalStatus   @default(PENDING)
  approvedBy     String?
  remarks        String?
  /// The employee-relations case (investigation / hearing) this sanction came out of, if any.
  caseId         String?
  relationsCase  RelationsCase?   @relation(fields: [caseId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId, employeeId])
}

/// Per-employee onboarding checklist — standard tasks are seeded automatically on hire
/// (see ONBOARDING_TASKS); HR can also add ad-hoc tasks and check them off.
model OnboardingTask {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskName        String
  status          ChecklistStatus @default(PENDING)
  dueDate         DateTime?       @db.Date
  completedBy     String?
  completedAt     DateTime?
  notes           String?
  sortOrder       Int             @default(0)
  /// Who is expected to do it (free text — "HR", "IT", "Supervisor"), copied from the template.
  responsibleRole String?
  mandatory       Boolean         @default(true)
  createdAt       DateTime        @default(now())

  @@index([organizationId, employeeId])
}

/// Offboarding / exit management — maker/checker like StaffMovement. Approval sets Employee.status
/// + exitDate and auto-seeds the clearance checklist (see EXIT_CLEARANCE_TASKS).
model ExitRecord {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee            @relation(fields: [employeeId], references: [id])
  exitType           ExitType
  noticeDate         DateTime            @db.Date
  lastWorkingDate    DateTime            @db.Date
  reason             String
  status             ApprovalStatus      @default(PENDING)
  initiatedBy        String
  approvedBy         String?
  remarks            String?
  reasonCategory     ExitReasonCategory?
  /// Notice the employee owed under their contract (or the org default) — frozen at initiation so a
  /// later policy edit can't rewrite a settlement that's already being prepared.
  noticePeriodDays   Int?
  /// Gross-misconduct dismissal: no notice pay is owed by the employer.
  summaryDismissal   Boolean             @default(false)
  eligibleForRehire  Boolean?
  exitInterviewDate  DateTime?           @db.Date
  exitInterviewNotes String?
  exitInterviewBy    String?
  createdAt          DateTime            @default(now())

  tasks      ExitTask[]
  settlement ExitSettlement?

  @@index([organizationId, employeeId])
}

model ExitTask {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  exitRecordId     String
  exitRecord       ExitRecord      @relation(fields: [exitRecordId], references: [id], onDelete: Cascade)
  taskName         String
  status           ChecklistStatus @default(PENDING)
  completedBy      String?
  completedAt      DateTime?
  notes            String?
  sortOrder        Int             @default(0)
  dueDate          DateTime?       @db.Date
  responsibleRole  String?
  mandatory        Boolean         @default(true)
  /// When true the settlement can't be approved until this item is DONE / NOT_APPLICABLE.
  blocksSettlement Boolean         @default(true)
  /// "FINAL_SETTLEMENT" is auto-completed by the system when the settlement is approved.
  systemKey        String?
  createdAt        DateTime        @default(now())

  @@index([organizationId, exitRecordId])
}

// ───────────────────── HR LIFECYCLE: POLICY & TEMPLATES ─────────────────────

/// One per organization — every number a buyer might want to change without a code change:
/// probation/notice defaults, alert windows, offer validity, and the end-of-service rules
/// (leave encashment, gratuity, severance, notice pay). Defaults are conservative; gratuity and
/// severance ship OFF because they're jurisdiction-specific.
model HrPolicy {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Employment terms & alerts
  defaultProbationMonths Int @default(3)
  maxProbationMonths     Int @default(6)
  defaultNoticeDays      Int @default(30)
  retirementAge          Int @default(60)
  contractAlertDays      Int @default(60)
  probationAlertDays     Int @default(30)
  offerValidityDays      Int @default(14)
  relationsCaseSlaDays   Int @default(21)

  // End-of-service: shared
  /// Monthly pay ÷ this = one day's pay (30 = calendar-month convention; 26 = working days).
  dailyRateDivisor Int @default(30)

  // Leave encashment
  leaveEncashmentEnabled             Boolean     @default(true)
  leaveEncashmentBasis               EosPayBasis @default(GROSS)
  /// Only encash leave once the employee has served the leave policy's eligibility period.
  leaveEncashmentRespectsEligibility Boolean     @default(true)
  leaveEncashmentMaxDays             Int?
  leaveEncashmentTaxable             Boolean     @default(true)
  leaveEncashmentExitTypes           ExitType[]  @default([RESIGNATION, TERMINATION, END_OF_CONTRACT, RETIREMENT, DECEASED])

  // Gratuity
  gratuityEnabled      Boolean     @default(false)
  gratuityBasis        EosPayBasis @default(BASIC)
  gratuityMinYears     Int         @default(5)
  gratuityDaysPerYear  Decimal     @default(15) @db.Decimal(6, 2)
  /// Count a part-year proportionally instead of only completed years.
  gratuityPartialYears Boolean     @default(false)
  gratuityTaxable      Boolean     @default(true)
  gratuityExitTypes    ExitType[]  @default([RESIGNATION, END_OF_CONTRACT, RETIREMENT, DECEASED])

  // Severance (redundancy)
  severanceEnabled     Boolean @default(false)
  severanceDaysPerYear Decimal @default(15) @db.Decimal(6, 2)
  severanceTaxable     Boolean @default(true)

  // Notice
  noticePayEnabled      Boolean @default(true) // employer ends employment short of notice → pay in lieu
  noticeRecoveryEnabled Boolean @default(true) // employee leaves short of notice → recover the shortfall
  noticePayTaxable      Boolean @default(true)

  // Staff loans & advances (0 = no limit)
  loanMaxGrossMultiple Decimal @default(3) @db.Decimal(4, 2)
  loanMaxDeductionPct  Int     @default(33)
  advanceMaxGrossPct   Int     @default(50)

  // Personal records: contacts & guarantors (0 = not required / no limit)
  nextOfKinRequired         Int      @default(1)
  emergencyContactsRequired Int      @default(1)
  guarantorsRequired        Int      @default(2)
  /// Categories that must have guarantors; empty = every category.
  guarantorCategoryIds      String[] @default([])
  /// The most employees one person may guarantee at the same time.
  guarantorMaxPerPerson     Int      @default(3)
  /// Someone other than whoever recorded a guarantor must verify them.
  guarantorSeparateVerifier Boolean  @default(false)

  // Training compliance
  /// Flag a certificate this many days before it expires.
  trainingAlertDays Int @default(60)

  // Change control for bank, tax and pension details
  /// A change needs a second person's approval (otherwise anyone who can edit an employee can change it).
  sensitiveChangeApproval   Boolean @default(true)
  /// Payroll validation warns when an employee's bank account was changed within this many days (0 = off).
  bankChangeWatchDays       Int     @default(30)
  // Performance appraisals
  /// Employees rate themselves before their manager does.
  appraisalSelfAssessment   Boolean @default(true)
  /// A written comment is required for a rating at or below this (0 = never)…
  appraisalCommentAtOrBelow Int     @default(2)
  /// …or at or above this (0 = never).
  appraisalCommentAtOrAbove Int     @default(5)
  /// Employees with less service than this (at the period end) aren't included in a cycle.
  appraisalMinServiceDays   Int     @default(90)

  // Probation reviews
  /// A probation can only be confirmed after a signed-off probation appraisal.
  probationRequiresAppraisal Boolean @default(false)
  /// …scoring at least this (1–5; 0 = any score).
  probationMinScore          Decimal @default(0) @db.Decimal(3, 2)

  // Privacy: data subject access requests
  /// Days allowed to answer a request for a copy of someone's data, from the day it was received.
  dsarResponseDays Int @default(30)

  // Reminder digest email
  reminderEmailsEnabled Boolean   @default(true)
  /// Addresses that get the digest in addition to every active HR admin.
  reminderExtraEmails   String[]  @default([])
  lastDigestAt          DateTime?

  // Data retention: months to keep a rejected / withdrawn candidate's personal details (0 = keep for ever)
  candidateRetentionMonths Int @default(24)

  // Privacy: personal-data breaches
  /// Hours allowed to tell the regulator once the company is aware of a breach likely to put people at risk.
  breachNotifyHours Int     @default(72)
  /// Who the company has named as its data protection contact, shown on the breach pages and in the notice facts.
  dpoName           String?
  dpoEmail          String?
  dpoPhone          String?
  /// The regulator breaches are reported to, and how (portal, address, email), as the company's own procedure.
  regulatorName     String  @default("Nigeria Data Protection Commission")
  regulatorContact  String?
  /// The company's own breach procedure in its own words: who assesses, who tells whom, who signs off.
  breachRunbook     String?

  // Retention of former employees' personal details
  /// Years after leaving that records must be kept for tax and pension duties; after that they can be erased. 0 = off.
  employeeRetentionYears Int @default(0)

  // Security: roles that must use two-factor sign-in
  twoFactorRoles       Role[]    @default([])
  /// From this day the roles above can no longer use the app without two-factor; before it they are only reminded.
  twoFactorEnforceFrom DateTime? @db.Date

  updatedAt DateTime @updatedAt
}

/// A checklist step that is instantiated onto every new hire (ONBOARDING) or every approved exit
/// (EXIT_CLEARANCE). Edited in Settings so each buyer's own process is what gets seeded.
model ChecklistTemplateItem {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  kind             ChecklistKind
  taskName         String
  /// Onboarding: days after the start date. Exit: days relative to the last working date (negative = before).
  dueOffsetDays    Int               @default(0)
  responsibleRole  String?
  mandatory        Boolean           @default(true)
  /// Exit only — see ExitTask.blocksSettlement.
  blocksSettlement Boolean           @default(true)
  systemKey        String?
  /// Limit the step to one employee category (null = everyone).
  categoryId       String?
  category         EmployeeCategory? @relation(fields: [categoryId], references: [id])
  active           Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, kind, taskName])
  @@index([organizationId, kind, active])
}

// ───────────────────────── HR LIFECYCLE: CONTRACTS ─────────────────────────

/// The employee's own terms of employment (distinct from `Contract`, which is a CLIENT service
/// contract). Renewals form a chain via previousContractId; exactly one contract per employee is
/// ACTIVE at a time (enforced in the service).
model EmploymentContract {
  id                  String                   @id @default(cuid())
  organizationId      String
  organization        Organization             @relation(fields: [organizationId], references: [id])
  contractNumber      String
  employeeId          String
  employee            Employee                 @relation(fields: [employeeId], references: [id])
  type                EmploymentType
  status              EmploymentContractStatus @default(ACTIVE)
  jobTitle            String
  startDate           DateTime                 @db.Date
  endDate             DateTime?                @db.Date
  probationMonths     Int                      @default(0)
  probationEndDate    DateTime?                @db.Date
  probationOutcome    ProbationOutcome?
  probationExtensions Int                      @default(0)
  noticePeriodDays    Int                      @default(30)
  signedDate          DateTime?                @db.Date
  documentReference   String?
  previousContractId  String?
  previousContract    EmploymentContract?      @relation("ContractChain", fields: [previousContractId], references: [id])
  renewals            EmploymentContract[]     @relation("ContractChain")
  terminatedAt        DateTime?                @db.Date
  terminationReason   String?
  notes               String?
  createdBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, contractNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, status, endDate])
}

// ──────────────────────── HR LIFECYCLE: RECRUITMENT ────────────────────────

model JobRequisition {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])
  requisitionNumber    String
  title                String
  departmentId         String?
  department           Department?       @relation(fields: [departmentId], references: [id])
  categoryId           String
  category             EmployeeCategory  @relation(fields: [categoryId], references: [id])
  costCenterId         String?
  costCenter           CostCenter?       @relation(fields: [costCenterId], references: [id])
  /// Free reference to the beat/location being staffed — validated in the service.
  beatId               String?
  hiringManagerId      String?
  hiringManager        Employee?         @relation("RequisitionManager", fields: [hiringManagerId], references: [id])
  headcount            Int               @default(1)
  employmentType       EmploymentType    @default(PERMANENT)
  budgetedMonthlyGross Decimal?          @db.Decimal(14, 2)
  justification        String
  targetStartDate      DateTime?         @db.Date
  status               RequisitionStatus @default(PENDING_APPROVAL)
  requestedBy          String
  requestedById        String
  approvedBy           String?
  approvedAt           DateTime?
  decisionNote         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  candidates Candidate[]

  @@unique([organizationId, requisitionNumber])
  @@index([organizationId, status])
}

model Candidate {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  candidateNumber      String
  requisitionId        String
  requisition          JobRequisition  @relation(fields: [requisitionId], references: [id])
  firstName            String
  lastName             String
  phone                String?
  email                String?
  source               CandidateSource @default(OTHER)
  stage                CandidateStage  @default(APPLIED)
  expectedMonthlyGross Decimal?        @db.Decimal(14, 2)
  resumeReference      String?
  notes                String?
  rejectionReason      String?
  stageChangedAt       DateTime        @default(now())
  /// Set once the candidate is converted into an employee.
  employeeId           String?         @unique
  employee             Employee?       @relation("CandidateEmployee", fields: [employeeId], references: [id])
  /// Set when the candidate's personal details were removed under the retention rule.
  anonymizedAt         DateTime?
  createdBy            String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  interviews Interview[]
  checks     CandidateCheck[]
  offers     JobOffer[]

  @@unique([organizationId, candidateNumber])
  @@index([organizationId, requisitionId, stage])
}

model Interview {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round          Int                      @default(1)
  scheduledAt    DateTime
  mode           String?
  interviewer    String
  /// 1–5 scorecard rating, set when feedback is recorded.
  score          Int?
  recommendation InterviewRecommendation?
  feedback       String?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime                 @default(now())

  @@index([organizationId, candidateId])
}

/// Pre-employment vetting step (references, ID, police clearance, guarantor, medical…). A candidate
/// can't be hired while any check is still PENDING or FAILED.
model CandidateCheck {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checkType      CandidateCheckType
  status         CheckStatus        @default(PENDING)
  notes          String?
  checkedBy      String?
  checkedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@unique([candidateId, checkType])
  @@index([organizationId, candidateId])
}

model JobOffer {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  offerNumber      String
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id])
  jobTitle         String
  monthlyGross     Decimal        @db.Decimal(14, 2)
  employmentType   EmploymentType @default(PERMANENT)
  probationMonths  Int            @default(0)
  noticePeriodDays Int            @default(30)
  startDate        DateTime       @db.Date
  validUntil       DateTime       @db.Date
  /// Create an effective-dated personal pay rate on hire (office staff). Guards are normally paid
  /// from the client contract's agreed rates, so this is switched off for them.
  setPayRate       Boolean        @default(true)
  status           OfferStatus    @default(PENDING_APPROVAL)
  createdBy        String
  createdById      String
  approvedBy       String?
  approvedAt       DateTime?
  sentAt           DateTime?
  respondedAt      DateTime?
  declineReason    String?
  decisionNote     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([organizationId, offerNumber])
  @@index([organizationId, candidateId])
  @@index([organizationId, status])
}

// ─────────────────────── HR LIFECYCLE: EMPLOYEE RELATIONS ───────────────────────

model RelationsCase {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  caseNumber     String
  /// The employee the case is about (the complainant for a grievance, the subject for misconduct).
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  type           RelationsCaseType
  severity       CaseSeverity      @default(MEDIUM)
  status         CaseStatus        @default(OPEN)
  /// Confidential cases show only their existence (not content) to read-only HR viewers.
  confidential   Boolean           @default(false)
  summary        String
  description    String
  raisedBy       String
  raisedByUserId String
  selfRaised     Boolean           @default(false)
  assignedTo     String?
  openedAt       DateTime          @default(now())
  dueDate        DateTime?         @db.Date
  outcome        CaseOutcome?
  resolution     String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  closedBy       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  notes               RelationsCaseNote[]
  disciplinaryRecords DisciplinaryRecord[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

/// Append-only case file entries — never edited or deleted, so the investigation record is intact.
model RelationsCaseNote {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  caseId         String
  relationsCase  RelationsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind           CaseNoteKind  @default(NOTE)
  note           String
  authorName     String
  authorUserId   String
  createdAt      DateTime      @default(now())

  @@index([organizationId, caseId])
}

// ─────────────────────── END-OF-SERVICE SETTLEMENT ───────────────────────

/// What an exiting employee is owed (or owes) beyond their final month's pay. Computed from the
/// HrPolicy, reviewed and approved (preparer ≠ approver), then RELEASED into a payroll period as
/// approved OtherEarning / Deduction rows — so PAYE, pension, payslips, payment batches and GL
/// posting all happen in the normal payroll run (or a supplementary run for a locked period).
model ExitSettlement {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id])
  settlementNumber    String
  exitRecordId        String           @unique
  exitRecord          ExitRecord       @relation(fields: [exitRecordId], references: [id])
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id])
  status              SettlementStatus @default(DRAFT)
  /// Reference monthly pay the formulas used (snapshot) and how it was found.
  monthlyGross        Decimal          @db.Decimal(14, 2)
  monthlyBasic        Decimal          @db.Decimal(14, 2)
  dailyRate           Decimal          @db.Decimal(14, 2)
  payBasisSource      String
  serviceDays         Int
  serviceYears        Decimal          @db.Decimal(6, 2)
  leaveAccruedDays    Decimal          @default(0) @db.Decimal(6, 2)
  leaveTakenDays      Decimal          @default(0) @db.Decimal(6, 2)
  leavePayableDays    Decimal          @default(0) @db.Decimal(6, 2)
  noticeRequiredDays  Int              @default(0)
  noticeServedDays    Int              @default(0)
  noticeShortfallDays Int              @default(0)
  grossEarnings       Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions     Decimal          @default(0) @db.Decimal(14, 2)
  netSettlement       Decimal          @default(0) @db.Decimal(14, 2)
  payrollPeriodId     String?
  payrollPeriod       PayrollPeriod?   @relation(fields: [payrollPeriodId], references: [id])
  preparedBy          String
  preparedById        String
  computedAt          DateTime         @default(now())
  submittedAt         DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  releasedBy          String?
  releasedAt          DateTime?
  remarks             String?
  calcTrace           Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  lines ExitSettlementLine[]

  @@unique([organizationId, settlementNumber])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

model ExitSettlementLine {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  settlementId   String
  settlement     ExitSettlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  kind           SettlementLineKind
  /// LEAVE_ENCASHMENT, GRATUITY, SEVERANCE, NOTICE_PAY, NOTICE_RECOVERY, or a manual code.
  code           String
  description    String
  quantity       Decimal?           @db.Decimal(8, 2)
  rate           Decimal?           @db.Decimal(14, 2)
  amount         Decimal            @db.Decimal(14, 2)
  taxable        Boolean            @default(true)
  /// Manual lines (loan recovery, unreturned property, ex-gratia…) survive a recompute.
  manual         Boolean            @default(false)
  /// Traceability once released: the payroll input rows this line became.
  otherEarningId String?
  deductionId    String?
  /// Set when the line recovers the balance of a staff loan.
  loanId         String?
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  @@index([organizationId, settlementId])
}

// ─────────────────────────────── CLIENTS ───────────────────────────────

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  contactPerson  String?
  address        String?
  phone          String?
  email          String?
  status         ClientStatus @default(ACTIVE)
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts         Contract[]
  beats             Beat[]
  employees         Employee[]
  deployments       Deployment[]
  workRegister      WorkRegister[]
  overtime          Overtime[]
  allocations       PayrollAllocation[]
  movementsFrom     StaffMovement[]          @relation("MoveFromClient")
  movementsTo       StaffMovement[]          @relation("MoveToClient")
  invoices          ClientInvoice[]
  receipts          ClientReceipt[]
  invoiceDeductions ClientInvoiceDeduction[]
  journalLines      JournalLine[]

  @@unique([organizationId, code])
}

model Contract {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  contractNumber     String
  name               String
  startDate          DateTime         @db.Date
  endDate            DateTime?        @db.Date
  contractValue      Decimal?         @db.Decimal(16, 2)
  billingMethod      BillingMethod    @default(PER_HEAD_MONTHLY)
  status             ContractStatus   @default(ACTIVE)
  operativeSharePct  Decimal          @default(70) @db.Decimal(5, 2) // 70:30 sharing ratio
  businessLine       BusinessLine     @default(GUARDING) // drives which employer add-on costs apply
  defaultStructureId String?
  defaultStructure   SalaryStructure? @relation(fields: [defaultStructureId], references: [id])
  costCenterId       String?
  costCenter         CostCenter?      @relation(fields: [costCenterId], references: [id])
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rates         ContractRate[]
  beats         Beat[]
  deployments   Deployment[]
  workRegister  WorkRegister[]
  overtime      Overtime[]
  allocations   PayrollAllocation[]
  invoiceLines  ClientInvoiceLine[]
  movementsFrom StaffMovement[]     @relation("MoveFromContract")
  movementsTo   StaffMovement[]     @relation("MoveToContract")
  journalLines  JournalLine[]
  /// Which service this contract is billed as; its billing rule applies unless the contract has an approved override.
  serviceTypeId String?
  serviceType   ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  billingRules  BillingRule[]

  @@unique([organizationId, contractNumber])
}

/// CLIENT → CONTRACT → EMPLOYEE CATEGORY → SALARY STRUCTURE → AGREED RATE (effective-dated)
model ContractRate {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  contractId        String
  contract          Contract         @relation(fields: [contractId], references: [id])
  categoryId        String
  category          EmployeeCategory @relation(fields: [categoryId], references: [id])
  salaryStructureId String
  salaryStructure   SalaryStructure  @relation(fields: [salaryStructureId], references: [id])
  agreedRate        Decimal          @db.Decimal(14, 2) // amount billed to client per head per month
  operativeSharePct Decimal?         @db.Decimal(5, 2) // overrides contract share when set
  effectiveFrom     DateTime         @db.Date
  effectiveTo       DateTime?        @db.Date
  createdAt         DateTime         @default(now())

  @@index([organizationId, contractId, categoryId])
}

model Beat {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id])
  contractId       String
  contract         Contract     @relation(fields: [contractId], references: [id])
  code             String
  name             String
  bidReference     String?
  region           String?
  state            String?
  lga              String?
  address          String?
  siteContact      String?
  approvedStrength Int          @default(0)
  status           BeatStatus   @default(UNMAPPED)
  startDate        DateTime?    @db.Date
  endDate          DateTime?    @db.Date
  supervisorId     String?
  supervisor       User?        @relation("BeatSupervisor", fields: [supervisorId], references: [id])
  costCenterId     String?
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  currentEmployees        Employee[]               @relation("CurrentBeat")
  deployments             Deployment[]
  workRegister            WorkRegister[]
  overtime                Overtime[]
  allocations             PayrollAllocation[]
  movementsFrom           StaffMovement[]          @relation("MoveFromBeat")
  movementsTo             StaffMovement[]          @relation("MoveToBeat")
  invoiceLines            ClientInvoiceLine[]
  recurringDeductionRules RecurringDeductionRule[]
  journalLines            JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, clientId])
}

// ─────────────────────────── SALARY STRUCTURES ───────────────────────────

model SalaryStructure {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  code              String
  name              String
  description       String?
  calculationMethod StructureMethod @default(PERCENTAGE_OF_GROSS)
  isPartial         Boolean         @default(false)
  isDefault         Boolean         @default(false)
  status            StructureStatus @default(DRAFT)
  effectiveFrom     DateTime        @db.Date
  effectiveTo       DateTime?       @db.Date
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  components    SalaryComponent[]
  contractRates ContractRate[]
  contracts     Contract[]

  @@unique([organizationId, code])
}

model SalaryComponent {
  id           String            @id @default(cuid())
  structureId  String
  structure    SalaryStructure   @relation(fields: [structureId], references: [id], onDelete: Cascade)
  code         String
  name         String
  calcType     ComponentCalcType @default(PERCENTAGE)
  percentage   Decimal?          @db.Decimal(7, 4)
  fixedAmount  Decimal?          @db.Decimal(14, 2)
  formula      String?
  taxable      Boolean           @default(true)
  pensionable  Boolean           @default(false)
  employerCost Boolean           @default(false)
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)

  @@unique([structureId, code])
}

/// Employee-specific component override (never overwrites the base structure)
model EmployeeSalaryOverride {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  componentCode  String
  calcType       ComponentCalcType @default(PERCENTAGE)
  percentage     Decimal?          @db.Decimal(7, 4)
  fixedAmount    Decimal?          @db.Decimal(14, 2)
  reason         String
  effectiveFrom  DateTime          @db.Date
  effectiveTo    DateTime?         @db.Date
  approvedBy     String
  status         ApprovalStatus    @default(APPROVED)
  createdAt      DateTime          @default(now())

  @@index([organizationId, employeeId])
}

/// Employee-specific monthly gross (e.g. office staff / supervisors not billed per head), effective-dated
model EmployeePayRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  monthlyGross   Decimal      @db.Decimal(14, 2)
  structureCode  String? // structure used to split gross; default structure when empty
  reason         String
  approvedBy     String
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  @@index([organizationId, employeeId])
}

// ─────────────────────────────── OPERATIONS ───────────────────────────────

model Deployment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  contractId     String
  contract       Contract         @relation(fields: [contractId], references: [id])
  beatId         String
  beat           Beat             @relation(fields: [beatId], references: [id])
  categoryId     String
  category       EmployeeCategory @relation(fields: [categoryId], references: [id])
  shift          Shift            @default(FULL)
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         DeploymentStatus @default(ACTIVE)
  movementId     String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, employeeId])
  @@index([organizationId, beatId])
}

model StaffMovement {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  movementType   MovementType
  fromClientId   String?
  fromClient     Client?        @relation("MoveFromClient", fields: [fromClientId], references: [id])
  fromContractId String?
  fromContract   Contract?      @relation("MoveFromContract", fields: [fromContractId], references: [id])
  fromBeatId     String?
  fromBeat       Beat?          @relation("MoveFromBeat", fields: [fromBeatId], references: [id])
  toClientId     String
  toClient       Client         @relation("MoveToClient", fields: [toClientId], references: [id])
  toContractId   String
  toContract     Contract       @relation("MoveToContract", fields: [toContractId], references: [id])
  toBeatId       String
  toBeat         Beat           @relation("MoveToBeat", fields: [toBeatId], references: [id])
  movementDate   DateTime       @db.Date
  effectiveDate  DateTime       @db.Date
  endDate        DateTime?      @db.Date // for temporary/relief movements
  reason         String
  requestedBy    String
  approvedBy     String?
  status         ApprovalStatus @default(PENDING)
  remarks        String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, employeeId])
}

/// Operational source of truth for WHERE an employee worked on each day.
model WorkRegister {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  date             DateTime         @db.Date
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id])
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  contractId       String
  contract         Contract         @relation(fields: [contractId], references: [id])
  beatId           String
  beat             Beat             @relation(fields: [beatId], references: [id])
  categoryId       String
  category         EmployeeCategory @relation(fields: [categoryId], references: [id])
  shift            Shift            @default(FULL)
  attendanceStatus AttendanceStatus
  hoursWorked      Decimal          @default(0) @db.Decimal(5, 2)
  overtimeHours    Decimal          @default(0) @db.Decimal(5, 2)
  supervisor       String?
  remarks          String?
  source           EntrySource      @default(MANUAL)
  locationMismatch Boolean          @default(false)
  mismatchResolved Boolean          @default(false)
  resolutionNote   String?
  recordedBy       String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, beatId, date])
}

// ─────────────────────────────── PAYROLL ───────────────────────────────

model PayrollPeriod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  year           Int
  month          Int
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  status         PeriodStatus @default(OPEN)
  approvedBy     String?
  approvedAt     DateTime?
  lockedBy       String?
  lockedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs             PayrollRun[]
  overtime         Overtime[]
  deductions       Deduction[]
  otherEarnings    OtherEarning[]
  arrearsOriginal  Arrears[]        @relation("ArrearsOriginal")
  arrearsProcessed Arrears[]        @relation("ArrearsProcessed")
  invoices         ClientInvoice[]
  exitSettlements  ExitSettlement[]

  @@unique([organizationId, year, month])
}

model PayrollRun {
  id                             String        @id @default(cuid())
  organizationId                 String
  organization                   Organization  @relation(fields: [organizationId], references: [id])
  periodId                       String
  period                         PayrollPeriod @relation(fields: [periodId], references: [id])
  runNumber                      Int
  type                           RunType       @default(REGULAR)
  status                         RunStatus     @default(DRAFT)
  description                    String?
  taxRuleVersion                 String?
  pensionRuleVersion             String?
  employeeCount                  Int           @default(0)
  totalGross                     Decimal       @default(0) @db.Decimal(16, 2)
  totalNet                       Decimal       @default(0) @db.Decimal(16, 2)
  totalPaye                      Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployeePension           Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerPension           Decimal       @default(0) @db.Decimal(16, 2)
  totalDeductions                Decimal       @default(0) @db.Decimal(16, 2)
  totalOvertime                  Decimal       @default(0) @db.Decimal(16, 2)
  totalArrears                   Decimal       @default(0) @db.Decimal(16, 2)
  totalClientBilling             Decimal       @default(0) @db.Decimal(16, 2)
  totalManagementShare           Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerCost              Decimal       @default(0) @db.Decimal(16, 2)
  // Guarding/outsourcing employer add-on costs (see PayrollGlMapping / EmployerCostRule) — zero for
  // back-office (pay-rate, no contract) staff.
  totalItf                       Decimal       @default(0) @db.Decimal(16, 2)
  totalNsitf                     Decimal       @default(0) @db.Decimal(16, 2)
  totalNhfMedical                Decimal       @default(0) @db.Decimal(16, 2)
  totalInsurance                 Decimal       @default(0) @db.Decimal(16, 2)
  totalUniformKits               Decimal       @default(0) @db.Decimal(16, 2)
  totalRecruitmentTraining       Decimal       @default(0) @db.Decimal(16, 2)
  totalLeaveReliever             Decimal       @default(0) @db.Decimal(16, 2)
  totalOutsourcingLeaveAllowance Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerAddOns            Decimal       @default(0) @db.Decimal(16, 2)
  calculatedBy                   String?
  calculatedAt                   DateTime?
  calculationCount               Int           @default(0)
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  records        PayrollRecord[]
  allocations    PayrollAllocation[]
  issues         PayrollValidationIssue[]
  paymentBatches PaymentBatch[]
  remittances    StatutoryRemittance[]
  journalEntry   JournalEntry?
  invoices       ClientInvoice[]

  @@unique([periodId, runNumber])
}

model PayrollRecord {
  id                              String       @id @default(cuid())
  organizationId                  String
  organization                    Organization @relation(fields: [organizationId], references: [id])
  runId                           String
  run                             PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId                      String
  employee                        Employee     @relation(fields: [employeeId], references: [id])
  employeeNumber                  String
  employeeName                    String
  categoryName                    String
  departmentName                  String?
  bankName                        String?
  accountNumber                   String?
  accountName                     String?
  pensionPin                      String?
  pfa                             String?
  taxId                           String?
  basisDays                       Int
  daysWorked                      Decimal      @db.Decimal(6, 2)
  daysAbsent                      Int          @default(0)
  suspensionDays                  Int          @default(0)
  overtimeHours                   Decimal      @default(0) @db.Decimal(8, 2)
  monthlyGross                    Decimal      @db.Decimal(14, 2) // full-month contractual operative gross
  earnedGross                     Decimal      @db.Decimal(14, 2) // prorated structure earnings
  overtimeAmount                  Decimal      @default(0) @db.Decimal(14, 2)
  arrearsAmount                   Decimal      @default(0) @db.Decimal(14, 2)
  otherEarnings                   Decimal      @default(0) @db.Decimal(14, 2)
  totalEarnings                   Decimal      @db.Decimal(14, 2)
  pensionBase                     Decimal      @db.Decimal(14, 2)
  employeePension                 Decimal      @db.Decimal(14, 2)
  employerPension                 Decimal      @db.Decimal(14, 2)
  taxableIncome                   Decimal      @db.Decimal(14, 2)
  paye                            Decimal      @db.Decimal(14, 2)
  otherDeductions                 Decimal      @default(0) @db.Decimal(14, 2)
  totalDeductions                 Decimal      @db.Decimal(14, 2)
  netPay                          Decimal      @db.Decimal(14, 2)
  clientBilling                   Decimal      @default(0) @db.Decimal(14, 2)
  managementShare                 Decimal      @default(0) @db.Decimal(14, 2)
  employerCost                    Decimal      @db.Decimal(14, 2)
  // Guarding/outsourcing employer add-on costs — see EmployerCostRule. Zero for back-office staff.
  itfAmount                       Decimal      @default(0) @db.Decimal(14, 2)
  nsitfAmount                     Decimal      @default(0) @db.Decimal(14, 2)
  nhfMedicalAmount                Decimal      @default(0) @db.Decimal(14, 2)
  insuranceAmount                 Decimal      @default(0) @db.Decimal(14, 2)
  uniformKitsAmount               Decimal      @default(0) @db.Decimal(14, 2)
  recruitmentTrainingAmount       Decimal      @default(0) @db.Decimal(14, 2)
  leaveRelieverAmount             Decimal      @default(0) @db.Decimal(14, 2)
  outsourcingLeaveAllowanceAmount Decimal      @default(0) @db.Decimal(14, 2)
  totalEmployerAddOns             Decimal      @default(0) @db.Decimal(14, 2)
  /// GUARDING / OUTSOURCING when every paid segment shares one business line, BACK_OFFICE when the
  /// employee has no contract segments at all (pay-rate only), MIXED otherwise.
  businessLine                    String       @default("BACK_OFFICE")
  taxRuleVersion                  String
  hasOverride                     Boolean      @default(false)
  lines                           Json // [{type, code, name, amount}]
  locations                       Json // [{clientName, beatName, days, from, to}]
  calcTrace                       Json?
  createdAt                       DateTime     @default(now())

  allocations PayrollAllocation[]
  paymentTxns PaymentTransaction[]

  @@unique([runId, employeeId])
  @@index([organizationId, employeeId])
}

/// Split of every payroll record by client / contract / beat — powers client & beat reports.
model PayrollAllocation {
  id                        String        @id @default(cuid())
  organizationId            String
  organization              Organization  @relation(fields: [organizationId], references: [id])
  runId                     String
  run                       PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordId                  String
  record                    PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  employeeId                String
  clientId                  String?
  client                    Client?       @relation(fields: [clientId], references: [id])
  contractId                String?
  contract                  Contract?     @relation(fields: [contractId], references: [id])
  beatId                    String?
  beat                      Beat?         @relation(fields: [beatId], references: [id])
  days                      Decimal       @db.Decimal(6, 2)
  grossAmount               Decimal       @db.Decimal(14, 2)
  overtimeAmount            Decimal       @default(0) @db.Decimal(14, 2)
  employerPension           Decimal       @db.Decimal(14, 2)
  clientBilling             Decimal       @db.Decimal(14, 2)
  managementShare           Decimal       @db.Decimal(14, 2)
  // Individual employer add-on costs attributable to this client/contract/beat (see EmployerCostRule).
  itf                       Decimal       @default(0) @db.Decimal(14, 2)
  nsitf                     Decimal       @default(0) @db.Decimal(14, 2)
  nhfMedical                Decimal       @default(0) @db.Decimal(14, 2)
  insurance                 Decimal       @default(0) @db.Decimal(14, 2)
  uniformKits               Decimal       @default(0) @db.Decimal(14, 2)
  recruitmentTraining       Decimal       @default(0) @db.Decimal(14, 2)
  leaveReliever             Decimal       @default(0) @db.Decimal(14, 2)
  outsourcingLeaveAllowance Decimal       @default(0) @db.Decimal(14, 2)
  /// Sum of the individual costs above — ITF + NSITF + insurance + uniform&kits + recruitment/training
  /// + leave reliever + outsourcing leave allowance (+ NHF/medical if configured).
  businessCosts             Decimal       @default(0) @db.Decimal(14, 2)
  netAmount                 Decimal       @default(0) @db.Decimal(14, 2)

  @@index([organizationId, runId, clientId, beatId])
}

model PayrollValidationIssue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId     String?
  employee       Employee?    @relation(fields: [employeeId], references: [id])
  category       String // POPULATION, SALARY, ATTENDANCE, LOCATION, BANK, PENSION, PAYE, OVERTIME, ARREARS, DEDUCTIONS, DUPLICATES
  severity       Severity
  code           String
  message        String
  resolved       Boolean      @default(false)
  overridden     Boolean      @default(false)
  overrideReason String?
  overriddenBy   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, runId, severity])
}

model Overtime {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id])
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  contractId        String
  contract          Contract       @relation(fields: [contractId], references: [id])
  beatId            String
  beat              Beat           @relation(fields: [beatId], references: [id])
  periodId          String
  period            PayrollPeriod  @relation(fields: [periodId], references: [id])
  date              DateTime       @db.Date
  hours             Decimal        @db.Decimal(6, 2)
  rate              Decimal?       @db.Decimal(12, 2) // hourly rate; computed when empty
  amount            Decimal        @db.Decimal(14, 2)
  approvalReference String?
  approvedBy        String?
  source            EntrySource    @default(CLIENT_SCHEDULE)
  status            ApprovalStatus @default(PENDING)
  createdBy         String
  createdAt         DateTime       @default(now())

  @@index([organizationId, periodId, employeeId])
}

model Arrears {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id])
  originalPeriodId   String
  originalPeriod     PayrollPeriod  @relation("ArrearsOriginal", fields: [originalPeriodId], references: [id])
  arrearsType        ArrearsType
  originalAmount     Decimal        @db.Decimal(14, 2)
  correctedAmount    Decimal        @db.Decimal(14, 2)
  difference         Decimal        @db.Decimal(14, 2)
  grossImpact        Decimal        @db.Decimal(14, 2)
  pensionableImpact  Decimal        @default(0) @db.Decimal(14, 2)
  taxImpact          Decimal        @default(0) @db.Decimal(14, 2)
  pensionImpact      Decimal        @default(0) @db.Decimal(14, 2)
  netImpact          Decimal        @default(0) @db.Decimal(14, 2)
  reason             String
  supportingDocument String?
  requestedBy        String
  approvedBy         String?
  status             ApprovalStatus @default(PENDING)
  processedPeriodId  String?
  processedPeriod    PayrollPeriod? @relation("ArrearsProcessed", fields: [processedPeriodId], references: [id])
  processedRunId     String?
  createdAt          DateTime       @default(now())

  @@index([organizationId, employeeId])
}

model Deduction {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id])
  deductionType      DeductionType
  amount             Decimal        @db.Decimal(14, 2)
  periodId           String
  period             PayrollPeriod  @relation(fields: [periodId], references: [id])
  reason             String
  authorityReference String
  supportingDocument String?
  requestedBy        String
  approvedBy         String?
  status             ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now())

  @@index([organizationId, periodId])
}

/// Recurring payroll deductions applied automatically on every REGULAR run — distinct from the
/// one-off, per-instance-approved Deduction model above. Scope determines who it applies to:
/// GLOBAL (every paid employee that period), LOCATION (everyone who worked any day at the given
/// beat that period), INDIVIDUAL (one named employee). Never applied on supplementary runs, to
/// avoid double-charging within the same period.
model RecurringDeductionRule {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id])
  name           String
  /// Short code — becomes the payslip line / GL head code (e.g. "DEV_LEVY").
  code           String
  scope          DeductionScope
  beatId         String?
  beat           Beat?                      @relation(fields: [beatId], references: [id])
  employeeId     String?
  employee       Employee?                  @relation(fields: [employeeId], references: [id])
  calcType       RecurringDeductionCalcType
  /// % of the employee's total earnings for the period, when calcType = PERCENTAGE_OF_GROSS.
  percentage     Decimal?                   @db.Decimal(6, 3)
  fixedAmount    Decimal?                   @db.Decimal(14, 2)
  active         Boolean                    @default(true)
  effectiveFrom  DateTime                   @db.Date
  effectiveTo    DateTime?                  @db.Date
  reason         String
  createdBy      String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, scope])
  @@index([organizationId, beatId])
  @@index([organizationId, employeeId])
}

model OtherEarning {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  periodId       String
  period         PayrollPeriod  @relation(fields: [periodId], references: [id])
  name           String
  amount         Decimal        @db.Decimal(14, 2)
  taxable        Boolean        @default(true)
  reason         String
  approvedBy     String?
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
}

// ─────────────────────────── STATUTORY RULES ───────────────────────────

model TaxRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  version        String
  legalBasis     String?
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  bands      TaxBand[]
  reliefs    TaxRelief[]
  exemptions TaxExemption[]

  @@unique([organizationId, code, version])
}

model TaxBand {
  id         String   @id @default(cuid())
  taxRuleId  String
  taxRule    TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  sortOrder  Int
  lowerBound Decimal  @db.Decimal(16, 2)
  upperBound Decimal? @db.Decimal(16, 2)
  rate       Decimal  @db.Decimal(6, 3)
}

model TaxRelief {
  id        String     @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule    @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      ReliefType
  rate      Decimal?   @db.Decimal(7, 4)
  amount    Decimal?   @db.Decimal(16, 2)
  cap       Decimal?   @db.Decimal(16, 2)
  active    Boolean    @default(true)
}

model TaxExemption {
  id                 String  @id @default(cuid())
  taxRuleId          String
  taxRule            TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  code               String
  description        String
  annualGrossCeiling Decimal @db.Decimal(16, 2) // gross at or below this is exempt
  active             Boolean @default(true)
}

model PensionRule {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  version          String
  employeeRate     Decimal      @db.Decimal(6, 3)
  employerRate     Decimal      @db.Decimal(6, 3)
  pensionableCodes String[]
  effectiveFrom    DateTime     @db.Date
  effectiveTo      DateTime?    @db.Date
  createdAt        DateTime     @default(now())
}

model PayrollRule {
  id                       String         @id @default(cuid())
  organizationId           String
  organization             Organization   @relation(fields: [organizationId], references: [id])
  version                  String
  prorationBasis           ProrationBasis @default(CALENDAR_DAYS)
  defaultOperativeSharePct Decimal        @default(70) @db.Decimal(5, 2)
  standardHoursPerDay      Decimal        @default(12) @db.Decimal(5, 2)
  overtimeMultiplier       Decimal        @default(1.5) @db.Decimal(5, 2)
  maxOvertimeHoursPerMonth Decimal        @default(60) @db.Decimal(6, 2)
  maxDeductionPctOfGross   Decimal        @default(33.33) @db.Decimal(5, 2)
  /// Overhead allocation used in Contract Profitability — % of contract revenue charged as back-office cost.
  backOfficeChargePct      Decimal        @default(15) @db.Decimal(5, 2)
  effectiveFrom            DateTime       @db.Date
  effectiveTo              DateTime?      @db.Date
  createdAt                DateTime       @default(now())
}

/// Employer add-on costs beyond employer pension, specific to guarding / outsourcing contracts.
/// ITF and NSITF-ECA are % of gross salary; the rest are % of (management fee less pension employer,
/// ITF, NSITF and NHF/medical if configured). Uniform & Kits applies to GUARDING only; Outsourcing
/// Leave Allowance (% of Basic) applies to OUTSOURCING only. Back-office (no-contract) pay is unaffected.
model EmployerCostRule {
  id                           String       @id @default(cuid())
  organizationId               String
  organization                 Organization @relation(fields: [organizationId], references: [id])
  version                      String
  itfPct                       Decimal      @default(1) @db.Decimal(5, 2)
  nsitfPct                     Decimal      @default(1) @db.Decimal(5, 2)
  nhfMedicalPct                Decimal      @default(0) @db.Decimal(5, 2) // 0 = not provided
  insurancePct                 Decimal      @default(7.5) @db.Decimal(5, 2)
  uniformKitsPct               Decimal      @default(25) @db.Decimal(5, 2) // GUARDING only
  recruitmentTrainingPct       Decimal      @default(10.5) @db.Decimal(5, 2)
  leaveRelieverPct             Decimal      @default(22) @db.Decimal(5, 2)
  outsourcingLeaveAllowancePct Decimal      @default(20) @db.Decimal(5, 2) // OUTSOURCING only, % of Basic
  effectiveFrom                DateTime     @db.Date
  effectiveTo                  DateTime?    @db.Date
  createdAt                    DateTime     @default(now())
}

// ─────────────────────────────── PAYMENTS ───────────────────────────────

model PaymentBatch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun    @relation(fields: [runId], references: [id])
  batchNumber    String
  bankName       String
  totalAmount    Decimal       @db.Decimal(16, 2)
  count          Int
  status         PaymentStatus @default(PENDING)
  createdBy      String
  createdAt      DateTime      @default(now())

  transactions PaymentTransaction[]

  @@unique([organizationId, batchNumber])
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  batchId        String
  batch          PaymentBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordId       String
  record         PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  bankName       String?
  accountNumber  String?
  accountName    String?
  status         PaymentStatus @default(PENDING)
  bankReference  String?
  reconciled     Boolean       @default(false)
  reconciledAt   DateTime?
}

model StatutoryRemittance {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun     @relation(fields: [runId], references: [id])
  type           RemittanceType
  payee          String // PFA name or tax authority
  employeeAmount Decimal        @db.Decimal(16, 2)
  employerAmount Decimal        @db.Decimal(16, 2)
  totalAmount    Decimal        @db.Decimal(16, 2)
  headcount      Int
  status         PaymentStatus  @default(PENDING)
  reference      String?
  createdAt      DateTime       @default(now())
}

// ───────────────────────── CLIENT BILLING / INVOICING ─────────────────────────

/// One invoice per client per payroll run, generated from that run's client billing
/// (payrollByClientAndBeat) — the accounts-receivable side of payroll, never edited once issued.
model ClientInvoice {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  runId               String
  run                 PayrollRun    @relation(fields: [runId], references: [id])
  periodId            String
  period              PayrollPeriod @relation(fields: [periodId], references: [id])
  invoiceNumber       String
  invoiceDate         DateTime      @db.Date
  dueDate             DateTime      @db.Date
  subtotal            Decimal       @db.Decimal(16, 2)
  /// Each line's charge-out amount is split direct/indirect (defaults 90%/10%) — see ClientInvoiceLine.
  /// VAT is charged on the indirect-charge total only, not on the full subtotal.
  directChargePct     Decimal       @default(90) @db.Decimal(5, 2)
  indirectChargePct   Decimal       @default(10) @db.Decimal(5, 2)
  totalDirectCharge   Decimal       @default(0) @db.Decimal(16, 2)
  totalIndirectCharge Decimal       @default(0) @db.Decimal(16, 2)
  vatPct              Decimal       @default(0) @db.Decimal(5, 2)
  vatAmount           Decimal       @default(0) @db.Decimal(16, 2)
  /// Informational only — the client is expected to withhold this on payment and remit it to the
  /// tax authority on the vendor's behalf. Does not change totalAmount; the actual amount the client
  /// withholds is recorded as a ClientInvoiceDeduction (type WITHHOLDING_TAX) against the WHT credit
  /// note when they pay, so it stays justified and evidenced like any other deduction.
  whtPct              Decimal       @default(0) @db.Decimal(5, 2)
  whtAmount           Decimal       @default(0) @db.Decimal(16, 2)
  totalAmount         Decimal       @db.Decimal(16, 2)
  amountPaid          Decimal       @default(0) @db.Decimal(16, 2)
  /// Sum of ClientInvoiceDeduction — WHT actually withheld, or any other justified/evidenced
  /// deduction (e.g. leave allowance credit) a client applies instead of paying in full.
  totalDeductions     Decimal       @default(0) @db.Decimal(16, 2)
  status              InvoiceStatus @default(ISSUED)
  notes               String?
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lines           ClientInvoiceLine[]
  receipts        ClientReceipt[]
  deductions      ClientInvoiceDeduction[]
  /// The billing rule, tax codes and rates each contract on this invoice was calculated with, and where each came from.
  taxBasis        Json?
  taxTransactions TaxTransaction[]

  @@unique([organizationId, invoiceNumber])
  @@unique([clientId, runId])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

/// One line per category (Guard, Supervisor, …) billed on the invoice — quantity × rate = amount.
/// Prefixed with the contract name when a client has more than one contract on the same invoice.
model ClientInvoiceLine {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id])
  /// The billing rule this line's split and taxes were calculated under (null: the built-in default).
  billingRuleId  String?
  billingRule    BillingRule?  @relation(fields: [billingRuleId], references: [id], onDelete: Restrict)
  categoryName   String?
  description    String
  headcount      Int
  rate           Decimal       @default(0) @db.Decimal(14, 2)
  /// Legacy: paid-day count for a beat-based line generated before category-based invoicing. Unused
  /// (and not populated) for lines generated after; kept nullable for older invoices.
  days           Decimal?      @db.Decimal(6, 2)
  beatId         String?
  beat           Beat?         @relation(fields: [beatId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  /// amount split direct/indirect at the invoice's directChargePct/indirectChargePct — direct +
  /// indirect always sums to amount. VAT is charged on the sum of indirectCharge across all lines.
  directCharge   Decimal       @default(0) @db.Decimal(14, 2)
  indirectCharge Decimal       @default(0) @db.Decimal(14, 2)
  sortOrder      Int           @default(0)
}

enum InvoiceDeductionType {
  WITHHOLDING_TAX
  LEAVE_ALLOWANCE
  OTHER
}

/// A justified, evidenced deduction a client applies instead of paying an invoice in full —
/// withholding tax, a leave-allowance credit, or any other agreed deduction. Never deleted.
model ClientInvoiceDeduction {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  invoiceId          String
  invoice            ClientInvoice        @relation(fields: [invoiceId], references: [id])
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id])
  type               InvoiceDeductionType
  amount             Decimal              @db.Decimal(16, 2)
  reason             String // justification — required
  supportingDocument String // proof (reference / filename / description) — required
  recordedBy         String
  createdAt          DateTime             @default(now())

  @@index([organizationId, invoiceId])
  @@index([organizationId, clientId])
}

/// A payment received from a client against an invoice. Never deleted — cancel/reverse with a
/// documented reason instead if one is recorded in error.
model ClientReceipt {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        ClientInvoice @relation(fields: [invoiceId], references: [id])
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  amount         Decimal       @db.Decimal(16, 2)
  receivedDate   DateTime      @db.Date
  method         String?
  reference      String?
  recordedBy     String
  createdAt      DateTime      @default(now())

  matchedByLines BankStatementLine[]

  @@index([organizationId, invoiceId])
  @@index([organizationId, clientId])
}

// ───────────────────────── ACCOUNTS PAYABLE ─────────────────────────
// Mirrors the client billing (accounts-receivable) models above, but for money going OUT —
// uniform/kit suppliers, equipment vendors, utilities, professional services, etc.

model Vendor {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  category       VendorCategory @default(OTHER)
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  bankName       String?
  accountNumber  String?
  accountName    String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoices   PurchaseInvoice[]
  payments   VendorPayment[]
  deductions PurchaseInvoiceDeduction[]
  orders     PurchaseOrder[]

  @@unique([organizationId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

/// A purchase order raised before a vendor bill exists — request, approve, then convert to a
/// PurchaseInvoice once the bill actually arrives. Lines are fixed once submitted for approval;
/// corrections mean cancelling and raising a new order.
model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  orderNumber    String
  vendorId       String
  vendor         Vendor              @relation(fields: [vendorId], references: [id])
  costCenterId   String?
  costCenter     CostCenter?         @relation(fields: [costCenterId], references: [id])
  description    String
  subtotal       Decimal             @db.Decimal(16, 2)
  vatPct         Decimal             @default(0) @db.Decimal(5, 2)
  vatAmount      Decimal             @default(0) @db.Decimal(16, 2)
  totalAmount    Decimal             @db.Decimal(16, 2)
  status         PurchaseOrderStatus @default(DRAFT)
  requestedBy    String
  requestedAt    DateTime            @default(now())
  decidedBy      String?
  decidedAt      DateTime?
  decisionReason String?
  notes          String?
  updatedAt      DateTime            @updatedAt

  lines            PurchaseOrderLine[]
  convertedInvoice PurchaseInvoice?

  @@unique([organizationId, orderNumber])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  rate        Decimal       @db.Decimal(14, 2)
  amount      Decimal       @db.Decimal(14, 2)
  sortOrder   Int           @default(0)
}

/// A vendor bill. Never edited once recorded — corrections go through a deduction or a new invoice.
model PurchaseInvoice {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  vendorId        String
  vendor          Vendor                @relation(fields: [vendorId], references: [id])
  invoiceNumber   String // our internal sequence number
  vendorRef       String? // the vendor's own invoice/bill number
  costCenterId    String?
  costCenter      CostCenter?           @relation(fields: [costCenterId], references: [id])
  purchaseOrderId String?               @unique
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate     DateTime              @db.Date
  dueDate         DateTime              @db.Date
  description     String
  subtotal        Decimal               @db.Decimal(16, 2)
  vatPct          Decimal               @default(0) @db.Decimal(5, 2)
  vatAmount       Decimal               @default(0) @db.Decimal(16, 2)
  totalAmount     Decimal               @db.Decimal(16, 2)
  amountPaid      Decimal               @default(0) @db.Decimal(16, 2)
  /// Sum of PurchaseInvoiceDeduction — WHT we withheld from the vendor, or any other justified,
  /// evidenced deduction (short-payment, damaged-goods credit, etc.).
  totalDeductions Decimal               @default(0) @db.Decimal(16, 2)
  status          PurchaseInvoiceStatus @default(RECORDED)
  notes           String?
  createdBy       String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  lines      PurchaseInvoiceLine[]
  payments   VendorPayment[]
  deductions PurchaseInvoiceDeduction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
}

model PurchaseInvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal         @default(1) @db.Decimal(10, 2)
  rate        Decimal         @db.Decimal(14, 2)
  amount      Decimal         @db.Decimal(14, 2)
  sortOrder   Int             @default(0)
}

/// A justified, evidenced deduction WE apply instead of paying a vendor bill in full — withholding
/// tax we're required to remit on the vendor's behalf, or any other agreed short-payment. Never
/// deleted.
model PurchaseInvoiceDeduction {
  id                 String                       @id @default(cuid())
  organizationId     String
  organization       Organization                 @relation(fields: [organizationId], references: [id])
  invoiceId          String
  invoice            PurchaseInvoice              @relation(fields: [invoiceId], references: [id])
  vendorId           String
  vendor             Vendor                       @relation(fields: [vendorId], references: [id])
  type               PurchaseInvoiceDeductionType
  amount             Decimal                      @db.Decimal(16, 2)
  reason             String
  supportingDocument String
  recordedBy         String
  createdAt          DateTime                     @default(now())

  @@index([organizationId, invoiceId])
  @@index([organizationId, vendorId])
}

/// A payment made to a vendor against a bill. Never deleted — cancel/reverse with a documented
/// reason instead if one is recorded in error.
model VendorPayment {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  amount         Decimal         @db.Decimal(16, 2)
  paidDate       DateTime        @db.Date
  method         String?
  reference      String?
  recordedBy     String
  createdAt      DateTime        @default(now())

  matchedByLines BankStatementLine[]

  @@index([organizationId, invoiceId])
  @@index([organizationId, vendorId])
}

// ─────────────────────────────── FIXED ASSET REGISTER ───────────────────────────────

enum FixedAssetCategory {
  VEHICLE
  RADIO_COMMS
  CCTV_SECURITY
  FIREARM
  OFFICE_EQUIPMENT
  IT_EQUIPMENT
  FURNITURE
  OTHER
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// Company-owned capital assets — vehicles, radios, CCTV, firearms, office/IT equipment. Straight-line
/// depreciation is computed on the fly (see fixed-assets.ts), never stored, so there's nothing to
/// re-run when a rate or date changes. Auto-numbered `FA-######`, never deleted — dispose it instead.
model FixedAsset {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  assetNumber          String
  name                 String
  category             FixedAssetCategory
  costCenterId         String?
  costCenter           CostCenter?        @relation(fields: [costCenterId], references: [id])
  serialNumber         String?
  locationDescription  String?
  assignedToEmployeeId String?
  assignedToEmployee   Employee?          @relation(fields: [assignedToEmployeeId], references: [id])
  acquisitionDate      DateTime           @db.Date
  cost                 Decimal            @db.Decimal(16, 2)
  usefulLifeMonths     Int
  salvageValue         Decimal            @default(0) @db.Decimal(16, 2)
  status               FixedAssetStatus   @default(ACTIVE)
  disposalDate         DateTime?          @db.Date
  disposalProceeds     Decimal?           @db.Decimal(16, 2)
  disposalReason       String?
  notes                String?
  createdBy            String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  journalLines         JournalLine[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

// ───────────────────────── BANK RECONCILIATION (OPERATING ACCOUNT) ─────────────────────────
// Reconciles the organization's own bank account(s) against everything that moves through them —
// client receipts in, vendor payments out. Distinct from PaymentTransaction.reconciled above, which
// only matches payroll disbursements. Scoped to a single primary operating account for now: receipts
// and payments carry no bankAccountId, so a statement line can be matched to any org-wide, unmatched
// receipt/payment (a record can only ever be claimed by one line).

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  bankName       String
  accountNumber  String
  glAccountId    String?
  glAccount      GlAccount?   @relation(fields: [glAccountId], references: [id])
  openingBalance Decimal      @default(0) @db.Decimal(16, 2)
  openingDate    DateTime     @db.Date
  active         Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())

  statementLines BankStatementLine[]

  @@unique([organizationId, name])
}

enum BankLineMatchType {
  CLIENT_RECEIPT
  VENDOR_PAYMENT
  MANUAL
}

/// One imported bank statement line. Positive amount = money in, negative = money out. Matched
/// against an existing ClientReceipt/VendorPayment, or marked MANUAL (bank charges, interest,
/// inter-account transfers) with a required note — never silently ignored.
model BankStatementLine {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id])
  bankAccountId          String
  bankAccount            BankAccount        @relation(fields: [bankAccountId], references: [id])
  date                   DateTime           @db.Date
  description            String
  amount                 Decimal            @db.Decimal(16, 2)
  reference              String?
  matchType              BankLineMatchType?
  matchedClientReceiptId String?
  matchedClientReceipt   ClientReceipt?     @relation(fields: [matchedClientReceiptId], references: [id])
  matchedVendorPaymentId String?
  matchedVendorPayment   VendorPayment?     @relation(fields: [matchedVendorPaymentId], references: [id])
  matchNote              String?
  matchedBy              String?
  matchedAt              DateTime?
  createdAt              DateTime           @default(now())

  @@index([organizationId, bankAccountId])
  @@index([organizationId, matchType])
}

// ─────────────────────────────── AUDIT ───────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  userName       String
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}

// ─────────────────────────────── LEAVE ───────────────────────────────

/// One policy per organization. Defaults: 10 working days a year, due after 12 months' service.
model LeavePolicy {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  annualDays         Int          @default(10)
  eligibilityMonths  Int          @default(12) // months of service before the first entitlement is due
  workingDaysPerWeek Int          @default(5) // 5 = Mon–Fri, 6 = Mon–Sat, 7 = every day
  updatedAt          DateTime     @updatedAt
}

model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  cycleStart     DateTime     @db.Date // the leave year the days are charged to
  cycleEnd       DateTime     @db.Date
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  workingDays    Int
  reason         String?
  status         LeaveStatus  @default(PENDING)
  requestedBy    String
  decidedBy      String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

// ─────────────────────────── GENERAL LEDGER ───────────────────────────

model GlAccount {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  type           GlAccountType
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  /// Where the account sits in the hierarchy: class → group → category → account. Null until classified.
  categoryId     String?
  category       AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// A sub-account hangs under a parent account; the parent then becomes a non-posting header.
  parentId       String?
  parent         GlAccount?       @relation("SubAccounts", fields: [parentId], references: [id], onDelete: Restrict)
  children       GlAccount[]      @relation("SubAccounts")
  /// Header accounts group others and can't be posted to.
  postable       Boolean          @default(true)
  description    String?
  /// The account can only be posted to on or after / on or before these dates.
  effectiveFrom  DateTime?        @db.Date
  effectiveTo    DateTime?        @db.Date
  /// Which financial-statement line this account reports under, overriding its category's line.
  statementLine  String?
  /// Which tax return or tax ledger this account feeds (VAT_OUTPUT, WHT_RECEIVABLE, PAYE …).
  taxMapping     String?

  debitMappings      PayrollGlMapping[]     @relation("MappingDebit")
  creditMappings     PayrollGlMapping[]     @relation("MappingCredit")
  lines              JournalLine[]
  bankAccounts       BankAccount[]
  /// Dimensions every posting to this account must carry (CLIENT, CONTRACT, COST_CENTER …). Empty = none required.
  requiredDimensions String[]               @default([])
  documentLines      JournalDocumentLine[]
  recurringLines     RecurringJournalLine[]

  @@unique([organizationId, code])
}

/// Which GL accounts a payroll head (salary component, deduction, employer cost) posts to.
model PayrollGlMapping {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  headCode        String
  headName        String
  headType        GlHeadType
  debitAccountId  String?
  debitAccount    GlAccount?   @relation("MappingDebit", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount   GlAccount?   @relation("MappingCredit", fields: [creditAccountId], references: [id])

  @@unique([organizationId, headCode])
}

/// One balanced journal per payroll run, posted automatically when the run is locked.
/// One balanced journal entry. `runId` is set only for payroll-sourced entries (PAYROLL_LOCK /
/// PAYROLL_CLOSE / MANUAL_POST) — everything else (AR/AP/depreciation postings) leaves it null.
/// Postgres treats each NULL as distinct, so the unique constraint still guarantees at most one
/// journal per payroll run without blocking any number of non-payroll entries.
model JournalEntry {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  entryNumber    String
  runId          String?           @unique
  run            PayrollRun?       @relation(fields: [runId], references: [id])
  /// The accounting period the posting date falls in. Set when posted; older journals are stamped once by a backfill.
  periodId       String?
  period         AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  /// The document that produced this journal (CLIENT_INVOICE, CLIENT_RECEIPT, PAYROLL_RUN …) and its id, so a ledger line can be traced back and a document with no journal can be named.
  sourceType     String?
  sourceId       String?
  periodName     String?
  postingDate    DateTime          @db.Date
  description    String
  source         String // PAYROLL_LOCK | PAYROLL_CLOSE | MANUAL_POST | AR_INVOICE | AR_RECEIPT | AR_DEDUCTION | AP_INVOICE | AP_PAYMENT | AP_DEDUCTION | DEPRECIATION
  totalDebit     Decimal           @db.Decimal(16, 2)
  totalCredit    Decimal           @db.Decimal(16, 2)
  postedBy       String
  postedAt       DateTime          @default(now())
  remarks        String?

  lines            JournalLine[]
  /// Set when this journal reverses another: the original, which stays untouched. At most one reversal per journal.
  reversalOfId     String?           @unique
  reversalOf       JournalEntry?     @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy       JournalEntry?     @relation("JournalReversal")
  document         JournalDocument?
  reversalRequests JournalReversal[]

  @@unique([organizationId, entryNumber])
  @@index([organizationId, postingDate])
  @@index([organizationId, source])
  @@index([organizationId, sourceType, sourceId])
  @@index([periodId])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalId      String
  journal        JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId      String
  account        GlAccount     @relation(fields: [accountId], references: [id])
  accountCode    String
  accountName    String
  headCode       String
  description    String
  debit          Decimal       @default(0) @db.Decimal(16, 2)
  credit         Decimal       @default(0) @db.Decimal(16, 2)
  sortOrder      Int           @default(0)
  /// Accounting dimensions: who and what the posting is for. Set when the line is posted and never changed.
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  beatId         String?
  beat           Beat?         @relation(fields: [beatId], references: [id], onDelete: Restrict)
  costCenterId   String?
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fixedAssetId   String?
  fixedAsset     FixedAsset?   @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  profitCentreId String?
  profitCentre   ProfitCentre? @relation(fields: [profitCentreId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([contractId])
  @@index([beatId])
  @@index([costCenterId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([fixedAssetId])
  @@index([regionId])
  @@index([branchId])
  @@index([profitCentreId])
  @@index([projectId])
  @@index([journalId])
}

// ─────────────────────── INVENTORY: UNIFORM & KIT STOCK ───────────────────────

enum InventoryCategory {
  UNIFORM
  FOOTWEAR
  ACCESSORY
  EQUIPMENT
  OTHER
}

enum StockMovementType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
  WRITE_OFF
}

/// What state kit comes back in. Only GOOD kit goes back on the shelf.
enum ReturnCondition {
  GOOD
  DAMAGED
  LOST
}

/// A stocked item — one row per size, so "Shirt — L" and "Shirt — XL" count separately.
/// quantityOnHand and averageCost are kept in step with the movement ledger, which is the record
/// of truth: every change to either is a StockMovement.
model InventoryItem {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  category       InventoryCategory @default(UNIFORM)
  size           String?
  unit           String            @default("pcs")
  reorderLevel   Int               @default(0)
  quantityOnHand Int               @default(0)
  /// Weighted-average cost per unit, recalculated on every receipt.
  averageCost    Decimal           @default(0) @db.Decimal(14, 2)
  active         Boolean           @default(true)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  movements StockMovement[]
  packLines KitPackLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  itemId         String
  item           InventoryItem     @relation(fields: [itemId], references: [id])
  type           StockMovementType
  /// Units in the transaction — always positive.
  quantity       Int
  /// Effect on quantityOnHand (signed). Damaged / lost returns leave stock unchanged.
  stockDelta     Int
  unitCost       Decimal           @db.Decimal(14, 2)
  condition      ReturnCondition?
  employeeId     String?
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  /// Delivery note, invoice, stocktake or requisition reference.
  reference      String?
  reason         String?
  balanceAfter   Int
  movementDate   DateTime          @db.Date
  createdBy      String
  createdAt      DateTime          @default(now())

  @@index([organizationId, itemId])
  @@index([organizationId, employeeId])
}

/// A standard issue — e.g. "Guard starter kit" — so onboarding is one click instead of ten.
model KitPack {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  /// Suggested for one employee category (informational — any pack can be issued to anyone).
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines KitPackLine[]

  @@unique([organizationId, name])
}

model KitPackLine {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  packId         String
  pack           KitPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  quantity       Int

  @@unique([packId, itemId])
}

// ─────────────────────── STAFF LOANS & SALARY ADVANCES ───────────────────────

enum LoanType {
  LOAN
  SALARY_ADVANCE
}

enum LoanStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CANCELLED
  WRITTEN_OFF
}

/// How an instalment is settled: by a payroll deduction, by a deduction on the end-of-service
/// settlement, or in cash/transfer paid straight to the company.
enum LoanInstallmentKind {
  PAYROLL
  SETTLEMENT
  CASH
}

/// Money lent to an employee, interest-free, repaid from payroll. The balance is never stored: it is
/// worked out from the instalments (a payroll deduction counts as paid once its payroll is locked).
model StaffLoan {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  loanNumber          String
  employeeId          String
  employee            Employee     @relation(fields: [employeeId], references: [id])
  type                LoanType     @default(LOAN)
  principal           Decimal      @db.Decimal(14, 2)
  installmentCount    Int          @default(1)
  installmentAmount   Decimal      @db.Decimal(14, 2)
  /// The first payroll month a repayment is taken in.
  firstDeductionYear  Int
  firstDeductionMonth Int
  reason              String
  status              LoanStatus   @default(PENDING_APPROVAL)
  requestedBy         String
  requestedById       String
  approvedBy          String?
  approvedAt          DateTime?
  decisionNote        String?
  disbursedOn         DateTime?    @db.Date
  writtenOffAmount    Decimal?     @db.Decimal(14, 2)
  writtenOffReason    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  installments LoanInstallment[]

  @@unique([organizationId, loanNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model LoanInstallment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  loanId         String
  loan           StaffLoan           @relation(fields: [loanId], references: [id])
  kind           LoanInstallmentKind
  amount         Decimal             @db.Decimal(14, 2)
  /// The payroll Deduction this instalment became (PAYROLL / SETTLEMENT kinds).
  deductionId    String?             @unique
  periodId       String?
  paidOn         DateTime?           @db.Date
  reference      String?
  createdBy      String
  createdAt      DateTime            @default(now())

  @@index([organizationId, loanId])
}

// ───────────────────────────── LETTERS ─────────────────────────────

enum LetterType {
  OFFER
  EMPLOYMENT_CONFIRMATION
  PROBATION_CONFIRMATION
  WARNING
  EXIT_LETTER
  EXPERIENCE
  CLEARANCE_CERTIFICATE
}

/// The wording of one kind of letter, per organization. The body is plain text with {{field}} merge
/// placeholders; saving rejects any placeholder the letter type doesn't offer.
model LetterTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           LetterType
  subject        String
  body           String
  signatoryName  String       @default("")
  signatoryTitle String       @default("Human Resources")
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type])
}

/// A letter as it was issued — the merged text is stored, so changing the template later never
/// rewrites a letter already given to someone.
model GeneratedLetter {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  referenceNumber String
  type            LetterType
  /// Who it is about (the employee, or the candidate for an offer).
  recipientName   String
  employeeId      String?
  employee        Employee?    @relation(fields: [employeeId], references: [id])
  candidateId     String?
  /// The record it was generated from (offer, exit, disciplinary record…), for traceability.
  sourceId        String?
  subject         String
  body            String
  signatoryName   String       @default("")
  signatoryTitle  String       @default("")
  generatedBy     String
  createdAt       DateTime     @default(now())

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, type])
}

// ─────────────────────────── PERSONAL RECORDS: CONTACTS & GUARANTORS ───────────────────────────

enum ContactKind {
  NEXT_OF_KIN
  EMERGENCY_CONTACT
  DEPENDANT
  REFEREE
}

enum GuarantorStatus {
  PENDING
  VERIFIED
  REJECTED
  RELEASED
}

/// A person connected to an employee: next of kin, emergency contact, dependant or referee. Employees
/// can maintain their own (self-service); HR can maintain anyone's.
model EmployeeContact {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind            ContactKind
  fullName        String
  relationship    String
  phone           String?
  altPhone        String?
  email           String?
  address         String?
  dateOfBirth     DateTime?    @db.Date
  occupation      String?
  /// The main next of kin / emergency contact (one per employee per kind).
  isPrimary       Boolean      @default(false)
  /// Receives death-in-service / group-life / final-pay benefits.
  isBeneficiary   Boolean      @default(false)
  /// Percentage of the benefit; an employee's shares total 100 when complete.
  benefitSharePct Int?
  notes           String?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, employeeId, kind])
}

/// A guarantor vouching for an employee (common for security and cash-handling staff). Recorded as
/// PENDING, then verified (identity checked, signed form on file) or rejected; released when no longer needed.
model EmployeeGuarantor {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName         String
  relationship     String
  phone            String
  altPhone         String?
  email            String?
  address          String
  occupation       String?
  employer         String?
  employerAddress  String?
  idType           String?
  idNumber         String?
  yearsKnown       Int?
  /// The most the guarantor accepts liability for, if the agreement caps it.
  guaranteeAmount  Decimal?        @db.Decimal(14, 2)
  /// Reference to the signed guarantee form (filename / file number) — matching EmployeeDocument.
  formReference    String?
  status           GuarantorStatus @default(PENDING)
  recordedBy       String
  recordedByUserId String
  verifiedBy       String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  verificationNote String?
  releasedAt       DateTime?
  releaseReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── TRAINING COMPLIANCE ───────────────────────────

/// A course or certification employees must hold — for everyone, or for one category. Matched by name
/// (case-insensitively) against the certificates recorded on each employee (EmployeeTraining).
model TrainingRequirement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  courseName     String
  description    String?
  /// Null = every employee; otherwise only this category.
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  /// A new joiner has this many days from their employment date before a missing certificate counts.
  graceDays      Int               @default(30)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())

  @@index([organizationId, active])
}

// ─────────────────────────── PERFORMANCE APPRAISALS ───────────────────────────

enum AppraisalKind {
  ANNUAL
  PROBATION
  AD_HOC
}

enum AppraisalCycleStatus {
  OPEN
  CLOSED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACKNOWLEDGED
}

enum AppraisalRecommendation {
  NONE
  CONFIRM_EMPLOYMENT
  INCREMENT
  PROMOTION
  TRAINING
  PERFORMANCE_PLAN
}

/// One thing employees are rated on, with its weight. Edited in Settings; a cycle snapshots the active
/// criteria when it is launched, so later edits never change an appraisal already under way.
model AppraisalCriterion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  weight         Int          @default(10)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  ratings AppraisalRating[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model AppraisalCycle {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  kind           AppraisalKind        @default(ANNUAL)
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  /// Reviews should be submitted by this date.
  dueDate        DateTime             @db.Date
  status         AppraisalCycleStatus @default(OPEN)
  createdBy      String
  closedAt       DateTime?
  createdAt      DateTime             @default(now())

  appraisals Appraisal[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

/// One employee's review in a cycle: self-assessment, then the reviewer's ratings, then sign-off by
/// someone other than the reviewer, then the employee acknowledges (or disputes) the result.
model Appraisal {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id])
  cycleId             String
  cycle               AppraisalCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee                @relation(fields: [employeeId], references: [id])
  reviewerUserId      String?
  reviewerName        String?
  status              AppraisalStatus         @default(DRAFT)
  selfSubmittedAt     DateTime?
  employeeSelfComment String?
  /// Weighted average of the reviewer's ratings (1–5), fixed when the review is submitted.
  overallScore        Decimal?                @db.Decimal(4, 2)
  overallBand         String?
  strengths           String?
  improvements        String?
  goals               String?
  reviewerComment     String?
  recommendation      AppraisalRecommendation @default(NONE)
  submittedAt         DateTime?
  returnNote          String?
  approvedBy          String?
  approvedByUserId    String?
  approvedAt          DateTime?
  approvalNote        String?
  acknowledgedAt      DateTime?
  employeeAgreed      Boolean?
  employeeResponse    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  ratings AppraisalRating[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@index([reviewerUserId])
}

model AppraisalRating {
  id             String             @id @default(cuid())
  organizationId String
  appraisalId    String
  appraisal      Appraisal          @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  criterionId    String
  criterion      AppraisalCriterion @relation(fields: [criterionId], references: [id])
  /// Snapshots, so renaming or re-weighting a criterion doesn't rewrite a review in progress.
  criterionName  String
  weight         Int
  sortOrder      Int                @default(0)
  selfRating     Int?
  selfComment    String?
  rating         Int?
  comment        String?

  @@unique([appraisalId, criterionId])
}

// ─────────────────────────── CHANGE CONTROL FOR SENSITIVE DETAILS ───────────────────────────

enum ChangeKind {
  BANK
  TAX
  PENSION
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A requested change to an employee's bank, tax or pension details. It takes effect only when someone
/// other than the requester approves it; the details at request time are kept beside what was asked for.
model EmployeeChangeRequest {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind              ChangeKind
  /// The new values, e.g. { bankName, accountNumber, accountName }.
  proposed          Json
  /// What the employee had when the request was made.
  previous          Json
  reason            String
  status            ChangeStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime     @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  /// When an approved change was written to the employee record.
  appliedAt         DateTime?

  @@index([organizationId, status])
  @@index([organizationId, employeeId, kind])
}

// ─────────────────────────── COMPANY POLICIES & ACKNOWLEDGEMENTS ───────────────────────────

enum PolicyStatus {
  ACTIVE
  ARCHIVED
}

enum AckMethod {
  SELF
  RECORDED
}

/// A company policy (code of conduct, data protection, safety…) that employees must read and acknowledge —
/// everyone, or one category. The wording lives in its versions, which are never edited once published.
model CompanyPolicy {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  title          String
  summary        String?
  /// Null = every employee; otherwise only this category.
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  /// Days an employee has to acknowledge, from the version taking effect or from joining (whichever is later).
  graceDays      Int               @default(14)
  status         PolicyStatus      @default(ACTIVE)
  createdBy      String
  createdAt      DateTime          @default(now())

  versions PolicyVersion[]

  @@unique([organizationId, title])
  @@index([organizationId, status])
}

/// One published wording of a policy. A new version means everyone has to acknowledge again.
model PolicyVersion {
  id                String        @id @default(cuid())
  organizationId    String
  policyId          String
  policy            CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version           Int
  /// From this date the version is the current one; a future date schedules it.
  effectiveDate     DateTime      @db.Date
  /// The text employees read. A document reference may be given instead, or as well.
  body              String?
  /// Reference to the signed-off document (file name / number) — this app has no object storage.
  documentReference String?
  changeSummary     String?
  publishedBy       String
  publishedAt       DateTime      @default(now())

  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, version])
}

model PolicyAcknowledgement {
  id             String        @id @default(cuid())
  organizationId String
  versionId      String
  version        PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime      @default(now())
  method         AckMethod     @default(SELF)
  /// For a paper sign-off recorded by HR: who recorded it.
  recordedBy     String?
  note           String?

  @@unique([versionId, employeeId])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── DATA SUBJECT ACCESS REQUESTS ───────────────────────────

enum DataRequestStatus {
  OPEN
  FULFILLED
  REFUSED
}

/// A request from an employee (or former employee) for a copy of the personal data held on them, with the
/// deadline to answer it. The export itself is generated on demand and never stored; the register keeps
/// who asked, when, how identity was checked, who answered, and a checksum and section counts of what was
/// handed over.
model DataAccessRequest {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  requestNumber    String
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  /// Who made the request — the employee, or someone acting for them.
  requesterName    String
  /// How it arrived: email, letter, in person…
  channel          String?
  receivedOn       DateTime          @db.Date
  dueOn            DateTime          @db.Date
  status           DataRequestStatus @default(OPEN)
  identityVerified Boolean           @default(false)
  identityNote     String?
  verifiedBy       String?
  exportedAt       DateTime?
  /// SHA-256 of the file generated, and how many records each section held.
  exportChecksum   String?
  exportSections   Json?
  handledBy        String?
  completedOn      DateTime?
  completionNote   String?
  refusalReason    String?
  createdBy        String
  createdAt        DateTime          @default(now())

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
}

enum BreachStatus {
  OPEN
  CLOSED
}

/// What the controller concluded about the harm a breach could do to the people affected. Until someone has
/// assessed it the notification clock is treated as running.
enum BreachAssessment {
  UNASSESSED
  NO_RISK
  RISK
  HIGH_RISK
}

/// A personal-data breach: what happened, when it was discovered, the assessment of risk, whether and when the
/// regulator and the people affected were told, and how it was contained and closed. The regulator must be told
/// within a set number of hours of the company becoming aware (HR policy: breachNotifyHours) when the breach is
/// likely to put people at risk.
model DataBreach {
  id                    String             @id @default(cuid())
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id])
  incidentNumber        String
  title                 String
  description           String
  /// When the company became aware — the notification deadline counts from here.
  discoveredAt          DateTime
  occurredOn            DateTime?          @db.Date
  /// Kinds of data involved (identity, bank details, ...).
  dataCategories        String[]           @default([])
  individualsAffected   Int?
  status                BreachStatus       @default(OPEN)
  assessment            BreachAssessment   @default(UNASSESSED)
  assessmentNote        String?
  assessedBy            String?
  assessedAt            DateTime?
  containedAt           DateTime?
  containmentNote       String?
  rootCause             String?
  remediation           String?
  ndpcNotifiedAt        DateTime?
  ndpcReference         String?
  /// Why the regulator was told after the deadline.
  lateReason            String?
  individualsNotifiedAt DateTime?
  individualsNote       String?
  closedAt              DateTime?
  closedBy              String?
  reportedBy            String
  createdAt             DateTime           @default(now())
  updates               DataBreachUpdate[]

  @@unique([organizationId, incidentNumber])
  @@index([organizationId, status])
}

/// Append-only timeline of a breach: every decision and every note, with who and when.
model DataBreachUpdate {
  id             String     @id @default(cuid())
  organizationId String
  breachId       String
  breach         DataBreach @relation(fields: [breachId], references: [id], onDelete: Cascade)
  note           String
  author         String
  createdAt      DateTime   @default(now())

  @@index([breachId])
}

enum ErasureKind {
  /// The retention period has run out.
  RETENTION
  /// The person asked for their data to be erased.
  REQUEST
}

enum ErasureStatus {
  PENDING
  EXECUTED
  REJECTED
}

/// A request to remove a former employee's personal details once the retention period has passed. One person asks,
/// a different person approves; approving carries it out. What was removed is recorded as counts, never as the data.
model EmployeeErasure {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id])
  kind              ErasureKind
  reason            String
  status            ErasureStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  decidedBy         String?
  decidedByUserId   String?
  decisionNote      String?
  decidedAt         DateTime?
  /// How many records of each kind were changed or removed.
  summary           Json?
  createdAt         DateTime      @default(now())

  @@index([organizationId, status])
  @@index([employeeId])
}

enum AccountingPeriodStatus {
  /// Anyone allowed to post can post.
  OPEN
  /// Only finance staff with the close permission can still post (adjustments while the books are being finished).
  SOFT_CLOSED
  /// Nothing can be posted. Reopening needs a reason and the reopen permission.
  CLOSED
  /// Final. Nothing can be posted and it cannot be reopened.
  LOCKED
}

/// A financial year: twelve monthly accounting periods starting in the organization's first fiscal month.
model FiscalYear {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  name           String
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  createdAt      DateTime           @default(now())
  periods        AccountingPeriod[]

  @@unique([organizationId, startDate])
}

/// One month of a financial year. Every journal belongs to one; its status decides whether it can be posted to.
model AccountingPeriod {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  fiscalYearId   String
  fiscalYear     FiscalYear              @relation(fields: [fiscalYearId], references: [id])
  number         Int
  name           String
  startDate      DateTime                @db.Date
  endDate        DateTime                @db.Date
  status         AccountingPeriodStatus  @default(OPEN)
  createdAt      DateTime                @default(now())
  journals       JournalEntry[]
  events         AccountingPeriodEvent[]

  @@unique([organizationId, startDate])
  @@index([organizationId, status])
  @@index([fiscalYearId])
}

/// Append-only trail of everything done to a period: who closed, approved, locked or reopened it, and why.
model AccountingPeriodEvent {
  id             String                 @id @default(cuid())
  organizationId String
  periodId       String
  period         AccountingPeriod       @relation(fields: [periodId], references: [id])
  action         String
  fromStatus     AccountingPeriodStatus
  toStatus       AccountingPeriodStatus
  actor          String
  actorUserId    String
  reason         String?
  createdAt      DateTime               @default(now())

  @@index([periodId])
}

/// A group of accounts within one of the seven account classes (1 Assets … 7 Finance and other).
model AccountGroup {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  /// 1 Assets, 2 Liabilities, 3 Equity, 4 Revenue, 5 Cost of services, 6 Operating expenses, 7 Finance and other.
  classNumber    Int
  code           String
  name           String
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  categories     AccountCategory[]

  @@unique([organizationId, code])
  @@index([organizationId, classNumber])
}

/// A category within a group. Carries the financial-statement line its accounts report under.
model AccountCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  groupId        String
  group          AccountGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  code           String
  name           String
  /// The statement line accounts in this category report under (e.g. TRADE_RECEIVABLES), unless an account overrides it.
  statementLine  String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  accounts       GlAccount[]

  @@unique([organizationId, code])
  @@index([groupId])
}

/// A region of the business (a state, a zone, a territory). A region can sit inside a larger one, so a zone is a region of regions.
model Region {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  parentId       String?
  parent         Region?       @relation("RegionZone", fields: [parentId], references: [id], onDelete: Restrict)
  children       Region[]      @relation("RegionZone")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  branches       Branch[]
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A branch or office, optionally within a region.
model Branch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A part of the business whose profit is judged separately (a division, a service line).
model ProfitCentre {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A project or job that income and cost can be charged to, optionally for one client or contract.
model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  clientId       String?
  contractId     String?
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

enum JournalDocumentKind {
  MANUAL
  ADJUSTMENT
  /// Posts now and reverses itself on a set date.
  ACCRUAL
  /// Moves a balance from one account or dimension to another.
  RECLASSIFICATION
}

enum JournalDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

/// A manual journal as a document: drafted, submitted, approved by someone else, then posted through the posting
/// engine. Only a posted document has a journal; until then nothing touches the ledger. Once submitted its lines can no
/// longer be changed (the database enforces it) until it is rejected back to draft.
model JournalDocument {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id])
  documentNumber     String
  kind               JournalDocumentKind   @default(MANUAL)
  description        String
  postingDate        DateTime              @db.Date
  /// For an accrual: the date its automatic reversal is posted.
  reverseOn          DateTime?             @db.Date
  status             JournalDocumentStatus @default(DRAFT)
  createdBy          String
  createdByUserId    String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  submittedBy        String?
  submittedByUserId  String?
  submittedAt        DateTime?
  decidedBy          String?
  decidedByUserId    String?
  decidedAt          DateTime?
  decisionNote       String?
  postedBy           String?
  postedAt           DateTime?
  journalId          String?               @unique
  journal            JournalEntry?         @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines              JournalDocumentLine[]
  /// The recurring template that generated this draft, if any. One document per template per posting date.
  recurringJournalId String?
  recurringJournal   RecurringJournal?     @relation(fields: [recurringJournalId], references: [id], onDelete: Restrict)

  @@unique([organizationId, documentNumber])
  @@unique([recurringJournalId, postingDate])
  @@index([organizationId, status])
}

model JournalDocumentLine {
  id          String          @id @default(cuid())
  documentId  String
  document    JournalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accountId   String
  account     GlAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description String
  debit       Decimal         @default(0) @db.Decimal(16, 2)
  credit      Decimal         @default(0) @db.Decimal(16, 2)
  sortOrder   Int             @default(0)
  /// Dimension ids by column name (clientId, contractId, costCenterId …), checked by the posting engine when it posts.
  dimensions  Json?

  @@index([documentId])
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A template that generates a journal draft each period (rent, insurance, amortisation, standing accruals). The draft
/// goes through the ordinary submit / approve / post path; the template itself never touches the ledger.
model RecurringJournal {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  kind             JournalDocumentKind    @default(MANUAL)
  /// May contain {month}, {quarter} and {year}, filled in with the posting date of each generated journal.
  description      String
  frequency        RecurrenceFrequency    @default(MONTHLY)
  /// Post on the last day of the month instead of the first date's day of the month.
  monthEnd         Boolean                @default(false)
  startDate        DateTime               @db.Date
  endDate          DateTime?              @db.Date
  /// The posting date of the next journal to generate; null once the template has run to its end date.
  nextRunDate      DateTime?              @db.Date
  generatedCount   Int                    @default(0)
  /// For an accrual: days after its posting date that it reverses on.
  reverseAfterDays Int?
  /// Submit each generated draft for approval straight away (only when the organization requires approval).
  autoSubmit       Boolean                @default(false)
  active           Boolean                @default(true)
  createdBy        String
  createdByUserId  String
  createdAt        DateTime               @default(now())
  /// Whoever last changed the template: the preparer of every journal it generates after that.
  updatedBy        String
  updatedByUserId  String
  updatedAt        DateTime               @updatedAt
  lastRunAt        DateTime?
  lastRunNote      String?
  lines            RecurringJournalLine[]
  documents        JournalDocument[]

  @@index([organizationId, active, nextRunDate])
}

model RecurringJournalLine {
  id          String           @id @default(cuid())
  templateId  String
  template    RecurringJournal @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accountId   String
  account     GlAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description String
  debit       Decimal          @default(0) @db.Decimal(16, 2)
  credit      Decimal          @default(0) @db.Decimal(16, 2)
  sortOrder   Int              @default(0)
  dimensions  Json?

  @@index([templateId])
}

/// What a tax is charged on, of a charge-out amount that is split into a direct and an indirect charge.
enum BillingBase {
  /// The indirect (management) charge only. The security-and-guarding default for VAT.
  INDIRECT
  /// The direct (pass-through) charge only.
  DIRECT
  /// The whole charge-out amount. The default for expected withholding.
  FULL
  /// Nothing: the tax doesn't apply.
  NONE
}

enum BillingRuleStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A kind of service the organization bills (Security & Guarding, Consulting …). Its billing rule is the default for every
/// contract of the type.
model ServiceType {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  active         Boolean       @default(true)
  createdBy      String
  createdAt      DateTime      @default(now())
  contracts      Contract[]
  rules          BillingRule[]

  @@unique([organizationId, code])
}

/// How a service type, or one contract, is billed from a date: the direct/indirect split and what VAT and withholding are
/// charged on. A rule is proposed by one person and approved by another and is never edited afterwards (a change is a new
/// rule from a later date). A contract's own rule is an override of its service type's. Exactly one of serviceTypeId and
/// contractId is set.
model BillingRule {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  serviceTypeId     String?
  serviceType       ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  contractId        String?
  contract          Contract?           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  directPct         Decimal             @db.Decimal(5, 2)
  indirectPct       Decimal             @db.Decimal(5, 2)
  vatBase           BillingBase         @default(INDIRECT)
  whtBase           BillingBase         @default(FULL)
  /// A particular tax code for this service or contract; blank = the organization's default code for the type.
  vatTaxCodeId      String?
  whtTaxCodeId      String?
  effectiveFrom     DateTime            @db.Date
  effectiveTo       DateTime?           @db.Date
  status            BillingRuleStatus   @default(PENDING)
  reason            String
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime            @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  lines             ClientInvoiceLine[]

  @@index([organizationId, serviceTypeId, status])
  @@index([organizationId, contractId, status])
}

enum TaxType {
  VAT
  WHT
}

enum TaxRateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaxTransactionKind {
  /// VAT charged on a sale: a liability to the tax authority.
  OUTPUT_VAT
  /// Tax the client is expected to withhold on paying an invoice. What they actually withhold is recorded as a deduction.
  EXPECTED_WHT
}

/// A tax the organization charges or is charged (VAT, withholding tax). The rate lives in TaxRate, by date.
model TaxCode {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  type           TaxType
  /// The ledger account the tax is booked to (output VAT payable, WHT receivable).
  accountCode    String?
  /// The code invoices use when nothing more specific applies. At most one per type.
  isDefault      Boolean          @default(false)
  active         Boolean          @default(true)
  notes          String?
  createdBy      String
  createdAt      DateTime         @default(now())
  rates          TaxRate[]
  transactions   TaxTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

/// One rate of a tax code from a date. Rates are only ever added: a change is a new rate from a later date, proposed by
/// one person and approved by another; the database refuses to edit or delete an approved one.
model TaxRate {
  id                String        @id @default(cuid())
  taxCodeId         String
  taxCode           TaxCode       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  ratePct           Decimal       @db.Decimal(6, 3)
  effectiveFrom     DateTime      @db.Date
  /// Set when a later rate is approved: the day before it starts.
  effectiveTo       DateTime?     @db.Date
  status            TaxRateStatus @default(PENDING)
  reason            String
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime      @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@index([taxCodeId, status, effectiveFrom])
}

/// One taxed amount on a posted document: what the VAT and withholding reports read. Written with the invoice, in the
/// same transaction, and only ever marked reversed.
model TaxTransaction {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  /// Null for amounts that pre-date the tax engine.
  taxCodeId      String?
  taxCode        TaxCode?           @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  kind           TaxTransactionKind
  sourceType     String
  invoiceId      String?
  invoice        ClientInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId       String?
  taxDate        DateTime           @db.Date
  taxableAmount  Decimal            @db.Decimal(16, 2)
  ratePct        Decimal            @db.Decimal(6, 3)
  taxAmount      Decimal            @db.Decimal(16, 2)
  reversed       Boolean            @default(false)
  reversedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@index([organizationId, kind, taxDate])
  @@index([invoiceId])
}

enum JournalReversalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to reverse a posted manual journal. Someone else approves; approving posts a mirror journal and links it
/// to the original, which stays in the ledger untouched.
model JournalReversal {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id])
  journalId         String
  journal           JournalEntry          @relation(fields: [journalId], references: [id], onDelete: Restrict)
  reason            String
  /// The date the reversal posts on (must be in a period that accepts postings).
  reverseDate       DateTime              @db.Date
  status            JournalReversalStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime              @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@index([organizationId, status])
  @@index([journalId])
}
