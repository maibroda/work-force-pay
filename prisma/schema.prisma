/// Someone who sends the bureau business (an accountant, an HR consultant), and what they are paid when it comes.
model ReferralPartner {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  kind             PartnerKind  @default(ACCOUNTANT)
  contactName      String?
  email            String?
  phone            String?
  /// Commission is this percentage of the lead's monthly fee, for this many months, once the lead is won.
  commissionPct    Decimal      @default(0) @db.Decimal(5, 2)
  commissionMonths Int          @default(12)
  notes            String?
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now())

  leads   Lead[]
  payouts ReferralPayout[]

  @@unique([organizationId, name])
}

/// A prospect. Its stage changes are recorded; a won lead is final.
model Lead {
  id                   String           @id @default(cuid())
  organizationId       String
  organization         Organization     @relation(fields: [organizationId], references: [id])
  number               String
  company              String
  segment              LeadSegment      @default(SME)
  headcount            Int?
  source               LeadSource       @default(OUTBOUND)
  partnerId            String?
  partner              ReferralPartner? @relation(fields: [partnerId], references: [id])
  contactName          String
  contactRole          String?
  contactEmail         String?
  contactPhone         String?
  /// What the bureau expects to bill each month if it wins this.
  expectedMrr          Decimal          @default(0) @db.Decimal(14, 2)
  stage                LeadStage        @default(QUALIFIED)
  stageChangedAt       DateTime         @default(now())
  nextStep             String?
  nextStepOn           DateTime?        @db.Date
  ownerUserId          String
  ownerName            String
  lostReason           String?
  wonAt                DateTime?
  lostAt               DateTime?
  /// The client organization this became, once it was onboarded.
  clientOrganizationId String?
  notes                String?
  createdBy            String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  stageChanges LeadStageChange[]
  proposals    Proposal[]
  blueprints   ClientBlueprint[]
  healthChecks HealthCheck[]
  activities   OutreachActivity[]
  payouts      ReferralPayout[]

  @@unique([organizationId, number])
  @@index([organizationId, stage])
}

/// Every move of a lead between stages, with who and why. Never changed.
model LeadStageChange {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id])
  fromStage      LeadStage?
  toStage        LeadStage
  note           String?
  byName         String
  byUserId       String
  at             DateTime     @default(now())

  @@index([leadId, at])
  @@index([organizationId, toStage, at])
}

/// One attempt to reach someone: who, how, what came of it. Qualified contacts per working day is the measure.
model OutreachActivity {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  leadId         String?
  lead           Lead?           @relation(fields: [leadId], references: [id])
  company        String
  contactName    String?
  channel        OutreachChannel
  outcome        OutreachOutcome
  note           String?
  date           DateTime        @db.Date
  byName         String
  byUserId       String
  createdAt      DateTime        @default(now())

  @@index([organizationId, date])
  @@index([leadId])
}

/// Commission actually paid to a referral partner.
model ReferralPayout {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  partnerId      String
  partner        ReferralPartner @relation(fields: [partnerId], references: [id])
  leadId         String
  lead           Lead            @relation(fields: [leadId], references: [id])
  amount         Decimal         @db.Decimal(14, 2)
  paidOn         DateTime        @db.Date
  reference      String?
  byName         String
  createdAt      DateTime        @default(now())

  @@index([partnerId])
  @@index([leadId])
}

// ─────────────────────────────── PRICING AND PROPOSALS ───────────────────────────────

/// The bureau's costs and targets: what delivering a client's payroll costs it, and the margin it aims for. Placeholders until a manager confirms them.
model PricingSetting {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id])
  /// What one hour of a payroll officer's time costs the bureau.
  hourlyCost          Decimal      @db.Decimal(12, 2)
  /// Software and support cost of serving one client, a fixed amount per month, plus an amount per employee.
  softwareFixed       Decimal      @db.Decimal(12, 2)
  softwarePerEmployee Decimal      @db.Decimal(12, 2)
  /// Overhead loaded on top of labour and software, as a percentage.
  overheadPct         Decimal      @db.Decimal(5, 2)
  targetMarginPct     Decimal      @db.Decimal(5, 2)
  vatRatePct          Decimal      @default(7.5) @db.Decimal(5, 2)
  /// How many days a proposal stays open.
  validityDays        Int          @default(30)
  confirmedBy         String?
  confirmedByUserId   String?
  confirmedAt         DateTime?
  updatedBy           String
  updatedAt           DateTime     @updatedAt
}

/// What a package costs the client and what delivering it takes. Scope and responsibilities are the wording that goes on a proposal.
model PricingPackage {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  key                String
  perEmployeeRate    Decimal      @db.Decimal(12, 2)
  monthlyMinimum     Decimal      @db.Decimal(12, 2)
  onboardingFee      Decimal      @db.Decimal(12, 2)
  /// Hours of a payroll officer's time each month before counting employees, and minutes more for each employee.
  baseHours          Decimal      @db.Decimal(8, 2)
  minutesPerEmployee Decimal      @db.Decimal(8, 2)
  scope              String
  responsibilities   String
  active             Boolean      @default(true)
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, key])
}

model PricingAddOn {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  code               String
  name               String
  description        String?
  monthlyFee         Decimal      @default(0) @db.Decimal(12, 2)
  perEmployeeFee     Decimal      @default(0) @db.Decimal(12, 2)
  onboardingFee      Decimal      @default(0) @db.Decimal(12, 2)
  hours              Decimal      @default(0) @db.Decimal(8, 2)
  minutesPerEmployee Decimal      @default(0) @db.Decimal(8, 2)
  active             Boolean      @default(true)
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, code])
}

enum ProposalStatus {
  DRAFT
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
  WITHDRAWN
}

/// An offer to a lead. What it says (the quote, with the rate card, scope and responsibilities as they were) is frozen when it is sent.
model Proposal {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id])
  number           String
  packageKey       String
  headcount        Int
  termMonths       Int
  /// Extra delivery hours a month for what makes this client harder than the package assumes (several sites, shift allowances, ...).
  extraHours       Decimal        @default(0) @db.Decimal(8, 2)
  discountPct      Decimal        @default(0) @db.Decimal(5, 2)
  discountReason   String?
  addOnCodes       String[]
  /// The whole quote as computed, with the wording that goes on the page.
  quote            Json
  monthlyFee       Decimal        @db.Decimal(14, 2)
  onboardingFee    Decimal        @db.Decimal(14, 2)
  marginPct        Decimal        @db.Decimal(7, 2)
  belowTarget      Boolean        @default(false)
  status           ProposalStatus @default(DRAFT)
  approvedBy       String?
  approvedByUserId String?
  approvedAt       DateTime?
  approvalNote     String?
  validUntil       DateTime?      @db.Date
  sentAt           DateTime?
  sentBy           String?
  decidedAt        DateTime?
  decisionNote     String?
  createdBy        String
  createdByUserId  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  blueprints ClientBlueprint[]

  @@unique([organizationId, number])
  @@index([leadId])
  @@index([organizationId, status])
}

// ─────────────────────────────── PAYROLL HEALTH CHECK ───────────────────────────────

enum HealthCheckStatus {
  IN_PROGRESS
  IN_REVIEW
  ISSUED
  WITHDRAWN
}

/// What was found for one control. "In place" means the control was seen operating, with evidence; it is never a certification.
enum ControlResponse {
  NOT_ASSESSED
  IN_PLACE
  PARTLY
  NOT_SEEN
  NOT_APPLICABLE
}

enum FindingSeverity {
  HIGH
  MEDIUM
  LOW
  OBSERVATION
}

/// A limited review of a prospect's payroll process against a standard checklist. A second person reviews it before it is issued; once issued it
/// can't change.
model HealthCheck {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  leadId           String
  lead             Lead              @relation(fields: [leadId], references: [id])
  number           String
  title            String
  /// What was and wasn't looked at, and how much of it, in the assessor's words.
  scopeNote        String?
  periodReviewed   String?
  employeesInScope Int?
  /// The fee agreed for the review, noted by hand (it is not priced in the proposal tool).
  feeQuoted        Decimal?          @db.Decimal(14, 2)
  /// The version of the checklist the items were copied from.
  templateVersion  String
  status           HealthCheckStatus @default(IN_PROGRESS)
  assessedBy       String
  assessedByUserId String
  conductedOn      DateTime?         @db.Date
  submittedAt      DateTime?
  reviewedBy       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?
  /// A short overall observation for the summary, in the reviewer's words.
  headline         String?
  issuedAt         DateTime?
  withdrawnReason  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items    HealthCheckItem[]
  findings HealthCheckFinding[]

  @@unique([organizationId, number])
  @@index([leadId])
  @@index([organizationId, status])
}

model HealthCheckItem {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  checkId        String
  check          HealthCheck     @relation(fields: [checkId], references: [id])
  code           String
  area           String
  position       Int
  question       String
  guidance       String
  response       ControlResponse @default(NOT_ASSESSED)
  /// What was seen: the process evidence behind the response.
  evidence       String?
  note           String?
  assessedAt     DateTime?

  @@unique([checkId, code])
  @@index([checkId])
}

model HealthCheckFinding {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  checkId        String
  check          HealthCheck     @relation(fields: [checkId], references: [id])
  number         Int
  /// The control this is about, if it is about one.
  itemCode       String?
  area           String
  title          String
  description    String
  severity       FindingSeverity
  recommendation String
  createdBy      String
  createdAt      DateTime        @default(now())

  @@unique([checkId, number])
  @@index([checkId])
}

/// One run of a scheduled job (the reminders, the HR digest, ...), written by the job's own endpoint so the app can tell whether a scheduler is calling it.
model JobRun {
  id         String    @id @default(cuid())
  name       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  error      String?

  @@index([name, startedAt])
}

/// A launch-checklist item a bureau manager has confirmed by hand (something the app can't see for itself), with who, when and what they did.
model LaunchCheck {
  id                   String       @id @default(cuid())
  bureauOrganizationId String
  bureau               Organization @relation(fields: [bureauOrganizationId], references: [id])
  key                  String
  note                 String
  confirmedBy          String
  confirmedByUserId    String
  confirmedAt          DateTime     @default(now())

  @@unique([bureauOrganizationId, key])
}

enum ClientInputStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// A month's inputs (overtime, allowances, bonuses, deductions) sent by the client's HR contact as a file. Nothing in it reaches the payroll until
/// the bureau accepts it. Its rows are never changed; the decision is recorded once.
model ClientInputBatch {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  periodId          String
  period            PayrollPeriod     @relation(fields: [periodId], references: [id])
  number            String
  fileName          String
  /// SHA-256 of the file, so the same file is not sent twice for a month.
  checksum          String
  status            ClientInputStatus @default(SUBMITTED)
  rowCount          Int
  warningCount      Int               @default(0)
  earningsTotal     Decimal           @db.Decimal(14, 2)
  deductionsTotal   Decimal           @db.Decimal(14, 2)
  /// Sent after the month's input cut-off.
  late              Boolean           @default(false)
  note              String?
  /// The tracker inputs this upload marked as received (put back if it is refused or withdrawn).
  markedKinds       String[]
  submittedBy       String
  submittedByUserId String
  createdAt         DateTime          @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  rows ClientInputRow[]

  @@unique([organizationId, number])
  @@index([organizationId, periodId, status])
}

model ClientInputRow {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  batchId        String
  batch          ClientInputBatch @relation(fields: [batchId], references: [id])
  line           Int
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  /// OVERTIME, ALLOWANCE, BONUS, OTHER_EARNING, or a deduction type (DEDUCTION, PENALTY, RECOVERY, SALARY_ADVANCE).
  type           String
  description    String
  amount         Decimal          @db.Decimal(14, 2)
  taxable        Boolean          @default(true)
  reference      String?
  note           String?
  warnings       String[]
  /// Once accepted: what the row became (OtherEarning or Deduction) and its id.
  appliedKind    String?
  appliedId      String?

  @@index([batchId])
  @@index([organizationId, employeeId])
}

/// A question or request from a client to the bureau, with a thread of messages. How quickly it was first answered is measured from it.
model ClientQuery {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  number          String
  subject         String
  category        String
  status          QueryStatus  @default(OPEN)
  raisedBy        String
  raisedByUserId  String
  createdAt       DateTime     @default(now())
  /// When the bureau first replied.
  firstResponseAt DateTime?
  closedAt        DateTime?
  closedBy        String?
  updatedAt       DateTime     @updatedAt

  messages ClientQueryMessage[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

/// One message in a query's thread. Never edited or removed.
model ClientQueryMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  queryId        String
  query          ClientQuery  @relation(fields: [queryId], references: [id])
  /// CLIENT or BUREAU.
  side           String
  authorName     String
  authorUserId   String
  body           String
  createdAt      DateTime     @default(now())

  @@index([queryId, createdAt])
}

enum ClientDecision {
  APPROVED
  REJECTED
}

/// The client's own sign-off (or refusal) of a payroll, with who and why. It names the calculation it covers: a payroll calculated again afterwards
/// needs a fresh approval. Never changed.
model PayrollClientApproval {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  runId            String
  calculationCount Int
  decision         ClientDecision
  comment          String?
  byName           String
  byUserId         String
  createdAt        DateTime       @default(now())

  @@index([organizationId, runId, createdAt])
}

/// Whether payslips may be emailed to employees from this organization. Off until someone switches it on; downloads are always available.
model PayslipSetting {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  emailEnabled   Boolean      @default(false)
  updatedBy      String?
  updatedAt      DateTime     @updatedAt
}

/// Every payslip emailed: to whom, when, by whom, and a fingerprint of the PDF sent. Never changed.
model PayslipDelivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  runId          String
  recordId       String
  employeeId     String
  toEmail        String
  checksum       String
  sentBy         String
  sentByUserId   String
  sentAt         DateTime     @default(now())

  @@index([organizationId, runId])
  @@index([recordId])
}

/// A bank and the code a bulk payment upload asks for. Starts from a standard list, corrected or extended per organization; confirm against the
/// upload guide of the bank the client pays from.
model BankCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  /// Other names employees' records use for the bank.
  aliases        String[]     @default([])
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId, code])
}

/// A bank payment file produced for a payroll run: who produced it, when, how many people and how much, who was left out, and a fingerprint of the
/// file itself so the one uploaded to the bank can be matched to the one the app made. Never changed.
model PaymentFileExport {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  runId           String
  fileName        String
  rowCount        Int
  totalAmount     Decimal      @db.Decimal(16, 2)
  /// People left out because their bank details could not be used, with why.
  excluded        Json
  checksum        String
  createdBy       String
  createdByUserId String
  createdAt       DateTime     @default(now())
  /// The bank this file was made for, the version of ITS code list the codes came from, and the layout's headers: so a file can always be traced to the list it used.
  payingBankId    String?
  payingBank      PayingBank?  @relation(fields: [payingBankId], references: [id])
  codeSetVersion  Int?
  layoutHeaders   String?

  @@index([organizationId, runId, createdAt])
}

/// A bank a client pays salaries FROM. It has its own list of bank codes (a bank's codes are valid only on its own list) and its own upload file layout, both as data,
/// so adding a bank needs no code. docs/plans/paying-bank-files.md.
model PayingBank {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  name               String
  /// The upload file's layout (columns and where each comes from). Null until the bank's upload template is known: such a bank cannot make a file.
  layout             Json?
  /// The company's own account at this bank that the payroll is paid from (some layouts put it on every row).
  debitAccountNumber String?
  active             Boolean      @default(true)
  isDefault          Boolean      @default(false)
  createdBy          String
  createdAt          DateTime     @default(now())

  codeSets     BankCodeSet[]
  exports      PaymentFileExport[]
  employees    Employee[]
  transactions PaymentTransaction[]

  @@unique([organizationId, name])
}

/// One imported version of a paying bank's code list. Never edited: a newer list from the bank is a new version, and a file records the version it used.
model BankCodeSet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  payingBankId   String
  payingBank     PayingBank   @relation(fields: [payingBankId], references: [id])
  version        Int
  /// The file name, or the name of the list supplied with the app.
  sourceName     String
  /// SHA-256 of the list's text, so the list used can be proved.
  sourceSha256   String
  entryCount     Int
  blockedCount   Int
  importedBy     String
  importedAt     DateTime     @default(now())

  entries PayingBankCode[]

  @@unique([payingBankId, version])
}

/// One bank on a paying bank's list. A blocked entry (a test bank, a code shared by two banks, a bank under two codes, a code that lost a leading zero) is never put in a file.
model PayingBankCode {
  id            String      @id @default(cuid())
  codeSetId     String
  codeSet       BankCodeSet @relation(fields: [codeSetId], references: [id])
  name          String
  code          String
  aliases       String[]    @default([])
  blocked       Boolean     @default(false)
  blockedReason String?

  @@index([codeSetId, code])
}

/// Whether, and to whom, payroll deadline reminders are emailed for a client. Off until someone switches it on.
model PayrollReminderSetting {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  enabled        Boolean      @default(false)
  /// Email the client's contact (from the engagement) about inputs and approval they owe.
  remindClient   Boolean      @default(true)
  /// Email the bureau team working on the client a digest of overdue and imminent deadlines.
  remindTeam     Boolean      @default(true)
  /// Remind this many days before a deadline, and after it passes.
  leadDays       Int          @default(2)
  extraEmails    String[]     @default([])
  updatedBy      String?
  updatedAt      DateTime     @updatedAt
}

/// Every reminder email sent: to whom, about which month, when. Also what keeps the same reminder from going out twice in a day.
model PayrollReminderLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  periodId       String
  kind           String
  toEmail        String
  subject        String
  /// The calendar day (UTC) it was sent on.
  day            DateTime     @db.Date
  sentAt         DateTime     @default(now())

  @@unique([periodId, kind, toEmail, day])
  @@index([organizationId, sentAt])
}

/// One pay month's concrete dates. Worked out from the setting, then adjustable (a public holiday, an agreed exception) with a reason.
model PayrollCalendarEntry {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  periodId       String        @unique
  period         PayrollPeriod @relation(fields: [periodId], references: [id])
  inputCutoff    DateTime      @db.Date
  draftDue       DateTime      @db.Date
  approvalDue    DateTime      @db.Date
  payDate        DateTime      @db.Date
  remittanceDue  DateTime      @db.Date
  adjusted       Boolean       @default(false)
  adjustReason   String?
  adjustedBy     String?
  createdBy      String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

enum InputItemStatus {
  EXPECTED
  RECEIVED
  NOT_APPLICABLE
}

/// One input the client owes for a pay month, and whether it has come.
model PayrollInputItem {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  periodId       String
  period         PayrollPeriod   @relation(fields: [periodId], references: [id])
  kind           String
  status         InputItemStatus @default(EXPECTED)
  receivedAt     DateTime?
  markedBy       String?
  markedByUserId String?
  /// How and from whom it arrived, or why it does not apply.
  note           String?
  createdAt      DateTime        @default(now())

  @@unique([periodId, kind])
  @@index([organizationId, status])
}

enum InputIssueStatus {
  OPEN
  RESOLVED
}

/// A missing or inconsistent item found in a client's inputs, kept as a log with how it was settled.
model PayrollInputIssue {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  periodId       String
  period         PayrollPeriod    @relation(fields: [periodId], references: [id])
  kind           String?
  description    String
  status         InputIssueStatus @default(OPEN)
  raisedBy       String
  raisedByUserId String
  createdAt      DateTime         @default(now())
  resolvedBy     String?
  resolvedAt     DateTime?
  resolution     String?

  @@index([organizationId, periodId, status])
}

enum RuleKind {
  TAX
  PENSION
  EMPLOYER_COST
}

enum RuleReleaseStatus {
  PROPOSED
  VERIFIED
  PUBLISHED
  WITHDRAWN
}

/// The two sign-offs a statutory rate change needs before it reaches any client: one from HR, one from Finance.
enum VerifierSlot {
  HR
  FINANCE
}

/// A statutory rule version held by the bureau (its master set), put forward for release to its clients. The checksum pins exactly what was
/// proposed, verified and published: if the master rule is changed afterwards, the release no longer matches and cannot go out.
model RuleRelease {
  id                   String            @id @default(cuid())
  bureauOrganizationId String
  bureau               Organization      @relation(fields: [bureauOrganizationId], references: [id])
  kind                 RuleKind
  /// The master rule row in the bureau's own organization.
  ruleId               String
  label                String
  version              String
  effectiveFrom        DateTime          @db.Date
  /// What changed and why.
  summary              String
  /// The legal basis or source: the law, gazette, circular or notice this comes from.
  source               String
  checksum             String
  status               RuleReleaseStatus @default(PROPOSED)
  proposedBy           String
  proposedByUserId     String
  createdAt            DateTime          @default(now())
  publishedAt          DateTime?
  publishedBy          String?
  withdrawnReason      String?
  withdrawnBy          String?

  verifications RuleVerification[]
  publications  RulePublication[]

  @@index([bureauOrganizationId, createdAt])
}

model RuleVerification {
  id             String       @id @default(cuid())
  releaseId      String
  release        RuleRelease  @relation(fields: [releaseId], references: [id])
  slot           VerifierSlot
  verifierName   String
  verifierUserId String
  /// What the rate was checked against.
  note           String
  /// The checksum of the rule at the moment it was verified.
  checksum       String
  createdAt      DateTime     @default(now())

  @@unique([releaseId, slot])
}

enum RulePublicationOutcome {
  PUBLISHED
  ALREADY_HELD
  FAILED
}

model RulePublication {
  id                   String                 @id @default(cuid())
  releaseId            String
  release              RuleRelease            @relation(fields: [releaseId], references: [id])
  clientOrganizationId String
  client               Organization           @relation(fields: [clientOrganizationId], references: [id])
  outcome              RulePublicationOutcome
  message              String?
  publishedBy          String
  createdAt            DateTime               @default(now())

  @@unique([releaseId, clientOrganizationId])
}

enum EngagementPackage {
  PAYROLL_ESSENTIALS
  PAYROLL_COMPLIANCE
  MANAGED_PAYROLL_PLUS
  ENTERPRISE
  HEALTH_CHECK
}

enum EngagementStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  ENDED
}

/// The commercial terms and contacts for one client of the bureau. Lives with the bureau; the client organization holds the payroll data.
model ClientEngagement {
  id                   String            @id @default(cuid())
  bureauOrganizationId String
  bureau               Organization      @relation("EngagementBureau", fields: [bureauOrganizationId], references: [id])
  clientOrganizationId String            @unique
  client               Organization      @relation("EngagementClient", fields: [clientOrganizationId], references: [id])
  package              EngagementPackage
  status               EngagementStatus  @default(ONBOARDING)
  startDate            DateTime          @db.Date
  /// 6 or 12 months.
  termMonths           Int
  perEmployeeRate      Decimal           @default(0) @db.Decimal(14, 2)
  monthlyMinimum       Decimal           @default(0) @db.Decimal(14, 2)
  onboardingFee        Decimal           @default(0) @db.Decimal(14, 2)
  addOns               String?
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  /// Agreed turnaround and service levels, in the client's words.
  slaTerms             String?
  /// Reference to the signed data-processing terms, and when they were signed.
  dpaReference         String?
  dpaSignedAt          DateTime?         @db.Date
  notes                String?
  createdBy            String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([bureauOrganizationId, status])
}

/// Which bureau staff may work in which client organization. Whoever manages the bureau can work in all of them without a grant.
model StaffClientAccess {
  id                   String       @id @default(cuid())
  bureauOrganizationId String
  bureau               Organization @relation("AccessBureau", fields: [bureauOrganizationId], references: [id])
  userId               String
  user                 User         @relation(fields: [userId], references: [id])
  clientOrganizationId String
  client               Organization @relation("AccessClient", fields: [clientOrganizationId], references: [id])
  grantedBy            String
  grantedByUserId      String
  createdAt            DateTime     @default(now())

  @@unique([userId, clientOrganizationId])
  @@index([clientOrganizationId])
}

model User {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  email           String       @unique
  name            String
  passwordHash    String
  role            Role
  active          Boolean      @default(true)
  employeeId      String?      @unique
  employee        Employee?    @relation(fields: [employeeId], references: [id])
  supervisedBeats Beat[]       @relation("BeatSupervisor")
  lastLoginAt     DateTime?

  // Login rate limiting — reset on success, incremented on failure.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Bumped on logout-everywhere / password change — invalidates every outstanding session JWT at once.
  sessionVersion Int @default(1)

  /// An outsourced HR officer or administrator (not an employee of the company): requires two-factor sign-in and an end date.
  external      Boolean   @default(false)
  /// The last day this person can sign in (required for an external user). Null = no end.
  accessEndsOn  DateTime? @db.Date
  functionGrants UserFunctionGrant[]
  probationDeciderRows ProbationDecider[]

  // TOTP two-factor authentication (optional; not yet enforced by role).
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpVerifiedAt DateTime?
  /// Bcrypt-hashed one-time backup codes; a code is removed from the array once used.
  backupCodes    String[]  @default([])

  passwordResetTokens PasswordResetToken[]
  clientAccess        StaffClientAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// Single-use, short-lived password reset tokens — only the bcrypt hash is stored, never the raw token.
model PasswordResetToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
}

model NumberingRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  entity         String // EMPLOYEE, CLIENT, CONTRACT, BEAT, PAYMENT_BATCH
  prefix         String
  separator      String       @default("-")
  digits         Int          @default(6)
  nextNumber     Int          @default(1)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entity])
}

// ─────────────────────────────── WORKFORCE ───────────────────────────────

model Department {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  employees      Employee[]
  probationDeciders ProbationDecider[]
  costCenterId   String?
  costCenter     CostCenter?      @relation(fields: [costCenterId], references: [id])
  requisitions   JobRequisition[]
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// An independent cost-grouping dimension — assignable to departments, contracts, and beats — for
/// grouping costs your own way (e.g. by region or business unit) independent of the client/contract
/// structure. Feeds budgeting and cost-center reporting.
model CostCenter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  description    String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments      Department[]
  contracts        Contract[]
  beats            Beat[]
  budgets          CostCenterBudget[]
  purchaseOrders   PurchaseOrder[]
  purchaseInvoices PurchaseInvoice[]
  fixedAssets      FixedAsset[]
  jobRequisitions  JobRequisition[]
  journalLines     JournalLine[]

  @@unique([organizationId, code])
}

/// A per-cost-center, per-period budget for budget-vs-actual variance reporting.
model CostCenterBudget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  costCenterId   String
  costCenter     CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  year           Int
  month          Int
  budgetedAmount Decimal      @db.Decimal(16, 2)
  notes          String?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([costCenterId, year, month])
  @@index([organizationId, year, month])
}

model EmployeeCategory {
  id                   String                  @id @default(cuid())
  organizationId       String
  organization         Organization            @relation(fields: [organizationId], references: [id])
  code                 String
  name                 String
  description          String?
  employees            Employee[]
  contractRates        ContractRate[]
  salaryStructures     SalaryStructure[]
  deployments          Deployment[]
  workRegister         WorkRegister[]
  requisitions         JobRequisition[]
  checklistItems       ChecklistTemplateItem[]
  jobDescriptions      JobDescription[]
  documentRequirements EmployeeDocumentRequirement[]
  kitPacks             KitPack[]
  trainingRequirements TrainingRequirement[]
  companyPolicies      CompanyPolicy[]
  careerPathsFrom      CareerPath[]       @relation("CareerPathFrom")
  careerPathsTo        CareerPath[]       @relation("CareerPathTo")
  promotionsFrom       PromotionProposal[] @relation("PromotionFrom")
  promotionsTo         PromotionProposal[] @relation("PromotionTo")
  successionRoles      SuccessionRole[]
  roleSkills           RoleSkill[]

  @@unique([organizationId, code])
}

/// One bulk import of employees from a file: who, when, which file, and what happened to each row. Never changed afterwards.
model EmployeeImportBatch {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  fileName        String
  rowCount        Int
  importedCount   Int
  skippedCount    Int
  warningCount    Int
  /// Per row: line, outcome (IMPORTED / SKIPPED), employee number, and the errors or warnings found.
  outcomes        Json
  createdBy       String
  createdByUserId String
  createdAt       DateTime     @default(now())

  employees Employee[]

  @@index([organizationId, createdAt])
}

model Employee {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  importBatchId      String?
  importBatch        EmployeeImportBatch? @relation(fields: [importBatchId], references: [id])
  clientInputRows    ClientInputRow[]
  employeeNumber     String
  /// The paying bank this person's salary is paid from. Empty = the organization's default paying bank. It is copied onto the payment when the payment batches are made.
  payingBankId       String?
  payingBank         PayingBank?          @relation(fields: [payingBankId], references: [id])
  firstName          String
  middleName         String?
  lastName           String
  gender             Gender?
  dateOfBirth        DateTime?            @db.Date
  phone              String?
  email              String?
  address            String?
  /// Has chosen to contribute to the National Housing Fund (voluntary: 2.5% of basic pay, remitted by the end of the month). Off unless chosen.
  nhfContributes     Boolean              @default(false)
  /// The day they chose it; cleared when they stop.
  nhfOptedInOn       DateTime?            @db.Date
  /// The state PAYE is due to (one of the 36 states or FCT, under its proper name). Copied onto each payroll record when it is calculated.
  stateOfResidence   String?
  employmentDate     DateTime             @db.Date
  exitDate           DateTime?            @db.Date
  /// Set when the personal details were removed after the retention period (the record, employee number and pay figures stay).
  anonymizedAt       DateTime?
  status             EmployeeStatus       @default(ACTIVE)
  categoryId         String
  category           EmployeeCategory     @relation(fields: [categoryId], references: [id])
  departmentId       String?
  department         Department?          @relation(fields: [departmentId], references: [id])
  bankName           String?
  accountNumber      String?
  accountName        String?
  taxId              String?
  pensionPin         String?
  pfa                String?
  annualRent         Decimal?             @db.Decimal(14, 2) // declared rent for NTA 2025 rent relief
  currentClientId    String?
  currentClient      Client?              @relation(fields: [currentClientId], references: [id])
  currentBeatId      String?
  currentBeat        Beat?                @relation("CurrentBeat", fields: [currentBeatId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?            @relation("ReportingLine", fields: [reportingManagerId], references: [id])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user                    User?
  deployments             Deployment[]
  movements               StaffMovement[]
  workRegister            WorkRegister[]
  salaryOverrides         EmployeeSalaryOverride[]
  payRates                EmployeePayRate[]
  payRateProposals        PayRateProposal[]
  payrollRecords          PayrollRecord[]
  overtime                Overtime[]
  arrears                 Arrears[]
  deductions              Deduction[]
  otherEarnings           OtherEarning[]
  validationIssues        PayrollValidationIssue[]
  paymentTxns             PaymentTransaction[]
  leaveRequests           LeaveRequest[]
  directReports           Employee[]               @relation("ReportingLine")
  feedbackReceived        PerformanceFeedback[]
  probationDecisions      ProbationDecision[]
  probationReviews        ProbationReview[]
  retentionHolds          RetentionHold[]
  trainingEnrolments      TrainingEnrolment[]
  trainingNeeds           TrainingNeed[]
  trainingRequests        TrainingRequest[]
  skillAssessments        SkillAssessment[]
  surveyAccessCodes       SurveyAccessCode[]
  recognitionAwards       RecognitionAward[]
  promotionProposals      PromotionProposal[]
  successionCandidates    SuccessionCandidate[]
  documents               EmployeeDocument[]
  trainings               EmployeeTraining[]
  disciplinaryRecords     DisciplinaryRecord[]
  onboardingTasks         OnboardingTask[]
  exitRecords             ExitRecord[]
  recurringDeductionRules RecurringDeductionRule[]
  assignedFixedAssets     FixedAsset[]
  employmentContracts     EmploymentContract[]
  relationsCases          RelationsCase[]
  exitSettlements         ExitSettlement[]
  candidateRecord         Candidate?               @relation("CandidateEmployee")
  managedRequisitions     JobRequisition[]         @relation("RequisitionManager")
  stockMovements          StockMovement[]
  staffLoans              StaffLoan[]
  generatedLetters        GeneratedLetter[]
  contacts                EmployeeContact[]
  guarantors              EmployeeGuarantor[]
  changeRequests          EmployeeChangeRequest[]
  policyAcknowledgements  PolicyAcknowledgement[]
  dataAccessRequests      DataAccessRequest[]
  appraisals              Appraisal[]
  improvementPlans        PerformanceImprovementPlan[]
  erasures                EmployeeErasure[]
  journalLines            JournalLine[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
}

// ─────────────────────────── HR / HRIS RECORDS ───────────────────────────

/// Employee documents (ID, licenses, contracts, certificates). Metadata-only — fileReference is a
/// filename/reference/description, matching the ClientInvoiceDeduction.supportingDocument convention
/// (this app has no object storage configured).
model EmployeeDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   DocumentType
  documentNumber String?
  issueDate      DateTime?    @db.Date
  expiryDate     DateTime?    @db.Date
  fileReference  String // filename / reference / description — proof of the physical/scanned document
  notes          String?
  uploadedBy     String
  createdAt      DateTime     @default(now())
  /// Electronic documents (2026-11-07). A row with no type and no versions is a reference-only record from before document management.
  typeId         String?
  type           EmployeeDocumentType? @relation(fields: [typeId], references: [id])
  /// Null for a reference-only record: no approval is invented for it.
  status         DocumentStatus?
  description    String?
  archivedBy     String?
  archivedAt     DateTime?
  updatedAt      DateTime     @default(now()) @updatedAt
  /// The approval workflow: submitted by one person, taken and decided by another (never the uploader or the submitter).
  submittedBy       String?
  submittedByUserId String?
  submittedAt       DateTime?
  reviewedBy        String?
  reviewedByUserId  String?
  reviewStartedAt   DateTime?
  reviewedAt        DateTime?
  /// The reason for a rejection, or the approver's note.
  reviewNote        String?

  versions EmployeeDocumentVersion[]
  onboardingTasks OnboardingTask[]
  exitTasks       ExitTask[]

  @@index([organizationId, employeeId])
  @@index([organizationId, expiryDate])
  @@index([organizationId, typeId])
}

/// A kind of document within a category. Data, not code: an administrator adds, renames or switches off types. Standard types are seeded for each company.
model EmployeeDocumentType {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  category         DocumentCategory
  code             String
  name             String
  requiresApproval Boolean          @default(true)
  hasExpiry        Boolean          @default(false)
  /// Needs the document-sensitive permission to open (identification and medical by default).
  sensitive        Boolean          @default(false)
  active           Boolean          @default(true)
  standard         Boolean          @default(false)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  documents EmployeeDocument[]
  templateItems ChecklistTemplateItem[]
  onboardingTasks OnboardingTask[]
  exitTasks     ExitTask[]
  requirements  EmployeeDocumentRequirement[]

  @@unique([organizationId, code])
  @@index([organizationId, category])
}

/// One uploaded file of a document. A replacement is a new version: the earlier ones are kept and can be inspected. The bytes are in EmployeeDocumentBlob, so listing versions never loads them.
model EmployeeDocumentVersion {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  documentId       String
  document         EmployeeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version          Int
  fileName         String
  mimeType         String
  sizeBytes        Int
  /// SHA-256 of the file as uploaded, checked again when it is read back.
  sha256           String
  uploadedBy       String
  uploadedByUserId String?
  uploadedAt       DateTime         @default(now())
  /// Set when a newer version replaces this one.
  replacedBy       String?
  replacedAt       DateTime?

  blob EmployeeDocumentBlob?

  @@unique([documentId, version])
  @@index([organizationId])
}

/// The file itself, encrypted (AES-256-GCM) before it is saved. Without the key (DOCUMENT_ENCRYPTION_KEY) it cannot be read.
model EmployeeDocumentBlob {
  versionId      String                  @id
  version        EmployeeDocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  data           Bytes
  iv             Bytes
  authTag        Bytes
  keyId          String                  @default("v1")

  @@index([organizationId])
}

/// A document type the company requires, of everyone or of one employee category. Drives the missing-document tracking: an employee has it only when an approved,
/// unexpired document of the type is on file. The company sets these; nothing is seeded.
model EmployeeDocumentRequirement {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  typeId         String
  type           EmployeeDocumentType @relation(fields: [typeId], references: [id])
  /// Null = every employee.
  categoryId     String?
  category       EmployeeCategory?    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  active         Boolean              @default(true)
  createdBy      String
  createdAt      DateTime             @default(now())

  @@unique([organizationId, typeId, categoryId])
  @@index([organizationId, active])
}

/// Training & certifications — critical for a security workforce (firearms license, first aid,
/// tactical training). expiryDate drives compliance/expiry reports and alerts.
model EmployeeTraining {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseName        String
  provider          String?
  certificateNumber String?
  issueDate         DateTime       @db.Date
  expiryDate        DateTime?      @db.Date
  status            TrainingStatus @default(VALID)
  fileReference     String?
  recordedBy        String
  createdAt         DateTime       @default(now())
  /// The training enrolment whose attendance created this record, if it was created that way (null for a certificate HR recorded by hand).
  enrolmentId       String?             @unique
  enrolment         TrainingEnrolment?  @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
  @@index([organizationId, expiryDate])
}

/// Disciplinary actions and commendations — maker/checker: raised PENDING, then approved/rejected
/// (mirrors StaffMovement's request→approve pattern).
model DisciplinaryRecord {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type           DisciplinaryType
  incidentDate   DateTime         @db.Date
  description    String
  actionTaken    String?
  issuedBy       String
  /// Who raised it, so the person who raises a sanction does not also approve it (governance step 2b). Null before this rule: it does not apply.
  issuedByUserId String?
  status         ApprovalStatus   @default(PENDING)
  approvedBy     String?
  approvedByUserId String?
  /// The approver was also the raiser, being the only holder of the right needed (flagged, with the reason kept).
  approvedSingleHolder Boolean @default(false)
  approvedSingleReason String?
  remarks        String?
  /// The employee-relations case (investigation / hearing) this sanction came out of, if any.
  caseId         String?
  relationsCase  RelationsCase?   @relation(fields: [caseId], references: [id])
  createdAt      DateTime         @default(now())

  @@index([organizationId, employeeId])
}

/// Per-employee onboarding checklist — standard tasks are seeded automatically on hire
/// (see ONBOARDING_TASKS); HR can also add ad-hoc tasks and check them off.
model OnboardingTask {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  taskName        String
  status          ChecklistStatus @default(PENDING)
  dueDate         DateTime?       @db.Date
  completedBy     String?
  completedAt     DateTime?
  notes           String?
  sortOrder       Int             @default(0)
  /// Who is expected to do it (free text — "HR", "IT", "Supervisor"), copied from the template.
  responsibleRole String?
  mandatory       Boolean         @default(true)
  createdAt       DateTime        @default(now())
  /// Copied from the template when the task is made; the document that completes it is attached when it is uploaded.
  documentTypeId  String?
  documentType    EmployeeDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  documentId      String?
  document        EmployeeDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([organizationId, employeeId])
}

/// Offboarding / exit management — maker/checker like StaffMovement. Approval sets Employee.status
/// + exitDate and auto-seeds the clearance checklist (see EXIT_CLEARANCE_TASKS).
model ExitRecord {
  id                 String              @id @default(cuid())
  organizationId     String
  organization       Organization        @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee            @relation(fields: [employeeId], references: [id])
  exitType           ExitType
  noticeDate         DateTime            @db.Date
  lastWorkingDate    DateTime            @db.Date
  reason             String
  status             ApprovalStatus      @default(PENDING)
  initiatedBy        String
  approvedBy         String?
  remarks            String?
  reasonCategory     ExitReasonCategory?
  /// Notice the employee owed under their contract (or the org default) — frozen at initiation so a
  /// later policy edit can't rewrite a settlement that's already being prepared.
  noticePeriodDays   Int?
  /// Gross-misconduct dismissal: no notice pay is owed by the employer.
  summaryDismissal   Boolean             @default(false)
  eligibleForRehire  Boolean?
  exitInterviewDate  DateTime?           @db.Date
  exitInterviewNotes String?
  exitInterviewBy    String?
  createdAt          DateTime            @default(now())

  tasks      ExitTask[]
  settlement ExitSettlement?

  @@index([organizationId, employeeId])
}

model ExitTask {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  exitRecordId     String
  exitRecord       ExitRecord      @relation(fields: [exitRecordId], references: [id], onDelete: Cascade)
  taskName         String
  status           ChecklistStatus @default(PENDING)
  completedBy      String?
  completedAt      DateTime?
  notes            String?
  sortOrder        Int             @default(0)
  dueDate          DateTime?       @db.Date
  responsibleRole  String?
  mandatory        Boolean         @default(true)
  /// When true the settlement can't be approved until this item is DONE / NOT_APPLICABLE.
  blocksSettlement Boolean         @default(true)
  /// "FINAL_SETTLEMENT" is auto-completed by the system when the settlement is approved.
  systemKey        String?
  documentTypeId   String?
  documentType     EmployeeDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  documentId       String?
  document         EmployeeDocument?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([organizationId, exitRecordId])
}

// ───────────────────── HR LIFECYCLE: POLICY & TEMPLATES ─────────────────────

/// One per organization — every number a buyer might want to change without a code change:
/// probation/notice defaults, alert windows, offer validity, and the end-of-service rules
/// (leave encashment, gratuity, severance, notice pay). Defaults are conservative; gratuity and
/// severance ship OFF because they're jurisdiction-specific.
model HrPolicy {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Employment terms & alerts
  defaultProbationMonths Int @default(3)
  maxProbationMonths     Int @default(6)
  defaultNoticeDays      Int @default(30)
  retirementAge          Int @default(60)
  contractAlertDays      Int @default(60)
  probationAlertDays     Int @default(30)
  /// An undecided probation moves to the approvals list once it has been past its end date for this many days (0 = never).
  probationEscalationDays Int @default(7)
  /// The recommend, HR review, independent decision and employee response flow for probation (docs/plans/probation-workflow-plan.md). OFF: the HR approver decides as before.
  probationWorkflow Boolean @default(false)
  /// Days after HR tells the employee that they may respond (that day counts); 0 = no time limit.
  probationResponseDays Int @default(7)
  /// The anniversaries (in whole years) HR is prompted about for long-service recognition. A prompt only: never an award.
  longServiceYears        Int[] @default([5, 10, 15, 20])
  /// An approved promotion not yet applied for this many days is flagged in the HR digest (0 = never).
  promotionApplyAlertDays Int @default(14)
  offerValidityDays      Int @default(14)
  relationsCaseSlaDays   Int @default(21)

  // Performance improvement plans (proposed defaults; the company sets its own)
  pipDefaultDays        Int @default(60)
  pipMaxDays            Int @default(90)
  pipMaxExtensions      Int @default(1)
  pipMaxExtensionDays   Int @default(30)
  pipReviewIntervalDays Int @default(14)

  // End-of-service: shared
  /// Monthly pay ÷ this = one day's pay (30 = calendar-month convention; 26 = working days).
  dailyRateDivisor Int @default(30)

  // Leave encashment
  leaveEncashmentEnabled             Boolean     @default(true)
  leaveEncashmentBasis               EosPayBasis @default(GROSS)
  /// Only encash leave once the employee has served the leave policy's eligibility period.
  leaveEncashmentRespectsEligibility Boolean     @default(true)
  leaveEncashmentMaxDays             Int?
  leaveEncashmentTaxable             Boolean     @default(true)
  leaveEncashmentExitTypes           ExitType[]  @default([RESIGNATION, TERMINATION, END_OF_CONTRACT, RETIREMENT, DECEASED])

  // Gratuity
  gratuityEnabled      Boolean     @default(false)
  gratuityBasis        EosPayBasis @default(BASIC)
  gratuityMinYears     Int         @default(5)
  gratuityDaysPerYear  Decimal     @default(15) @db.Decimal(6, 2)
  /// Count a part-year proportionally instead of only completed years.
  gratuityPartialYears Boolean     @default(false)
  gratuityTaxable      Boolean     @default(true)
  gratuityExitTypes    ExitType[]  @default([RESIGNATION, END_OF_CONTRACT, RETIREMENT, DECEASED])

  // Severance (redundancy)
  severanceEnabled     Boolean @default(false)
  severanceDaysPerYear Decimal @default(15) @db.Decimal(6, 2)
  severanceTaxable     Boolean @default(true)

  // Notice
  noticePayEnabled      Boolean @default(true) // employer ends employment short of notice → pay in lieu
  noticeRecoveryEnabled Boolean @default(true) // employee leaves short of notice → recover the shortfall
  noticePayTaxable      Boolean @default(true)

  // Who is told when the audit log fails its integrity check, and who gets the weekly chain head (docs/plans/tamper-evident-audit-log.md)
  /// Extra addresses (for example an outside auditor), on top of everyone who can view the audit log, or instead of them when the next field is false.
  auditAlertEmails          String[] @default([])
  auditAlertIncludeEveryone Boolean  @default(true)

  // Staff loans & advances (0 = no limit)
  loanMaxGrossMultiple Decimal @default(3) @db.Decimal(4, 2)
  loanMaxDeductionPct  Int     @default(33)
  advanceMaxGrossPct   Int     @default(50)

  // Personal records: contacts & guarantors (0 = not required / no limit)
  nextOfKinRequired         Int      @default(1)
  emergencyContactsRequired Int      @default(1)
  guarantorsRequired        Int      @default(2)
  /// Categories that must have guarantors; empty = every category.
  guarantorCategoryIds      String[] @default([])
  /// The most employees one person may guarantee at the same time.
  guarantorMaxPerPerson     Int      @default(3)
  /// Someone other than whoever recorded a guarantor must verify them.
  guarantorSeparateVerifier Boolean  @default(false)

  // Training compliance
  /// Flag a certificate this many days before it expires.
  trainingAlertDays Int @default(60)
  /// The manager is asked whether a course was applied on the job this many days after the session (0 = never asked).
  trainingEvaluationDays Int @default(60)
  /// A skill assessment older than this many days is listed as stale for HR (0 = never).
  skillReassessDays Int @default(365)
  /// Raw survey answers are deleted this many months after a survey closes (0 = never deleted automatically); the anonymised results are kept.
  surveyRetentionMonths Int @default(24)

  // Change control for bank, tax and pension details
  /// A change needs a second person's approval (otherwise anyone who can edit an employee can change it).
  sensitiveChangeApproval   Boolean @default(true)
  /// Payroll validation warns when an employee's bank account was changed within this many days (0 = off).
  bankChangeWatchDays       Int     @default(30)
  // Performance appraisals
  /// Employees rate themselves before their manager does.
  appraisalSelfAssessment   Boolean @default(true)
  /// A written comment is required for a rating at or below this (0 = never)…
  appraisalCommentAtOrBelow Int     @default(2)
  /// …or at or above this (0 = never).
  appraisalCommentAtOrAbove Int     @default(5)
  /// KPI achievement bands: [{ fromBp, score }], 10,000 basis points = 100%. Null = the defaults in src/lib/performance.ts.
  kpiBands                  Json?
  /// Employees with less service than this (at the period end) aren't included in a cycle.
  appraisalMinServiceDays   Int     @default(90)

  // Probation reviews
  /// A probation can only be confirmed after a signed-off probation appraisal.
  probationRequiresAppraisal Boolean @default(false)
  /// …scoring at least this (1–5; 0 = any score).
  probationMinScore          Decimal @default(0) @db.Decimal(3, 2)

  // Privacy: data subject access requests
  /// Days allowed to answer a request for a copy of someone's data, from the day it was received.
  dsarResponseDays Int @default(30)

  // Reminder digest email
  reminderEmailsEnabled Boolean   @default(true)
  /// Addresses that get the digest in addition to every active HR admin.
  reminderExtraEmails   String[]  @default([])
  lastDigestAt          DateTime?

  // Data retention: months to keep a rejected / withdrawn candidate's personal details (0 = keep for ever)
  candidateRetentionMonths Int @default(24)

  // Privacy: personal-data breaches
  /// Hours allowed to tell the regulator once the company is aware of a breach likely to put people at risk.
  breachNotifyHours Int     @default(72)
  /// Who the company has named as its data protection contact, shown on the breach pages and in the notice facts.
  dpoName           String?
  dpoEmail          String?
  dpoPhone          String?
  /// The regulator breaches are reported to, and how (portal, address, email), as the company's own procedure.
  regulatorName     String  @default("Nigeria Data Protection Commission")
  regulatorContact  String?
  /// The company's own breach procedure in its own words: who assesses, who tells whom, who signs off.
  breachRunbook     String?

  // Retention of former employees' personal details
  /// Years after leaving that records must be kept for tax and pension duties; after that they can be erased. 0 = off.
  employeeRetentionYears Int @default(0)

  // Security: roles that must use two-factor sign-in
  twoFactorRoles       Role[]    @default([])
  /// From this day the roles above can no longer use the app without two-factor; before it they are only reminded.
  twoFactorEnforceFrom DateTime? @db.Date

  updatedAt DateTime @updatedAt
}

/// A checklist step that is instantiated onto every new hire (ONBOARDING) or every approved exit
/// (EXIT_CLEARANCE). Edited in Settings so each buyer's own process is what gets seeded.
model ChecklistTemplateItem {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  kind             ChecklistKind
  taskName         String
  /// Onboarding: days after the start date. Exit: days relative to the last working date (negative = before).
  dueOffsetDays    Int               @default(0)
  responsibleRole  String?
  mandatory        Boolean           @default(true)
  /// Exit only — see ExitTask.blocksSettlement.
  blocksSettlement Boolean           @default(true)
  systemKey        String?
  /// Limit the step to one employee category (null = everyone).
  categoryId       String?
  category         EmployeeCategory? @relation(fields: [categoryId], references: [id])
  /// When set, the step follows an electronic document of this type (it is completed by the approved document, not by hand).
  documentTypeId   String?
  documentType     EmployeeDocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  active           Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, kind, taskName])
  @@index([organizationId, kind, active])
}

// ───────────────────────── HR LIFECYCLE: CONTRACTS ─────────────────────────

/// The employee's own terms of employment (distinct from `Contract`, which is a CLIENT service
/// contract). Renewals form a chain via previousContractId; exactly one contract per employee is
/// ACTIVE at a time (enforced in the service).
model EmploymentContract {
  id                  String                   @id @default(cuid())
  organizationId      String
  organization        Organization             @relation(fields: [organizationId], references: [id])
  contractNumber      String
  employeeId          String
  employee            Employee                 @relation(fields: [employeeId], references: [id])
  type                EmploymentType
  status              EmploymentContractStatus @default(ACTIVE)
  jobTitle            String
  startDate           DateTime                 @db.Date
  endDate             DateTime?                @db.Date
  probationMonths     Int                      @default(0)
  probationEndDate    DateTime?                @db.Date
  probationOutcome    ProbationOutcome?
  probationExtensions Int                      @default(0)
  noticePeriodDays    Int                      @default(30)
  signedDate          DateTime?                @db.Date
  documentReference   String?
  previousContractId  String?
  previousContract    EmploymentContract?      @relation("ContractChain", fields: [previousContractId], references: [id])
  renewals            EmploymentContract[]     @relation("ContractChain")
  decisions           ProbationDecision[]
  probationReviews    ProbationReview[]
  terminatedAt        DateTime?                @db.Date
  terminationReason   String?
  notes               String?
  createdBy           String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([organizationId, contractNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, status, endDate])
}

// ──────────────────────── HR LIFECYCLE: RECRUITMENT ────────────────────────

model JobRequisition {
  id                   String            @id @default(cuid())
  organizationId       String
  organization         Organization      @relation(fields: [organizationId], references: [id])
  requisitionNumber    String
  title                String
  departmentId         String?
  department           Department?       @relation(fields: [departmentId], references: [id])
  categoryId           String
  category             EmployeeCategory  @relation(fields: [categoryId], references: [id])
  costCenterId         String?
  costCenter           CostCenter?       @relation(fields: [costCenterId], references: [id])
  /// Free reference to the beat/location being staffed — validated in the service.
  beatId               String?
  hiringManagerId      String?
  hiringManager        Employee?         @relation("RequisitionManager", fields: [hiringManagerId], references: [id])
  headcount            Int               @default(1)
  employmentType       EmploymentType    @default(PERMANENT)
  budgetedMonthlyGross Decimal?          @db.Decimal(14, 2)
  justification        String
  targetStartDate      DateTime?         @db.Date
  status               RequisitionStatus @default(PENDING_APPROVAL)
  requestedBy          String
  requestedById        String
  approvedBy           String?
  approvedAt           DateTime?
  decisionNote         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  candidates Candidate[]

  @@unique([organizationId, requisitionNumber])
  @@index([organizationId, status])
}

model Candidate {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  candidateNumber      String
  requisitionId        String
  requisition          JobRequisition  @relation(fields: [requisitionId], references: [id])
  firstName            String
  lastName             String
  phone                String?
  email                String?
  source               CandidateSource @default(OTHER)
  stage                CandidateStage  @default(APPLIED)
  expectedMonthlyGross Decimal?        @db.Decimal(14, 2)
  resumeReference      String?
  notes                String?
  rejectionReason      String?
  stageChangedAt       DateTime        @default(now())
  /// Set once the candidate is converted into an employee.
  employeeId           String?         @unique
  employee             Employee?       @relation("CandidateEmployee", fields: [employeeId], references: [id])
  /// Set when the candidate's personal details were removed under the retention rule.
  anonymizedAt         DateTime?
  createdBy            String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  interviews Interview[]
  checks     CandidateCheck[]
  offers     JobOffer[]

  @@unique([organizationId, candidateNumber])
  @@index([organizationId, requisitionId, stage])
}

model Interview {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate                @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  round          Int                      @default(1)
  scheduledAt    DateTime
  mode           String?
  interviewer    String
  /// 1–5 scorecard rating, set when feedback is recorded.
  score          Int?
  recommendation InterviewRecommendation?
  feedback       String?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime                 @default(now())

  @@index([organizationId, candidateId])
}

/// Pre-employment vetting step (references, ID, police clearance, guarantor, medical…). A candidate
/// can't be hired while any check is still PENDING or FAILED.
model CandidateCheck {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  candidateId    String
  candidate      Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checkType      CandidateCheckType
  status         CheckStatus        @default(PENDING)
  notes          String?
  checkedBy      String?
  checkedAt      DateTime?
  createdAt      DateTime           @default(now())

  @@unique([candidateId, checkType])
  @@index([organizationId, candidateId])
}

model JobOffer {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  offerNumber      String
  candidateId      String
  candidate        Candidate      @relation(fields: [candidateId], references: [id])
  jobTitle         String
  monthlyGross     Decimal        @db.Decimal(14, 2)
  employmentType   EmploymentType @default(PERMANENT)
  probationMonths  Int            @default(0)
  noticePeriodDays Int            @default(30)
  startDate        DateTime       @db.Date
  validUntil       DateTime       @db.Date
  /// Create an effective-dated personal pay rate on hire (office staff). Guards are normally paid
  /// from the client contract's agreed rates, so this is switched off for them.
  setPayRate       Boolean        @default(true)
  status           OfferStatus    @default(PENDING_APPROVAL)
  createdBy        String
  createdById      String
  approvedBy       String?
  approvedAt       DateTime?
  sentAt           DateTime?
  respondedAt      DateTime?
  declineReason    String?
  decisionNote     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([organizationId, offerNumber])
  @@index([organizationId, candidateId])
  @@index([organizationId, status])
}

// ─────────────────────── HR LIFECYCLE: EMPLOYEE RELATIONS ───────────────────────

model RelationsCase {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  caseNumber     String
  /// The employee the case is about (the complainant for a grievance, the subject for misconduct).
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  type           RelationsCaseType
  severity       CaseSeverity      @default(MEDIUM)
  status         CaseStatus        @default(OPEN)
  /// Confidential cases show only their existence (not content) to read-only HR viewers.
  confidential   Boolean           @default(false)
  /// For a welfare case only: the kind of support asked for.
  welfareKind    WelfareKind?
  summary        String
  description    String
  raisedBy       String
  raisedByUserId String
  selfRaised     Boolean           @default(false)
  assignedTo     String?
  openedAt       DateTime          @default(now())
  dueDate        DateTime?         @db.Date
  outcome        CaseOutcome?
  resolution     String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  closedBy       String?
  /// Who resolved it (the person who resolves does not also close it: governance step 2b). Null on a case resolved before this rule: it does not apply to it.
  resolvedByUserId String?
  /// The closer was also the resolver, being the only holder of the right needed (flagged, with the reason kept).
  closedSingleHolder Boolean @default(false)
  closedSingleReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  notes               RelationsCaseNote[]
  disciplinaryRecords DisciplinaryRecord[]

  @@unique([organizationId, caseNumber])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

/// Append-only case file entries — never edited or deleted, so the investigation record is intact.
model RelationsCaseNote {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  caseId         String
  relationsCase  RelationsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind           CaseNoteKind  @default(NOTE)
  note           String
  authorName     String
  authorUserId   String
  createdAt      DateTime      @default(now())

  @@index([organizationId, caseId])
}

// ─────────────────────── END-OF-SERVICE SETTLEMENT ───────────────────────

/// What an exiting employee is owed (or owes) beyond their final month's pay. Computed from the
/// HrPolicy, reviewed and approved (preparer ≠ approver), then RELEASED into a payroll period as
/// approved OtherEarning / Deduction rows — so PAYE, pension, payslips, payment batches and GL
/// posting all happen in the normal payroll run (or a supplementary run for a locked period).
model ExitSettlement {
  id                  String           @id @default(cuid())
  organizationId      String
  organization        Organization     @relation(fields: [organizationId], references: [id])
  settlementNumber    String
  exitRecordId        String           @unique
  exitRecord          ExitRecord       @relation(fields: [exitRecordId], references: [id])
  employeeId          String
  employee            Employee         @relation(fields: [employeeId], references: [id])
  status              SettlementStatus @default(DRAFT)
  /// Reference monthly pay the formulas used (snapshot) and how it was found.
  monthlyGross        Decimal          @db.Decimal(14, 2)
  monthlyBasic        Decimal          @db.Decimal(14, 2)
  dailyRate           Decimal          @db.Decimal(14, 2)
  payBasisSource      String
  serviceDays         Int
  serviceYears        Decimal          @db.Decimal(6, 2)
  leaveAccruedDays    Decimal          @default(0) @db.Decimal(6, 2)
  leaveTakenDays      Decimal          @default(0) @db.Decimal(6, 2)
  leavePayableDays    Decimal          @default(0) @db.Decimal(6, 2)
  noticeRequiredDays  Int              @default(0)
  noticeServedDays    Int              @default(0)
  noticeShortfallDays Int              @default(0)
  grossEarnings       Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions     Decimal          @default(0) @db.Decimal(14, 2)
  netSettlement       Decimal          @default(0) @db.Decimal(14, 2)
  payrollPeriodId     String?
  payrollPeriod       PayrollPeriod?   @relation(fields: [payrollPeriodId], references: [id])
  preparedBy          String
  preparedById        String
  computedAt          DateTime         @default(now())
  submittedAt         DateTime?
  approvedBy          String?
  approvedAt          DateTime?
  releasedBy          String?
  releasedAt          DateTime?
  remarks             String?
  calcTrace           Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  lines ExitSettlementLine[]

  @@unique([organizationId, settlementNumber])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

model ExitSettlementLine {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  settlementId   String
  settlement     ExitSettlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  kind           SettlementLineKind
  /// LEAVE_ENCASHMENT, GRATUITY, SEVERANCE, NOTICE_PAY, NOTICE_RECOVERY, or a manual code.
  code           String
  description    String
  quantity       Decimal?           @db.Decimal(8, 2)
  rate           Decimal?           @db.Decimal(14, 2)
  amount         Decimal            @db.Decimal(14, 2)
  taxable        Boolean            @default(true)
  /// Manual lines (loan recovery, unreturned property, ex-gratia…) survive a recompute.
  manual         Boolean            @default(false)
  /// Traceability once released: the payroll input rows this line became.
  otherEarningId String?
  deductionId    String?
  /// Set when the line recovers the balance of a staff loan.
  loanId         String?
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())

  @@index([organizationId, settlementId])
}

// ─────────────────────────────── CLIENTS ───────────────────────────────

model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  contactPerson  String?
  address        String?
  phone          String?
  email          String?
  status         ClientStatus @default(ACTIVE)
  startDate      DateTime?    @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contracts         Contract[]
  beats             Beat[]
  employees         Employee[]
  deployments       Deployment[]
  workRegister      WorkRegister[]
  overtime          Overtime[]
  allocations       PayrollAllocation[]
  movementsFrom     StaffMovement[]          @relation("MoveFromClient")
  movementsTo       StaffMovement[]          @relation("MoveToClient")
  invoices          ClientInvoice[]
  receipts          ClientReceipt[]
  invoiceDeductions ClientInvoiceDeduction[]
  journalLines      JournalLine[]
  receiptRefunds    ClientRefund[]
  notes             ClientNote[]
  taxCertificates   TaxCertificate[]
  salaryStructures  SalaryStructure[]

  @@unique([organizationId, code])
}

model Contract {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id])
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  contractNumber     String
  name               String
  startDate          DateTime         @db.Date
  endDate            DateTime?        @db.Date
  contractValue      Decimal?         @db.Decimal(16, 2)
  billingMethod      BillingMethod    @default(PER_HEAD_MONTHLY)
  status             ContractStatus   @default(ACTIVE)
  operativeSharePct  Decimal          @default(70) @db.Decimal(5, 2) // 70:30 sharing ratio
  businessLine       BusinessLine     @default(GUARDING) // drives which employer add-on costs apply
  defaultStructureId String?
  defaultStructure   SalaryStructure? @relation(fields: [defaultStructureId], references: [id])
  costCenterId       String?
  costCenter         CostCenter?      @relation(fields: [costCenterId], references: [id])
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  rates         ContractRate[]
  beats         Beat[]
  deployments   Deployment[]
  workRegister  WorkRegister[]
  overtime      Overtime[]
  allocations   PayrollAllocation[]
  invoiceLines  ClientInvoiceLine[]
  movementsFrom StaffMovement[]     @relation("MoveFromContract")
  movementsTo   StaffMovement[]     @relation("MoveToContract")
  journalLines  JournalLine[]
  /// Which service this contract is billed as; its billing rule applies unless the contract has an approved override.
  serviceTypeId String?
  serviceType   ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  billingRules  BillingRule[]
  payBases      ContractPayBasis[]

  @@unique([organizationId, contractNumber])
}

/// CLIENT → CONTRACT → EMPLOYEE CATEGORY → SALARY STRUCTURE → AGREED RATE (effective-dated)
model ContractRate {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  contractId        String
  contract          Contract         @relation(fields: [contractId], references: [id])
  categoryId        String
  category          EmployeeCategory @relation(fields: [categoryId], references: [id])
  salaryStructureId String
  salaryStructure   SalaryStructure  @relation(fields: [salaryStructureId], references: [id])
  agreedRate        Decimal          @db.Decimal(14, 2) // amount billed to client per head per month
  operativeSharePct Decimal?         @db.Decimal(5, 2) // overrides contract share when set
  effectiveFrom     DateTime         @db.Date
  effectiveTo       DateTime?        @db.Date
  createdAt         DateTime         @default(now())

  @@index([organizationId, contractId, categoryId])
}

model Beat {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  clientId         String
  client           Client       @relation(fields: [clientId], references: [id])
  contractId       String
  contract         Contract     @relation(fields: [contractId], references: [id])
  code             String
  name             String
  bidReference     String?
  region           String?
  state            String?
  lga              String?
  address          String?
  siteContact      String?
  approvedStrength Int          @default(0)
  status           BeatStatus   @default(UNMAPPED)
  startDate        DateTime?    @db.Date
  endDate          DateTime?    @db.Date
  supervisorId     String?
  supervisor       User?        @relation("BeatSupervisor", fields: [supervisorId], references: [id])
  costCenterId     String?
  costCenter       CostCenter?  @relation(fields: [costCenterId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  currentEmployees        Employee[]               @relation("CurrentBeat")
  deployments             Deployment[]
  workRegister            WorkRegister[]
  overtime                Overtime[]
  allocations             PayrollAllocation[]
  movementsFrom           StaffMovement[]          @relation("MoveFromBeat")
  movementsTo             StaffMovement[]          @relation("MoveToBeat")
  invoiceLines            ClientInvoiceLine[]
  recurringDeductionRules RecurringDeductionRule[]
  journalLines            JournalLine[]

  @@unique([organizationId, code])
  @@index([organizationId, clientId])
}

// ─────────────────────────── SALARY STRUCTURES ───────────────────────────

model SalaryStructure {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id])
  code              String
  name              String
  description       String?
  calculationMethod StructureMethod @default(PERCENTAGE_OF_GROSS)
  isPartial         Boolean         @default(false)
  isDefault         Boolean         @default(false)
  status            StructureStatus @default(DRAFT)
  effectiveFrom     DateTime        @db.Date
  effectiveTo       DateTime?       @db.Date
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  /// The client this structure belongs to (empty: company-wide, usable on any client's contracts, as every structure was before).
  clientId   String?
  client     Client?           @relation(fields: [clientId], references: [id])
  /// The client structure this one sits under, as a role structure (empty: a top-level structure). Two levels only.
  parentId   String?
  parent     SalaryStructure?  @relation("StructureRoles", fields: [parentId], references: [id])
  roles      SalaryStructure[] @relation("StructureRoles")
  /// The employee category (job role) a role structure is for.
  categoryId String?
  category   EmployeeCategory? @relation(fields: [categoryId], references: [id])

  components    SalaryComponent[]
  contractRates ContractRate[]
  contracts     Contract[]

  @@unique([organizationId, code])
  @@index([organizationId, clientId])
  @@index([parentId, categoryId])
}

model SalaryComponent {
  id           String            @id @default(cuid())
  structureId  String
  structure    SalaryStructure   @relation(fields: [structureId], references: [id], onDelete: Cascade)
  code         String
  name         String
  calcType     ComponentCalcType @default(PERCENTAGE)
  percentage   Decimal?          @db.Decimal(7, 4)
  fixedAmount  Decimal?          @db.Decimal(14, 2)
  formula      String?
  taxable      Boolean           @default(true)
  pensionable  Boolean           @default(false)
  employerCost Boolean           @default(false)
  active       Boolean           @default(true)
  sortOrder    Int               @default(0)

  @@unique([structureId, code])
}

/// Employee-specific component override (never overwrites the base structure)
model EmployeeSalaryOverride {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  componentCode  String
  calcType       ComponentCalcType @default(PERCENTAGE)
  percentage     Decimal?          @db.Decimal(7, 4)
  fixedAmount    Decimal?          @db.Decimal(14, 2)
  reason         String
  effectiveFrom  DateTime          @db.Date
  effectiveTo    DateTime?         @db.Date
  approvedBy     String
  status         ApprovalStatus    @default(APPROVED)
  createdAt      DateTime          @default(now())

  @@index([organizationId, employeeId])
}

/// Employee-specific monthly gross (e.g. office staff / supervisors not billed per head), effective-dated
model EmployeePayRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  monthlyGross   Decimal      @db.Decimal(14, 2)
  structureCode  String? // structure used to split gross; default structure when empty
  reason         String
  approvedBy     String
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())

  @@index([organizationId, employeeId])
}

enum PayRateProposalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A proposed personal monthly gross for an employee (HR or payroll proposes; the payroll manager approves, a second person). It is NOT a pay rate: the pay run reads only EmployeePayRate, and
/// approval is what creates one. Many arrive from the bulk import and from adding an employee, and are decided in one queue.
model PayRateProposal {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id])
  employeeId       String
  employee         Employee              @relation(fields: [employeeId], references: [id])
  monthlyGross     Decimal               @db.Decimal(14, 2)
  structureCode    String?
  effectiveFrom    DateTime              @db.Date
  reason           String
  /// Where it came from: MANUAL (the employee's record), NEW_EMPLOYEE (set when the employee was added) or IMPORT (the bulk import).
  source           String                @default("MANUAL")
  status           PayRateProposalStatus @default(PENDING)
  proposedBy       String
  proposedByUserId String
  createdAt        DateTime              @default(now())
  decidedBy        String?
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionNote     String?
  /// The EmployeePayRate that approval made.
  appliedRateId    String?

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

// ─────────────────────────────── OPERATIONS ───────────────────────────────

model Deployment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  contractId     String
  contract       Contract         @relation(fields: [contractId], references: [id])
  beatId         String
  beat           Beat             @relation(fields: [beatId], references: [id])
  categoryId     String
  category       EmployeeCategory @relation(fields: [categoryId], references: [id])
  shift          Shift            @default(FULL)
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         DeploymentStatus @default(ACTIVE)
  movementId     String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, employeeId])
  @@index([organizationId, beatId])
}

model StaffMovement {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  movementType   MovementType
  fromClientId   String?
  fromClient     Client?        @relation("MoveFromClient", fields: [fromClientId], references: [id])
  fromContractId String?
  fromContract   Contract?      @relation("MoveFromContract", fields: [fromContractId], references: [id])
  fromBeatId     String?
  fromBeat       Beat?          @relation("MoveFromBeat", fields: [fromBeatId], references: [id])
  toClientId     String
  toClient       Client         @relation("MoveToClient", fields: [toClientId], references: [id])
  toContractId   String
  toContract     Contract       @relation("MoveToContract", fields: [toContractId], references: [id])
  toBeatId       String
  toBeat         Beat           @relation("MoveToBeat", fields: [toBeatId], references: [id])
  movementDate   DateTime       @db.Date
  effectiveDate  DateTime       @db.Date
  endDate        DateTime?      @db.Date // for temporary/relief movements
  reason         String
  requestedBy    String
  approvedBy     String?
  status         ApprovalStatus @default(PENDING)
  remarks        String?
  createdAt      DateTime       @default(now())

  @@index([organizationId, employeeId])
}

/// Operational source of truth for WHERE an employee worked on each day.
model WorkRegister {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  date             DateTime         @db.Date
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id])
  clientId         String
  client           Client           @relation(fields: [clientId], references: [id])
  contractId       String
  contract         Contract         @relation(fields: [contractId], references: [id])
  beatId           String
  beat             Beat             @relation(fields: [beatId], references: [id])
  categoryId       String
  category         EmployeeCategory @relation(fields: [categoryId], references: [id])
  shift            Shift            @default(FULL)
  attendanceStatus AttendanceStatus
  hoursWorked      Decimal          @default(0) @db.Decimal(5, 2)
  overtimeHours    Decimal          @default(0) @db.Decimal(5, 2)
  supervisor       String?
  remarks          String?
  source           EntrySource      @default(MANUAL)
  locationMismatch Boolean          @default(false)
  mismatchResolved Boolean          @default(false)
  resolutionNote   String?
  recordedBy       String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, employeeId, date])
  @@index([organizationId, date])
  @@index([organizationId, beatId, date])
}

// ─────────────────────────────── PAYROLL ───────────────────────────────

model PayrollPeriod {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  year           Int
  month          Int
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  status         PeriodStatus @default(OPEN)
  approvedBy     String?
  approvedAt     DateTime?
  lockedBy       String?
  lockedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  runs             PayrollRun[]
  overtime         Overtime[]
  deductions       Deduction[]
  otherEarnings    OtherEarning[]
  arrearsOriginal  Arrears[]             @relation("ArrearsOriginal")
  arrearsProcessed Arrears[]             @relation("ArrearsProcessed")
  invoices         ClientInvoice[]
  exitSettlements  ExitSettlement[]
  calendarEntry    PayrollCalendarEntry?
  inputItems       PayrollInputItem[]
  inputIssues      PayrollInputIssue[]
  clientInputs     ClientInputBatch[]

  @@unique([organizationId, year, month])
}

model PayrollRun {
  id                             String        @id @default(cuid())
  organizationId                 String
  organization                   Organization  @relation(fields: [organizationId], references: [id])
  periodId                       String
  period                         PayrollPeriod @relation(fields: [periodId], references: [id])
  runNumber                      Int
  type                           RunType       @default(REGULAR)
  status                         RunStatus     @default(DRAFT)
  description                    String?
  taxRuleVersion                 String?
  pensionRuleVersion             String?
  employeeCount                  Int           @default(0)
  totalGross                     Decimal       @default(0) @db.Decimal(16, 2)
  totalNet                       Decimal       @default(0) @db.Decimal(16, 2)
  totalPaye                      Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployeePension           Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerPension           Decimal       @default(0) @db.Decimal(16, 2)
  totalDeductions                Decimal       @default(0) @db.Decimal(16, 2)
  totalOvertime                  Decimal       @default(0) @db.Decimal(16, 2)
  totalArrears                   Decimal       @default(0) @db.Decimal(16, 2)
  totalClientBilling             Decimal       @default(0) @db.Decimal(16, 2)
  totalManagementShare           Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerCost              Decimal       @default(0) @db.Decimal(16, 2)
  // Guarding/outsourcing employer add-on costs (see PayrollGlMapping / EmployerCostRule) — zero for
  // back-office (pay-rate, no contract) staff.
  totalItf                       Decimal       @default(0) @db.Decimal(16, 2)
  totalNsitf                     Decimal       @default(0) @db.Decimal(16, 2)
  totalNhfMedical                Decimal       @default(0) @db.Decimal(16, 2)
  totalInsurance                 Decimal       @default(0) @db.Decimal(16, 2)
  totalUniformKits               Decimal       @default(0) @db.Decimal(16, 2)
  totalRecruitmentTraining       Decimal       @default(0) @db.Decimal(16, 2)
  totalLeaveReliever             Decimal       @default(0) @db.Decimal(16, 2)
  totalOutsourcingLeaveAllowance Decimal       @default(0) @db.Decimal(16, 2)
  totalEmployerAddOns            Decimal       @default(0) @db.Decimal(16, 2)
  calculatedBy                   String?
  calculatedAt                   DateTime?
  calculationCount               Int           @default(0)
  /// Everyone who has calculated this payroll. None of them, nor whoever submitted it, may approve it.
  preparedByUserIds              String[]      @default([])
  submittedBy                    String?
  submittedByUserId              String?
  submittedAt                    DateTime?
  approvedBy                     String?
  approvedByUserId               String?
  approvedAt                     DateTime?
  /// Sign-off that this payroll has been reconciled to the previous one. Cleared when the payroll is recalculated.
  reconciledBy                   String?
  reconciledByUserId             String?
  reconciledAt                   DateTime?
  reconciliationNote             String?
  createdAt                      DateTime      @default(now())
  updatedAt                      DateTime      @updatedAt

  records        PayrollRecord[]
  allocations    PayrollAllocation[]
  issues         PayrollValidationIssue[]
  paymentBatches PaymentBatch[]
  remittances    StatutoryRemittance[]
  journalEntry   JournalEntry?
  invoices       ClientInvoice[]

  @@unique([periodId, runNumber])
}

model PayrollRecord {
  id                              String       @id @default(cuid())
  organizationId                  String
  organization                    Organization @relation(fields: [organizationId], references: [id])
  runId                           String
  run                             PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId                      String
  employee                        Employee     @relation(fields: [employeeId], references: [id])
  employeeNumber                  String
  employeeName                    String
  categoryName                    String
  departmentName                  String?
  bankName                        String?
  accountNumber                   String?
  accountName                     String?
  pensionPin                      String?
  pfa                             String?
  taxId                           String?
  /// Copy of the employee's state of residence when the payroll was calculated, so a locked payroll never changes if the employee moves (like pfa).
  payeState                       String?
  basisDays                       Int
  daysWorked                      Decimal      @db.Decimal(6, 2)
  daysAbsent                      Int          @default(0)
  suspensionDays                  Int          @default(0)
  overtimeHours                   Decimal      @default(0) @db.Decimal(8, 2)
  monthlyGross                    Decimal      @db.Decimal(14, 2) // full-month contractual operative gross
  earnedGross                     Decimal      @db.Decimal(14, 2) // prorated structure earnings
  overtimeAmount                  Decimal      @default(0) @db.Decimal(14, 2)
  arrearsAmount                   Decimal      @default(0) @db.Decimal(14, 2)
  otherEarnings                   Decimal      @default(0) @db.Decimal(14, 2)
  totalEarnings                   Decimal      @db.Decimal(14, 2)
  pensionBase                     Decimal      @db.Decimal(14, 2)
  employeePension                 Decimal      @db.Decimal(14, 2)
  employerPension                 Decimal      @db.Decimal(14, 2)
  taxableIncome                   Decimal      @db.Decimal(14, 2)
  paye                            Decimal      @db.Decimal(14, 2)
  otherDeductions                 Decimal      @default(0) @db.Decimal(14, 2)
  totalDeductions                 Decimal      @db.Decimal(14, 2)
  netPay                          Decimal      @db.Decimal(14, 2)
  clientBilling                   Decimal      @default(0) @db.Decimal(14, 2)
  managementShare                 Decimal      @default(0) @db.Decimal(14, 2)
  employerCost                    Decimal      @db.Decimal(14, 2)
  // Guarding/outsourcing employer add-on costs — see EmployerCostRule. Zero for back-office staff.
  itfAmount                       Decimal      @default(0) @db.Decimal(14, 2)
  nsitfAmount                     Decimal      @default(0) @db.Decimal(14, 2)
  nhfMedicalAmount                Decimal      @default(0) @db.Decimal(14, 2)
  insuranceAmount                 Decimal      @default(0) @db.Decimal(14, 2)
  uniformKitsAmount               Decimal      @default(0) @db.Decimal(14, 2)
  recruitmentTrainingAmount       Decimal      @default(0) @db.Decimal(14, 2)
  leaveRelieverAmount             Decimal      @default(0) @db.Decimal(14, 2)
  outsourcingLeaveAllowanceAmount Decimal      @default(0) @db.Decimal(14, 2)
  totalEmployerAddOns             Decimal      @default(0) @db.Decimal(14, 2)
  /// GUARDING / OUTSOURCING when every paid segment shares one business line, BACK_OFFICE when the
  /// employee has no contract segments at all (pay-rate only), MIXED otherwise.
  businessLine                    String       @default("BACK_OFFICE")
  taxRuleVersion                  String
  hasOverride                     Boolean      @default(false)
  lines                           Json // [{type, code, name, amount}]
  locations                       Json // [{clientName, beatName, days, from, to}]
  calcTrace                       Json?
  createdAt                       DateTime     @default(now())

  allocations PayrollAllocation[]
  paymentTxns PaymentTransaction[]

  @@unique([runId, employeeId])
  @@index([organizationId, employeeId])
}

/// Split of every payroll record by client / contract / beat — powers client & beat reports.
model PayrollAllocation {
  id                        String        @id @default(cuid())
  organizationId            String
  organization              Organization  @relation(fields: [organizationId], references: [id])
  runId                     String
  run                       PayrollRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  recordId                  String
  record                    PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  employeeId                String
  clientId                  String?
  client                    Client?       @relation(fields: [clientId], references: [id])
  contractId                String?
  contract                  Contract?     @relation(fields: [contractId], references: [id])
  beatId                    String?
  beat                      Beat?         @relation(fields: [beatId], references: [id])
  days                      Decimal       @db.Decimal(6, 2)
  grossAmount               Decimal       @db.Decimal(14, 2)
  overtimeAmount            Decimal       @default(0) @db.Decimal(14, 2)
  employerPension           Decimal       @db.Decimal(14, 2)
  clientBilling             Decimal       @db.Decimal(14, 2)
  managementShare           Decimal       @db.Decimal(14, 2)
  // Individual employer add-on costs attributable to this client/contract/beat (see EmployerCostRule).
  itf                       Decimal       @default(0) @db.Decimal(14, 2)
  nsitf                     Decimal       @default(0) @db.Decimal(14, 2)
  nhfMedical                Decimal       @default(0) @db.Decimal(14, 2)
  insurance                 Decimal       @default(0) @db.Decimal(14, 2)
  uniformKits               Decimal       @default(0) @db.Decimal(14, 2)
  recruitmentTraining       Decimal       @default(0) @db.Decimal(14, 2)
  leaveReliever             Decimal       @default(0) @db.Decimal(14, 2)
  outsourcingLeaveAllowance Decimal       @default(0) @db.Decimal(14, 2)
  /// Sum of the individual costs above — ITF + NSITF + insurance + uniform&kits + recruitment/training
  /// + leave reliever + outsourcing leave allowance (+ NHF/medical if configured).
  businessCosts             Decimal       @default(0) @db.Decimal(14, 2)
  netAmount                 Decimal       @default(0) @db.Decimal(14, 2)

  @@index([organizationId, runId, clientId, beatId])
}

model PayrollValidationIssue {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  runId               String
  run                 PayrollRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId          String?
  employee            Employee?    @relation(fields: [employeeId], references: [id])
  category            String // POPULATION, SALARY, ATTENDANCE, LOCATION, BANK, PENSION, PAYE, OVERTIME, ARREARS, DEDUCTIONS, DUPLICATES
  severity            Severity
  code                String
  message             String
  resolved            Boolean      @default(false)
  overridden          Boolean      @default(false)
  overrideReason      String?
  overriddenBy        String?
  /// Variance findings must be explained in writing before the payroll can be submitted.
  requiresExplanation Boolean      @default(false)
  explanation         String?
  explainedBy         String?
  explainedByUserId   String?
  explainedAt         DateTime?
  createdAt           DateTime     @default(now())

  @@index([organizationId, runId, severity])
}

model Overtime {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee       @relation(fields: [employeeId], references: [id])
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  contractId        String
  contract          Contract       @relation(fields: [contractId], references: [id])
  beatId            String
  beat              Beat           @relation(fields: [beatId], references: [id])
  periodId          String
  period            PayrollPeriod  @relation(fields: [periodId], references: [id])
  date              DateTime       @db.Date
  hours             Decimal        @db.Decimal(6, 2)
  rate              Decimal?       @db.Decimal(12, 2) // hourly rate; computed when empty
  amount            Decimal        @db.Decimal(14, 2)
  approvalReference String?
  approvedBy        String?
  source            EntrySource    @default(CLIENT_SCHEDULE)
  status            ApprovalStatus @default(PENDING)
  createdBy         String
  createdAt         DateTime       @default(now())

  @@index([organizationId, periodId, employeeId])
}

model Arrears {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id])
  originalPeriodId   String
  originalPeriod     PayrollPeriod  @relation("ArrearsOriginal", fields: [originalPeriodId], references: [id])
  arrearsType        ArrearsType
  originalAmount     Decimal        @db.Decimal(14, 2)
  correctedAmount    Decimal        @db.Decimal(14, 2)
  difference         Decimal        @db.Decimal(14, 2)
  grossImpact        Decimal        @db.Decimal(14, 2)
  pensionableImpact  Decimal        @default(0) @db.Decimal(14, 2)
  taxImpact          Decimal        @default(0) @db.Decimal(14, 2)
  pensionImpact      Decimal        @default(0) @db.Decimal(14, 2)
  netImpact          Decimal        @default(0) @db.Decimal(14, 2)
  reason             String
  supportingDocument String?
  requestedBy        String
  approvedBy         String?
  status             ApprovalStatus @default(PENDING)
  processedPeriodId  String?
  processedPeriod    PayrollPeriod? @relation("ArrearsProcessed", fields: [processedPeriodId], references: [id])
  processedRunId     String?
  createdAt          DateTime       @default(now())

  @@index([organizationId, employeeId])
}

model Deduction {
  id                 String         @id @default(cuid())
  organizationId     String
  organization       Organization   @relation(fields: [organizationId], references: [id])
  employeeId         String
  employee           Employee       @relation(fields: [employeeId], references: [id])
  deductionType      DeductionType
  amount             Decimal        @db.Decimal(14, 2)
  periodId           String
  period             PayrollPeriod  @relation(fields: [periodId], references: [id])
  reason             String
  authorityReference String
  supportingDocument String?
  requestedBy        String
  approvedBy         String?
  status             ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now())

  @@index([organizationId, periodId])
}

/// Recurring payroll deductions applied automatically on every REGULAR run — distinct from the
/// one-off, per-instance-approved Deduction model above. Scope determines who it applies to:
/// GLOBAL (every paid employee that period), LOCATION (everyone who worked any day at the given
/// beat that period), INDIVIDUAL (one named employee). Never applied on supplementary runs, to
/// avoid double-charging within the same period.
model RecurringDeductionRule {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id])
  name           String
  /// Short code — becomes the payslip line / GL head code (e.g. "DEV_LEVY").
  code           String
  scope          DeductionScope
  beatId         String?
  beat           Beat?                      @relation(fields: [beatId], references: [id])
  employeeId     String?
  employee       Employee?                  @relation(fields: [employeeId], references: [id])
  calcType       RecurringDeductionCalcType
  /// % of the employee's total earnings for the period, when calcType = PERCENTAGE_OF_GROSS.
  percentage     Decimal?                   @db.Decimal(6, 3)
  fixedAmount    Decimal?                   @db.Decimal(14, 2)
  active         Boolean                    @default(true)
  effectiveFrom  DateTime                   @db.Date
  effectiveTo    DateTime?                  @db.Date
  reason         String
  createdBy      String
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, scope])
  @@index([organizationId, beatId])
  @@index([organizationId, employeeId])
}

model OtherEarning {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id])
  periodId       String
  period         PayrollPeriod  @relation(fields: [periodId], references: [id])
  name           String
  amount         Decimal        @db.Decimal(14, 2)
  taxable        Boolean        @default(true)
  reason         String
  approvedBy     String?
  status         ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
}

// ─────────────────────────── STATUTORY RULES ───────────────────────────

model TaxRule {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  code              String
  name              String
  version           String
  legalBasis        String?
  effectiveFrom     DateTime     @db.Date
  effectiveTo       DateTime?    @db.Date
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now())
  /// PAYE filing dates and the late penalty are RULE DATA, set from the tax adviser's verified values and never assumed. Blank = not set.
  /// Day of the month after the pay month on which PAYE is due (1 to 28).
  payeDueDay        Int?
  /// The annual return is due on this month and day of the year after the tax year.
  annualReturnMonth Int?
  annualReturnDay   Int?
  /// Percentage of unremitted PAYE charged when late (interest is not modelled).
  latePenaltyPct    Decimal?     @db.Decimal(6, 3)

  bands      TaxBand[]
  reliefs    TaxRelief[]
  exemptions TaxExemption[]

  @@unique([organizationId, code, version])
}

model TaxBand {
  id         String   @id @default(cuid())
  taxRuleId  String
  taxRule    TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  sortOrder  Int
  lowerBound Decimal  @db.Decimal(16, 2)
  upperBound Decimal? @db.Decimal(16, 2)
  rate       Decimal  @db.Decimal(6, 3)
}

model TaxRelief {
  id        String     @id @default(cuid())
  taxRuleId String
  taxRule   TaxRule    @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      ReliefType
  rate      Decimal?   @db.Decimal(7, 4)
  amount    Decimal?   @db.Decimal(16, 2)
  cap       Decimal?   @db.Decimal(16, 2)
  active    Boolean    @default(true)
}

model TaxExemption {
  id                 String  @id @default(cuid())
  taxRuleId          String
  taxRule            TaxRule @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  code               String
  description        String
  annualGrossCeiling Decimal @db.Decimal(16, 2) // gross at or below this is exempt
  active             Boolean @default(true)
}

model PensionRule {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  version          String
  employeeRate     Decimal      @db.Decimal(6, 3)
  employerRate     Decimal      @db.Decimal(6, 3)
  pensionableCodes String[]
  effectiveFrom    DateTime     @db.Date
  effectiveTo      DateTime?    @db.Date
  createdAt        DateTime     @default(now())
}

model PayrollRule {
  id                       String         @id @default(cuid())
  organizationId           String
  organization             Organization   @relation(fields: [organizationId], references: [id])
  version                  String
  prorationBasis           ProrationBasis @default(CALENDAR_DAYS)
  defaultOperativeSharePct Decimal        @default(70) @db.Decimal(5, 2)
  standardHoursPerDay      Decimal        @default(12) @db.Decimal(5, 2)
  overtimeMultiplier       Decimal        @default(1.5) @db.Decimal(5, 2)
  maxOvertimeHoursPerMonth Decimal        @default(60) @db.Decimal(6, 2)
  maxDeductionPctOfGross   Decimal        @default(33.33) @db.Decimal(5, 2)
  /// Overhead allocation used in Contract Profitability — % of contract revenue charged as back-office cost.
  backOfficeChargePct      Decimal        @default(15) @db.Decimal(5, 2)
  /// A worker with PAYE and no state of residence is a warning (false, the default) or a CRITICAL finding that blocks approval until fixed or overridden with a reason (true).
  requirePayeState         Boolean        @default(false)
  /// The rate of the VOLUNTARY NHF (National Housing Fund) contribution, as a % of BASIC pay: 2.5 by the founder's rule (the tax adviser confirms it). It is taken only from employees who have chosen to contribute (Employee.nhfContributes), as its own deduction line, and is allowed against PAYE at the amount taken. 0 = none.
  nhfEmployeeRatePct       Decimal        @default(2.5) @db.Decimal(5, 3)
  /// The take-home floor, % of gross: loan and salary-advance recoveries may not take net pay below this share of gross; the part not taken is carried forward by the loan book. 0 (the default) = no floor, as pay has always been worked. A client-specific policy, not a statutory one.
  minTakeHomePctOfGross    Decimal        @default(0) @db.Decimal(5, 2)
  effectiveFrom            DateTime       @db.Date
  effectiveTo              DateTime?      @db.Date
  createdAt                DateTime       @default(now())
}

/// Employer add-on costs beyond employer pension, specific to guarding / outsourcing contracts.
/// ITF and NSITF-ECA are % of gross salary; the rest are % of (management fee less pension employer,
/// ITF, NSITF and NHF/medical if configured). Uniform & Kits applies to GUARDING only; Outsourcing
/// Leave Allowance (% of Basic) applies to OUTSOURCING only. Back-office (no-contract) pay is unaffected.
model EmployerCostRule {
  id                           String       @id @default(cuid())
  organizationId               String
  organization                 Organization @relation(fields: [organizationId], references: [id])
  version                      String
  itfPct                       Decimal      @default(1) @db.Decimal(5, 2)
  nsitfPct                     Decimal      @default(1) @db.Decimal(5, 2)
  nhfMedicalPct                Decimal      @default(0) @db.Decimal(5, 2) // 0 = not provided
  insurancePct                 Decimal      @default(7.5) @db.Decimal(5, 2)
  uniformKitsPct               Decimal      @default(25) @db.Decimal(5, 2) // GUARDING only
  recruitmentTrainingPct       Decimal      @default(10.5) @db.Decimal(5, 2)
  leaveRelieverPct             Decimal      @default(22) @db.Decimal(5, 2)
  outsourcingLeaveAllowancePct Decimal      @default(20) @db.Decimal(5, 2) // OUTSOURCING only, % of Basic
  effectiveFrom                DateTime     @db.Date
  effectiveTo                  DateTime?    @db.Date
  createdAt                    DateTime     @default(now())
}

// ─────────────────────────────── PAYMENTS ───────────────────────────────

model PaymentBatch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun    @relation(fields: [runId], references: [id])
  batchNumber    String
  bankName       String
  totalAmount    Decimal       @db.Decimal(16, 2)
  count          Int
  status         PaymentStatus @default(PENDING)
  createdBy      String
  createdAt      DateTime      @default(now())

  transactions PaymentTransaction[]

  @@unique([organizationId, batchNumber])
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  batchId        String
  batch          PaymentBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recordId       String
  record         PayrollRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  bankName       String?
  accountNumber  String?
  accountName    String?
  /// The paying bank this payment is made from, fixed when the batches are made. Empty = the default paying bank.
  payingBankId   String?
  payingBank     PayingBank?   @relation(fields: [payingBankId], references: [id])
  status         PaymentStatus @default(PENDING)
  bankReference  String?
  reconciled     Boolean       @default(false)
  reconciledAt   DateTime?
}

model StatutoryRemittance {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  runId          String
  run            PayrollRun     @relation(fields: [runId], references: [id])
  type           RemittanceType
  payee          String // PFA name or tax authority
  employeeAmount Decimal        @db.Decimal(16, 2)
  employerAmount Decimal        @db.Decimal(16, 2)
  totalAmount    Decimal        @db.Decimal(16, 2)
  headcount      Int
  status         PaymentStatus  @default(PENDING)
  reference      String?
  createdAt      DateTime       @default(now())
}

// ───────────────────────── CLIENT BILLING / INVOICING ─────────────────────────

/// One invoice per client per payroll run, generated from that run's client billing
/// (payrollByClientAndBeat) — the accounts-receivable side of payroll, never edited once issued.
model ClientInvoice {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  runId               String
  run                 PayrollRun    @relation(fields: [runId], references: [id])
  periodId            String
  period              PayrollPeriod @relation(fields: [periodId], references: [id])
  invoiceNumber       String
  invoiceDate         DateTime      @db.Date
  dueDate             DateTime      @db.Date
  subtotal            Decimal       @db.Decimal(16, 2)
  /// Each line's charge-out amount is split direct/indirect (defaults 90%/10%) — see ClientInvoiceLine.
  /// VAT is charged on the indirect-charge total only, not on the full subtotal.
  directChargePct     Decimal       @default(90) @db.Decimal(5, 2)
  indirectChargePct   Decimal       @default(10) @db.Decimal(5, 2)
  totalDirectCharge   Decimal       @default(0) @db.Decimal(16, 2)
  totalIndirectCharge Decimal       @default(0) @db.Decimal(16, 2)
  vatPct              Decimal       @default(0) @db.Decimal(5, 2)
  vatAmount           Decimal       @default(0) @db.Decimal(16, 2)
  /// Informational only — the client is expected to withhold this on payment and remit it to the
  /// tax authority on the vendor's behalf. Does not change totalAmount; the actual amount the client
  /// withholds is recorded as a ClientInvoiceDeduction (type WITHHOLDING_TAX) against the WHT credit
  /// note when they pay, so it stays justified and evidenced like any other deduction.
  whtPct              Decimal       @default(0) @db.Decimal(5, 2)
  whtAmount           Decimal       @default(0) @db.Decimal(16, 2)
  totalAmount         Decimal       @db.Decimal(16, 2)
  amountPaid          Decimal       @default(0) @db.Decimal(16, 2)
  /// Sum of ClientInvoiceDeduction — WHT actually withheld, or any other justified/evidenced
  /// deduction (e.g. leave allowance credit) a client applies instead of paying in full.
  totalDeductions     Decimal       @default(0) @db.Decimal(16, 2)
  status              InvoiceStatus @default(ISSUED)
  notes               String?
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lines              ClientInvoiceLine[]
  receipts           ClientReceipt[]
  deductions         ClientInvoiceDeduction[]
  receiptAllocations ReceiptAllocation[]
  /// Credit notes approved against this invoice reduce what is owed on it; debit notes increase it. The invoice itself is never changed.
  totalCredits       Decimal                  @default(0) @db.Decimal(16, 2)
  totalDebits        Decimal                  @default(0) @db.Decimal(16, 2)
  adjustmentNotes    ClientNote[]
  /// Who generated the draft (never the person who approves it), who submitted it, who approved and posted it, and when it was sent.
  generatedByUserId  String?
  submittedBy        String?
  submittedByUserId  String?
  submittedAt        DateTime?
  approvedBy         String?
  approvedByUserId   String?
  approvedAt         DateTime?
  /// Why an approver sent a draft back.
  rejectionNote      String?
  sentAt             DateTime?
  sentBy             String?
  sentVia            String?
  /// The billing rule, tax codes and rates each contract on this invoice was calculated with, and where each came from.
  taxBasis           Json?
  taxTransactions    TaxTransaction[]

  @@unique([organizationId, invoiceNumber])
  @@unique([clientId, runId])
  @@index([organizationId, clientId])
  @@index([organizationId, status])
}

/// One line per category (Guard, Supervisor, …) billed on the invoice — quantity × rate = amount.
/// Prefixed with the contract name when a client has more than one contract on the same invoice.
model ClientInvoiceLine {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id])
  /// The billing rule this line's split and taxes were calculated under (null: the built-in default).
  billingRuleId  String?
  billingRule    BillingRule?  @relation(fields: [billingRuleId], references: [id], onDelete: Restrict)
  categoryName   String?
  description    String
  headcount      Int
  rate           Decimal       @default(0) @db.Decimal(14, 2)
  /// Legacy: paid-day count for a beat-based line generated before category-based invoicing. Unused
  /// (and not populated) for lines generated after; kept nullable for older invoices.
  days           Decimal?      @db.Decimal(6, 2)
  beatId         String?
  beat           Beat?         @relation(fields: [beatId], references: [id])
  amount         Decimal       @db.Decimal(14, 2)
  /// amount split direct/indirect at the invoice's directChargePct/indirectChargePct — direct +
  /// indirect always sums to amount. VAT is charged on the sum of indirectCharge across all lines.
  directCharge   Decimal       @default(0) @db.Decimal(14, 2)
  indirectCharge Decimal       @default(0) @db.Decimal(14, 2)
  sortOrder      Int           @default(0)
}

enum InvoiceDeductionType {
  WITHHOLDING_TAX
  LEAVE_ALLOWANCE
  OTHER
}

/// A justified, evidenced deduction a client applies instead of paying an invoice in full —
/// withholding tax, a leave-allowance credit, or any other agreed deduction. Never deleted.
model ClientInvoiceDeduction {
  id                 String               @id @default(cuid())
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  invoiceId          String
  invoice            ClientInvoice        @relation(fields: [invoiceId], references: [id])
  clientId           String
  client             Client               @relation(fields: [clientId], references: [id])
  type               InvoiceDeductionType
  amount             Decimal              @db.Decimal(16, 2)
  reason             String // justification — required
  supportingDocument String // proof (reference / filename / description) — required
  recordedBy         String
  createdAt          DateTime             @default(now())

  @@index([organizationId, invoiceId])
  @@index([organizationId, clientId])
}

/// A payment received from a client against an invoice. Never deleted — cancel/reverse with a
/// documented reason instead if one is recorded in error.
model ClientReceipt {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  /// The one invoice a single-invoice receipt settles. Null for a client receipt that is allocated across invoices (or
  /// held as an advance): its settlements are the allocations.
  invoiceId      String?
  invoice        ClientInvoice?      @relation(fields: [invoiceId], references: [id])
  /// RCT-nnnnnn for a client receipt; null for the older single-invoice receipts.
  receiptNumber  String?
  /// Tax the client withheld on paying (a credit with the tax authority): not cash, but settles invoices. Must all be allocated.
  whtWithheld    Decimal             @default(0) @db.Decimal(16, 2)
  whtReference   String?
  notes          String?
  allocations    ReceiptAllocation[]
  refunds        ClientRefund[]
  clientId       String
  client         Client              @relation(fields: [clientId], references: [id])
  amount         Decimal             @db.Decimal(16, 2)
  receivedDate   DateTime            @db.Date
  method         String?
  reference      String?
  recordedBy     String
  createdAt      DateTime            @default(now())

  matchedByLines BankStatementLine[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, invoiceId])
  @@index([organizationId, clientId])
}

// ───────────────────────── ACCOUNTS PAYABLE ─────────────────────────
// Mirrors the client billing (accounts-receivable) models above, but for money going OUT —
// uniform/kit suppliers, equipment vendors, utilities, professional services, etc.

model Vendor {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  name           String
  category       VendorCategory @default(OTHER)
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  taxId          String?
  bankName       String?
  accountNumber  String?
  accountName    String?
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoices   PurchaseInvoice[]
  payments   VendorPayment[]
  deductions PurchaseInvoiceDeduction[]
  orders     PurchaseOrder[]
  receipts   GoodsReceipt[]

  @@unique([organizationId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

/// A purchase order raised before a vendor bill exists — request, approve, then convert to a
/// PurchaseInvoice once the bill actually arrives. Lines are fixed once submitted for approval;
/// corrections mean cancelling and raising a new order.
model PurchaseOrder {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  orderNumber       String
  vendorId          String
  vendor            Vendor              @relation(fields: [vendorId], references: [id])
  costCenterId      String?
  costCenter        CostCenter?         @relation(fields: [costCenterId], references: [id])
  description       String
  subtotal          Decimal             @db.Decimal(16, 2)
  vatPct            Decimal             @default(0) @db.Decimal(5, 2)
  vatAmount         Decimal             @default(0) @db.Decimal(16, 2)
  totalAmount       Decimal             @db.Decimal(16, 2)
  status            PurchaseOrderStatus @default(DRAFT)
  requestedBy       String
  requestedByUserId String?
  requestedAt       DateTime            @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionReason    String?
  notes             String?
  updatedAt         DateTime            @updatedAt

  lines            PurchaseOrderLine[]
  convertedInvoice PurchaseInvoice?
  receipts         GoodsReceipt[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  rate        Decimal       @db.Decimal(14, 2)
  amount      Decimal       @db.Decimal(14, 2)
  sortOrder   Int           @default(0)

  receiptLines GoodsReceiptLine[]
  billLines    PurchaseInvoiceLine[]
}

/// Goods or services received against an approved purchase order. A receipt is a record of fact: it is never edited, only cancelled
/// (with a reason) if it was recorded in error. The bill is matched against what was ordered and what was actually received.
model GoodsReceipt {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id])
  receiptNumber    String
  orderId          String
  order            PurchaseOrder      @relation(fields: [orderId], references: [id])
  vendorId         String
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  receivedDate     DateTime           @db.Date
  deliveryNote     String?
  notes            String?
  status           GoodsReceiptStatus @default(POSTED)
  receivedBy       String
  receivedByUserId String
  createdAt        DateTime           @default(now())
  cancelledAt      DateTime?
  cancelledBy      String?
  cancelReason     String?

  lines GoodsReceiptLine[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, orderId])
}

model GoodsReceiptLine {
  id          String            @id @default(cuid())
  receiptId   String
  receipt     GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  orderLineId String
  orderLine   PurchaseOrderLine @relation(fields: [orderLineId], references: [id])
  quantity    Decimal           @db.Decimal(10, 2)

  @@index([orderLineId])
}

/// A vendor bill. Never edited once recorded — corrections go through a deduction or a new invoice.
model PurchaseInvoice {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id])
  vendorId              String
  vendor                Vendor                @relation(fields: [vendorId], references: [id])
  invoiceNumber         String // our internal sequence number
  vendorRef             String? // the vendor's own invoice/bill number
  costCenterId          String?
  costCenter            CostCenter?           @relation(fields: [costCenterId], references: [id])
  purchaseOrderId       String?               @unique
  purchaseOrder         PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate           DateTime              @db.Date
  dueDate               DateTime              @db.Date
  description           String
  subtotal              Decimal               @db.Decimal(16, 2)
  vatPct                Decimal               @default(0) @db.Decimal(5, 2)
  vatAmount             Decimal               @default(0) @db.Decimal(16, 2)
  totalAmount           Decimal               @db.Decimal(16, 2)
  amountPaid            Decimal               @default(0) @db.Decimal(16, 2)
  /// Sum of PurchaseInvoiceDeduction — WHT we withheld from the vendor, or any other justified,
  /// evidenced deduction (short-payment, damaged-goods credit, etc.).
  totalDeductions       Decimal               @default(0) @db.Decimal(16, 2)
  status                PurchaseInvoiceStatus @default(RECORDED)
  notes                 String?
  createdBy             String
  createdByUserId       String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  /// Three-way match result. EXCEPTION blocks payment until a second person approves (then APPROVED) or the exceptions clear.
  matchStatus           BillMatchStatus       @default(NOT_REQUIRED)
  matchExceptions       Json?
  matchApprovedBy       String?
  matchApprovedByUserId String?
  matchApprovedAt       DateTime?
  matchApprovalReason   String?

  lines      PurchaseInvoiceLine[]
  payments   VendorPayment[]
  deductions PurchaseInvoiceDeduction[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
}

model PurchaseInvoiceLine {
  id          String             @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal            @default(1) @db.Decimal(10, 2)
  rate        Decimal            @db.Decimal(14, 2)
  amount      Decimal            @db.Decimal(14, 2)
  sortOrder   Int                @default(0)
  /// The purchase order line this bill line is for, when the bill is against an order.
  orderLineId String?
  orderLine   PurchaseOrderLine? @relation(fields: [orderLineId], references: [id])
}

/// A justified, evidenced deduction WE apply instead of paying a vendor bill in full — withholding
/// tax we're required to remit on the vendor's behalf, or any other agreed short-payment. Never
/// deleted.
model PurchaseInvoiceDeduction {
  id                 String                       @id @default(cuid())
  organizationId     String
  organization       Organization                 @relation(fields: [organizationId], references: [id])
  invoiceId          String
  invoice            PurchaseInvoice              @relation(fields: [invoiceId], references: [id])
  vendorId           String
  vendor             Vendor                       @relation(fields: [vendorId], references: [id])
  type               PurchaseInvoiceDeductionType
  amount             Decimal                      @db.Decimal(16, 2)
  reason             String
  supportingDocument String
  recordedBy         String
  createdAt          DateTime                     @default(now())

  @@index([organizationId, invoiceId])
  @@index([organizationId, vendorId])
}

/// A payment made to a vendor against a bill. Never deleted — cancel/reverse with a documented
/// reason instead if one is recorded in error.
model VendorPayment {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  invoiceId      String
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  amount         Decimal         @db.Decimal(16, 2)
  paidDate       DateTime        @db.Date
  method         String?
  reference      String?
  recordedBy     String
  createdAt      DateTime        @default(now())

  matchedByLines BankStatementLine[]

  @@index([organizationId, invoiceId])
  @@index([organizationId, vendorId])
}

// ─────────────────────────────── FIXED ASSET REGISTER ───────────────────────────────

enum FixedAssetCategory {
  VEHICLE
  RADIO_COMMS
  CCTV_SECURITY
  FIREARM
  OFFICE_EQUIPMENT
  IT_EQUIPMENT
  FURNITURE
  OTHER
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

/// Company-owned capital assets — vehicles, radios, CCTV, firearms, office/IT equipment. Straight-line
/// depreciation is computed on the fly (see fixed-assets.ts), never stored, so there's nothing to
/// re-run when a rate or date changes. Auto-numbered `FA-######`, never deleted — dispose it instead.
model FixedAsset {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  assetNumber          String
  name                 String
  category             FixedAssetCategory
  costCenterId         String?
  costCenter           CostCenter?        @relation(fields: [costCenterId], references: [id])
  serialNumber         String?
  locationDescription  String?
  assignedToEmployeeId String?
  assignedToEmployee   Employee?          @relation(fields: [assignedToEmployeeId], references: [id])
  acquisitionDate      DateTime           @db.Date
  cost                 Decimal            @db.Decimal(16, 2)
  usefulLifeMonths     Int
  salvageValue         Decimal            @default(0) @db.Decimal(16, 2)
  status               FixedAssetStatus   @default(ACTIVE)
  disposalDate         DateTime?          @db.Date
  disposalProceeds     Decimal?           @db.Decimal(16, 2)
  disposalReason       String?
  notes                String?
  createdBy            String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  journalLines         JournalLine[]

  @@unique([organizationId, assetNumber])
  @@index([organizationId, category])
  @@index([organizationId, status])
}

// ───────────────────────── BANK RECONCILIATION (OPERATING ACCOUNT) ─────────────────────────
// Reconciles the organization's own bank account(s) against everything that moves through them —
// client receipts in, vendor payments out. Distinct from PaymentTransaction.reconciled above, which
// only matches payroll disbursements. Scoped to a single primary operating account for now: receipts
// and payments carry no bankAccountId, so a statement line can be matched to any org-wide, unmatched
// receipt/payment (a record can only ever be claimed by one line).

model BankAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  bankName       String
  accountNumber  String
  glAccountId    String?
  glAccount      GlAccount?   @relation(fields: [glAccountId], references: [id])
  openingBalance Decimal      @default(0) @db.Decimal(16, 2)
  openingDate    DateTime     @db.Date
  active         Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())

  statementLines BankStatementLine[]

  @@unique([organizationId, name])
}

enum BankLineMatchType {
  CLIENT_RECEIPT
  VENDOR_PAYMENT
  MANUAL
}

/// One imported bank statement line. Positive amount = money in, negative = money out. Matched
/// against an existing ClientReceipt/VendorPayment, or marked MANUAL (bank charges, interest,
/// inter-account transfers) with a required note — never silently ignored.
model BankStatementLine {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id])
  bankAccountId          String
  bankAccount            BankAccount        @relation(fields: [bankAccountId], references: [id])
  date                   DateTime           @db.Date
  description            String
  amount                 Decimal            @db.Decimal(16, 2)
  reference              String?
  matchType              BankLineMatchType?
  matchedClientReceiptId String?
  matchedClientReceipt   ClientReceipt?     @relation(fields: [matchedClientReceiptId], references: [id])
  matchedVendorPaymentId String?
  matchedVendorPayment   VendorPayment?     @relation(fields: [matchedVendorPaymentId], references: [id])
  matchNote              String?
  matchedBy              String?
  matchedAt              DateTime?
  createdAt              DateTime           @default(now())

  @@index([organizationId, bankAccountId])
  @@index([organizationId, matchType])
}

// ─────────────────────────────── AUDIT ───────────────────────────────

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  userName       String
  action         String
  entity         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  reason         String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  /// The tamper-evidence seal (see AuditSeal); absent for a few minutes after the row is written.
  seal           AuditSeal?

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}

/// One seal per audit row (rule 5: tamper-evident): SHA-256 of the row's canonical content, chained to the previous seal of the same organization
/// by an HMAC under AUDIT_SEAL_KEY. Append-only at the database. docs/plans/tamper-evident-audit-log.md.
model AuditSeal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// 1, 2, 3 ... per organization; unique, so two sealers at once cannot both succeed.
  seq            Int
  auditLogId     String       @unique
  auditLog       AuditLog     @relation(fields: [auditLogId], references: [id], onDelete: Restrict)
  contentHash    String
  prevHash       String
  chainHash      String
  sealedAt       DateTime     @default(now())
  /// Sealed long after the row was written (the log's history from before sealing began).
  sealedLate     Boolean      @default(false)

  @@unique([organizationId, seq])
  @@index([organizationId, sealedAt])
}

// ─────────────────────────────── LEAVE ───────────────────────────────

/// One policy per organization. Defaults: 10 working days a year, due after 12 months' service.
model LeavePolicy {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  annualDays         Int          @default(10)
  eligibilityMonths  Int          @default(12) // months of service before the first entitlement is due
  workingDaysPerWeek Int          @default(5) // 5 = Mon–Fri, 6 = Mon–Sat, 7 = every day
  /// Whether an employee may ask for UNPAID leave (off until the company switches it on). Unpaid leave days are not paid days and do not use up annual leave.
  unpaidLeaveEnabled Boolean      @default(false)
  updatedAt          DateTime     @updatedAt
}

model LeaveRequest {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  cycleStart     DateTime     @db.Date // the leave year the days are charged to
  cycleEnd       DateTime     @db.Date
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  workingDays    Int
  /// Unpaid leave: its working days are not paid days (the pay run leaves them out) and it does not use up the annual-leave entitlement.
  unpaid         Boolean      @default(false)
  reason         String?
  status         LeaveStatus  @default(PENDING)
  requestedBy    String
  decidedBy      String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

// ─────────────────────────── GENERAL LEDGER ───────────────────────────

model GlAccount {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  type           GlAccountType
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  /// Where the account sits in the hierarchy: class → group → category → account. Null until classified.
  categoryId     String?
  category       AccountCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// A sub-account hangs under a parent account; the parent then becomes a non-posting header.
  parentId       String?
  parent         GlAccount?       @relation("SubAccounts", fields: [parentId], references: [id], onDelete: Restrict)
  children       GlAccount[]      @relation("SubAccounts")
  /// Header accounts group others and can't be posted to.
  postable       Boolean          @default(true)
  description    String?
  /// The account can only be posted to on or after / on or before these dates.
  effectiveFrom  DateTime?        @db.Date
  effectiveTo    DateTime?        @db.Date
  /// Which financial-statement line this account reports under, overriding its category's line.
  statementLine  String?
  /// Which tax return or tax ledger this account feeds (VAT_OUTPUT, WHT_RECEIVABLE, PAYE …).
  taxMapping     String?

  debitMappings      PayrollGlMapping[]     @relation("MappingDebit")
  creditMappings     PayrollGlMapping[]     @relation("MappingCredit")
  lines              JournalLine[]
  bankAccounts       BankAccount[]
  /// Dimensions every posting to this account must carry (CLIENT, CONTRACT, COST_CENTER …). Empty = none required.
  requiredDimensions String[]               @default([])
  documentLines      JournalDocumentLine[]
  recurringLines     RecurringJournalLine[]

  @@unique([organizationId, code])
}

/// Which GL accounts a payroll head (salary component, deduction, employer cost) posts to.
model PayrollGlMapping {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  headCode        String
  headName        String
  headType        GlHeadType
  debitAccountId  String?
  debitAccount    GlAccount?   @relation("MappingDebit", fields: [debitAccountId], references: [id])
  creditAccountId String?
  creditAccount   GlAccount?   @relation("MappingCredit", fields: [creditAccountId], references: [id])

  @@unique([organizationId, headCode])
}

/// One balanced journal per payroll run, posted automatically when the run is locked.
/// One balanced journal entry. `runId` is set only for payroll-sourced entries (PAYROLL_LOCK /
/// PAYROLL_CLOSE / MANUAL_POST) — everything else (AR/AP/depreciation postings) leaves it null.
/// Postgres treats each NULL as distinct, so the unique constraint still guarantees at most one
/// journal per payroll run without blocking any number of non-payroll entries.
model JournalEntry {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  entryNumber    String
  runId          String?           @unique
  run            PayrollRun?       @relation(fields: [runId], references: [id])
  /// The accounting period the posting date falls in. Set when posted; older journals are stamped once by a backfill.
  periodId       String?
  period         AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: Restrict)
  /// The document that produced this journal (CLIENT_INVOICE, CLIENT_RECEIPT, PAYROLL_RUN …) and its id, so a ledger line can be traced back and a document with no journal can be named.
  sourceType     String?
  sourceId       String?
  periodName     String?
  postingDate    DateTime          @db.Date
  description    String
  source         String // PAYROLL_LOCK | PAYROLL_CLOSE | MANUAL_POST | AR_INVOICE | AR_RECEIPT | AR_DEDUCTION | AP_INVOICE | AP_PAYMENT | AP_DEDUCTION | DEPRECIATION
  totalDebit     Decimal           @db.Decimal(16, 2)
  totalCredit    Decimal           @db.Decimal(16, 2)
  postedBy       String
  postedAt       DateTime          @default(now())
  remarks        String?

  lines            JournalLine[]
  /// Set when this journal reverses another: the original, which stays untouched. At most one reversal per journal.
  reversalOfId     String?           @unique
  reversalOf       JournalEntry?     @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy       JournalEntry?     @relation("JournalReversal")
  document         JournalDocument?
  reversalRequests JournalReversal[]
  closedYear       FiscalYear?       @relation("YearEndClosing")

  @@unique([organizationId, entryNumber])
  @@index([organizationId, postingDate])
  @@index([organizationId, source])
  @@index([organizationId, sourceType, sourceId])
  @@index([periodId])
}

model JournalLine {
  id             String        @id @default(cuid())
  journalId      String
  journal        JournalEntry  @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId      String
  account        GlAccount     @relation(fields: [accountId], references: [id])
  accountCode    String
  accountName    String
  headCode       String
  description    String
  debit          Decimal       @default(0) @db.Decimal(16, 2)
  credit         Decimal       @default(0) @db.Decimal(16, 2)
  sortOrder      Int           @default(0)
  /// Accounting dimensions: who and what the posting is for. Set when the line is posted and never changed.
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractId     String?
  contract       Contract?     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  beatId         String?
  beat           Beat?         @relation(fields: [beatId], references: [id], onDelete: Restrict)
  costCenterId   String?
  costCenter     CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: Restrict)
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  employeeId     String?
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  fixedAssetId   String?
  fixedAsset     FixedAsset?   @relation(fields: [fixedAssetId], references: [id], onDelete: Restrict)
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  profitCentreId String?
  profitCentre   ProfitCentre? @relation(fields: [profitCentreId], references: [id], onDelete: Restrict)
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([clientId])
  @@index([contractId])
  @@index([beatId])
  @@index([costCenterId])
  @@index([departmentId])
  @@index([employeeId])
  @@index([fixedAssetId])
  @@index([regionId])
  @@index([branchId])
  @@index([profitCentreId])
  @@index([projectId])
  @@index([journalId])
}

// ─────────────────────── INVENTORY: UNIFORM & KIT STOCK ───────────────────────

enum InventoryCategory {
  UNIFORM
  FOOTWEAR
  ACCESSORY
  EQUIPMENT
  OTHER
}

enum StockMovementType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
  WRITE_OFF
}

/// What state kit comes back in. Only GOOD kit goes back on the shelf.
enum ReturnCondition {
  GOOD
  DAMAGED
  LOST
}

/// A stocked item — one row per size, so "Shirt — L" and "Shirt — XL" count separately.
/// quantityOnHand and averageCost are kept in step with the movement ledger, which is the record
/// of truth: every change to either is a StockMovement.
model InventoryItem {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  sku            String
  name           String
  category       InventoryCategory @default(UNIFORM)
  size           String?
  unit           String            @default("pcs")
  reorderLevel   Int               @default(0)
  quantityOnHand Int               @default(0)
  /// Weighted-average cost per unit, recalculated on every receipt.
  averageCost    Decimal           @default(0) @db.Decimal(14, 2)
  active         Boolean           @default(true)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  movements StockMovement[]
  packLines KitPackLine[]

  @@unique([organizationId, sku])
  @@index([organizationId, active])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  itemId         String
  item           InventoryItem     @relation(fields: [itemId], references: [id])
  type           StockMovementType
  /// Units in the transaction — always positive.
  quantity       Int
  /// Effect on quantityOnHand (signed). Damaged / lost returns leave stock unchanged.
  stockDelta     Int
  unitCost       Decimal           @db.Decimal(14, 2)
  condition      ReturnCondition?
  employeeId     String?
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  /// Delivery note, invoice, stocktake or requisition reference.
  reference      String?
  reason         String?
  balanceAfter   Int
  movementDate   DateTime          @db.Date
  createdBy      String
  createdAt      DateTime          @default(now())

  @@index([organizationId, itemId])
  @@index([organizationId, employeeId])
}

/// A standard issue — e.g. "Guard starter kit" — so onboarding is one click instead of ten.
model KitPack {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  /// Suggested for one employee category (informational — any pack can be issued to anyone).
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lines KitPackLine[]

  @@unique([organizationId, name])
}

model KitPackLine {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  packId         String
  pack           KitPack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  quantity       Int

  @@unique([packId, itemId])
}

// ─────────────────────── STAFF LOANS & SALARY ADVANCES ───────────────────────

enum LoanType {
  LOAN
  SALARY_ADVANCE
}

enum LoanStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  CANCELLED
  WRITTEN_OFF
}

/// How an instalment is settled: by a payroll deduction, by a deduction on the end-of-service
/// settlement, or in cash/transfer paid straight to the company.
enum LoanInstallmentKind {
  PAYROLL
  SETTLEMENT
  CASH
}

/// Money lent to an employee, interest-free, repaid from payroll. The balance is never stored: it is
/// worked out from the instalments (a payroll deduction counts as paid once its payroll is locked).
model StaffLoan {
  id                  String       @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  loanNumber          String
  employeeId          String
  employee            Employee     @relation(fields: [employeeId], references: [id])
  type                LoanType     @default(LOAN)
  principal           Decimal      @db.Decimal(14, 2)
  installmentCount    Int          @default(1)
  installmentAmount   Decimal      @db.Decimal(14, 2)
  /// The first payroll month a repayment is taken in.
  firstDeductionYear  Int
  firstDeductionMonth Int
  reason              String
  status              LoanStatus   @default(PENDING_APPROVAL)
  requestedBy         String
  requestedById       String
  approvedBy          String?
  approvedAt          DateTime?
  decisionNote        String?
  disbursedOn         DateTime?    @db.Date
  writtenOffAmount    Decimal?     @db.Decimal(14, 2)
  writtenOffReason    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  installments LoanInstallment[]

  @@unique([organizationId, loanNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, status])
}

model LoanInstallment {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  loanId         String
  loan           StaffLoan           @relation(fields: [loanId], references: [id])
  kind           LoanInstallmentKind
  amount         Decimal             @db.Decimal(14, 2)
  /// The payroll Deduction this instalment became (PAYROLL / SETTLEMENT kinds).
  deductionId    String?             @unique
  periodId       String?
  paidOn         DateTime?           @db.Date
  reference      String?
  createdBy      String
  createdAt      DateTime            @default(now())

  @@index([organizationId, loanId])
}

// ───────────────────────────── LETTERS ─────────────────────────────

enum LetterType {
  OFFER
  EMPLOYMENT_CONFIRMATION
  PROBATION_CONFIRMATION
  WARNING
  EXIT_LETTER
  EXPERIENCE
  CLEARANCE_CERTIFICATE
}

/// The wording of one kind of letter, per organization. The body is plain text with {{field}} merge
/// placeholders; saving rejects any placeholder the letter type doesn't offer.
model LetterTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           LetterType
  subject        String
  body           String
  signatoryName  String       @default("")
  signatoryTitle String       @default("Human Resources")
  updatedBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type])
}

/// A letter as it was issued — the merged text is stored, so changing the template later never
/// rewrites a letter already given to someone.
model GeneratedLetter {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  referenceNumber String
  type            LetterType
  /// Who it is about (the employee, or the candidate for an offer).
  recipientName   String
  employeeId      String?
  employee        Employee?    @relation(fields: [employeeId], references: [id])
  candidateId     String?
  /// The record it was generated from (offer, exit, disciplinary record…), for traceability.
  sourceId        String?
  subject         String
  body            String
  signatoryName   String       @default("")
  signatoryTitle  String       @default("")
  generatedBy     String
  createdAt       DateTime     @default(now())

  @@unique([organizationId, referenceNumber])
  @@index([organizationId, employeeId])
  @@index([organizationId, type])
}

// ─────────────────────────── PERSONAL RECORDS: CONTACTS & GUARANTORS ───────────────────────────

enum ContactKind {
  NEXT_OF_KIN
  EMERGENCY_CONTACT
  DEPENDANT
  REFEREE
}

enum GuarantorStatus {
  PENDING
  VERIFIED
  REJECTED
  RELEASED
}

/// A person connected to an employee: next of kin, emergency contact, dependant or referee. Employees
/// can maintain their own (self-service); HR can maintain anyone's.
model EmployeeContact {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  employeeId      String
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind            ContactKind
  fullName        String
  relationship    String
  phone           String?
  altPhone        String?
  email           String?
  address         String?
  dateOfBirth     DateTime?    @db.Date
  occupation      String?
  /// The main next of kin / emergency contact (one per employee per kind).
  isPrimary       Boolean      @default(false)
  /// Receives death-in-service / group-life / final-pay benefits.
  isBeneficiary   Boolean      @default(false)
  /// Percentage of the benefit; an employee's shares total 100 when complete.
  benefitSharePct Int?
  notes           String?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, employeeId, kind])
}

/// A guarantor vouching for an employee (common for security and cash-handling staff). Recorded as
/// PENDING, then verified (identity checked, signed form on file) or rejected; released when no longer needed.
model EmployeeGuarantor {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  employeeId       String
  employee         Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fullName         String
  relationship     String
  phone            String
  altPhone         String?
  email            String?
  address          String
  occupation       String?
  employer         String?
  employerAddress  String?
  idType           String?
  idNumber         String?
  yearsKnown       Int?
  /// The most the guarantor accepts liability for, if the agreement caps it.
  guaranteeAmount  Decimal?        @db.Decimal(14, 2)
  /// Reference to the signed guarantee form (filename / file number) — matching EmployeeDocument.
  formReference    String?
  status           GuarantorStatus @default(PENDING)
  recordedBy       String
  recordedByUserId String
  verifiedBy       String?
  verifiedByUserId String?
  verifiedAt       DateTime?
  verificationNote String?
  releasedAt       DateTime?
  releaseReason    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── TRAINING COMPLIANCE ───────────────────────────

/// A course or certification employees must hold — for everyone, or for one category. Matched by name
/// (case-insensitively) against the certificates recorded on each employee (EmployeeTraining).
model TrainingRequirement {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  courseName     String
  description    String?
  /// Null = every employee; otherwise only this category.
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  /// A new joiner has this many days from their employment date before a missing certificate counts.
  graceDays      Int               @default(30)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())

  @@index([organizationId, active])
}

// ─────────────────────────── PERFORMANCE APPRAISALS ───────────────────────────

enum AppraisalKind {
  ANNUAL
  PROBATION
  AD_HOC
}

enum AppraisalCycleStatus {
  OPEN
  CLOSED
}

enum AppraisalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  ACKNOWLEDGED
}

enum AppraisalRecommendation {
  NONE
  CONFIRM_EMPLOYMENT
  INCREMENT
  PROMOTION
  TRAINING
  PERFORMANCE_PLAN
}

/// One thing employees are rated on, with its weight. Edited in Settings; a cycle snapshots the active
/// criteria when it is launched, so later edits never change an appraisal already under way.
model AppraisalCriterion {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  weight         Int          @default(10)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  ratings AppraisalRating[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

model AppraisalCycle {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  kind           AppraisalKind        @default(ANNUAL)
  periodStart    DateTime             @db.Date
  periodEnd      DateTime             @db.Date
  /// Reviews should be submitted by this date.
  dueDate        DateTime             @db.Date
  status         AppraisalCycleStatus @default(OPEN)
  createdBy      String
  /// Whole percentage of the overall score that comes from KPI results (0 = KPIs do not count, as before).
  kpiSharePct    Int                  @default(0)
  closedAt       DateTime?
  createdAt      DateTime             @default(now())

  appraisals Appraisal[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

/// One employee's review in a cycle: self-assessment, then the reviewer's ratings, then sign-off by
/// someone other than the reviewer, then the employee acknowledges (or disputes) the result.
model Appraisal {
  id                  String                  @id @default(cuid())
  organizationId      String
  organization        Organization            @relation(fields: [organizationId], references: [id])
  cycleId             String
  cycle               AppraisalCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId          String
  employee            Employee                @relation(fields: [employeeId], references: [id])
  reviewerUserId      String?
  reviewerName        String?
  status              AppraisalStatus         @default(DRAFT)
  selfSubmittedAt     DateTime?
  employeeSelfComment String?
  /// Weighted average of the reviewer's ratings (1–5), fixed when the review is submitted.
  overallScore        Decimal?                @db.Decimal(4, 2)
  overallBand         String?
  /// The weighted average of the reviewer's ratings and the KPI score (hundredths, 340 = 3.40), kept beside the blended overall score.
  criteriaScore       Decimal?                @db.Decimal(4, 2)
  kpiScore            Int?
  /// The job description in force when the cycle was launched, if the employee's category had one.
  jobDescriptionId    String?
  jobDescription      JobDescription?         @relation(fields: [jobDescriptionId], references: [id])
  strengths           String?
  improvements        String?
  goals               String?
  reviewerComment     String?
  recommendation      AppraisalRecommendation @default(NONE)
  submittedAt         DateTime?
  returnNote          String?
  approvedBy          String?
  approvedByUserId    String?
  approvedAt          DateTime?
  approvalNote        String?
  acknowledgedAt      DateTime?
  employeeAgreed      Boolean?
  employeeResponse    String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  ratings AppraisalRating[]
  kpis    AppraisalKpi[]
  improvementPlans PerformanceImprovementPlan[]

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@index([reviewerUserId])
}

model AppraisalRating {
  id             String             @id @default(cuid())
  organizationId String
  appraisalId    String
  appraisal      Appraisal          @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  criterionId    String
  criterion      AppraisalCriterion @relation(fields: [criterionId], references: [id])
  /// Snapshots, so renaming or re-weighting a criterion doesn't rewrite a review in progress.
  criterionName  String
  weight         Int
  sortOrder      Int                @default(0)
  selfRating     Int?
  selfComment    String?
  rating         Int?
  comment        String?

  @@unique([appraisalId, criterionId])
}

enum KpiUnit {
  PERCENT
  COUNT
  NAIRA
  RATING
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum JobDescriptionStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// What a role is for, one per employee category and version. HR drafts it; a second person makes it active (it drives how
/// people are rated). An active version is never edited: a change is a new draft, and the old version is retired.
model JobDescription {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id])
  categoryId        String
  category          EmployeeCategory     @relation(fields: [categoryId], references: [id])
  version           Int
  title             String
  purpose           String?
  responsibilities  String?
  status            JobDescriptionStatus @default(DRAFT)
  draftedBy         String
  draftedByUserId   String?
  activatedBy       String?
  activatedByUserId String?
  activatedAt       DateTime?
  retiredAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  kpis       Kpi[]
  appraisals Appraisal[]

  @@unique([organizationId, categoryId, version])
  @@index([organizationId, categoryId, status])
}

/// One measurable target under a job description. Edited only while the job description is a draft.
model Kpi {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id])
  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  unit             KpiUnit
  direction        KpiDirection
  /// Exact decimal, above zero.
  target           Decimal        @db.Decimal(16, 4)
  /// Relative weight among the job description's KPIs (they need not add up to 100).
  weight           Int            @default(10)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())

  appraisalKpis AppraisalKpi[]

  @@unique([jobDescriptionId, name])
  @@index([organizationId])
}

/// One KPI on one appraisal: a snapshot taken when the cycle is launched (so later edits never change a review under way),
/// then the reviewer's actual result, and the achievement and score worked out from it.
model AppraisalKpi {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  appraisalId    String
  appraisal      Appraisal    @relation(fields: [appraisalId], references: [id], onDelete: Cascade)
  kpiId          String
  kpi            Kpi          @relation(fields: [kpiId], references: [id])
  kpiName        String
  unit           KpiUnit
  direction      KpiDirection
  target         Decimal      @db.Decimal(16, 4)
  weight         Int
  sortOrder      Int          @default(0)
  actual         Decimal?     @db.Decimal(16, 4)
  comment        String?
  /// Basis points (10,000 = 100%) and the 1 to 5 score, fixed when the review is submitted.
  achievementBp  Int?
  score          Int?

  @@unique([appraisalId, kpiId])
  @@index([organizationId])
}

// ─────────────────────────── CHANGE CONTROL FOR SENSITIVE DETAILS ───────────────────────────

enum ChangeKind {
  BANK
  TAX
  PENSION
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A requested change to an employee's bank, tax or pension details. It takes effect only when someone
/// other than the requester approves it; the details at request time are kept beside what was asked for.
model EmployeeChangeRequest {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind              ChangeKind
  /// The new values, e.g. { bankName, accountNumber, accountName }.
  proposed          Json
  /// What the employee had when the request was made.
  previous          Json
  reason            String
  status            ChangeStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime     @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  /// When an approved change was written to the employee record.
  appliedAt         DateTime?

  @@index([organizationId, status])
  @@index([organizationId, employeeId, kind])
}

// ─────────────────────────── COMPANY POLICIES & ACKNOWLEDGEMENTS ───────────────────────────

enum PolicyStatus {
  ACTIVE
  ARCHIVED
}

enum AckMethod {
  SELF
  RECORDED
}

/// A company policy (code of conduct, data protection, safety…) that employees must read and acknowledge —
/// everyone, or one category. The wording lives in its versions, which are never edited once published.
model CompanyPolicy {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  title          String
  summary        String?
  /// Null = every employee; otherwise only this category.
  categoryId     String?
  category       EmployeeCategory? @relation(fields: [categoryId], references: [id])
  /// Days an employee has to acknowledge, from the version taking effect or from joining (whichever is later).
  graceDays      Int               @default(14)
  status         PolicyStatus      @default(ACTIVE)
  createdBy      String
  createdAt      DateTime          @default(now())

  versions PolicyVersion[]

  @@unique([organizationId, title])
  @@index([organizationId, status])
}

/// One published wording of a policy. A new version means everyone has to acknowledge again.
model PolicyVersion {
  id                String        @id @default(cuid())
  organizationId    String
  policyId          String
  policy            CompanyPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  version           Int
  /// From this date the version is the current one; a future date schedules it.
  effectiveDate     DateTime      @db.Date
  /// The text employees read. A document reference may be given instead, or as well.
  body              String?
  /// Reference to the signed-off document (file name / number) — this app has no object storage.
  documentReference String?
  changeSummary     String?
  publishedBy       String
  publishedAt       DateTime      @default(now())

  acknowledgements PolicyAcknowledgement[]

  @@unique([policyId, version])
}

model PolicyAcknowledgement {
  id             String        @id @default(cuid())
  organizationId String
  versionId      String
  version        PolicyVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  acknowledgedAt DateTime      @default(now())
  method         AckMethod     @default(SELF)
  /// For a paper sign-off recorded by HR: who recorded it.
  recordedBy     String?
  note           String?

  @@unique([versionId, employeeId])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── DATA SUBJECT ACCESS REQUESTS ───────────────────────────

enum DataRequestStatus {
  OPEN
  FULFILLED
  REFUSED
}

/// A request from an employee (or former employee) for a copy of the personal data held on them, with the
/// deadline to answer it. The export itself is generated on demand and never stored; the register keeps
/// who asked, when, how identity was checked, who answered, and a checksum and section counts of what was
/// handed over.
model DataAccessRequest {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  requestNumber    String
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  /// Who made the request — the employee, or someone acting for them.
  requesterName    String
  /// How it arrived: email, letter, in person…
  channel          String?
  receivedOn       DateTime          @db.Date
  dueOn            DateTime          @db.Date
  status           DataRequestStatus @default(OPEN)
  identityVerified Boolean           @default(false)
  identityNote     String?
  verifiedBy       String?
  exportedAt       DateTime?
  /// SHA-256 of the file generated, and how many records each section held.
  exportChecksum   String?
  exportSections   Json?
  handledBy        String?
  completedOn      DateTime?
  completionNote   String?
  refusalReason    String?
  createdBy        String
  createdAt        DateTime          @default(now())

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
}

enum BreachStatus {
  OPEN
  CLOSED
}

/// What the controller concluded about the harm a breach could do to the people affected. Until someone has
/// assessed it the notification clock is treated as running.
enum BreachAssessment {
  UNASSESSED
  NO_RISK
  RISK
  HIGH_RISK
}

/// A personal-data breach: what happened, when it was discovered, the assessment of risk, whether and when the
/// regulator and the people affected were told, and how it was contained and closed. The regulator must be told
/// within a set number of hours of the company becoming aware (HR policy: breachNotifyHours) when the breach is
/// likely to put people at risk.
model DataBreach {
  id                    String             @id @default(cuid())
  organizationId        String
  organization          Organization       @relation(fields: [organizationId], references: [id])
  incidentNumber        String
  title                 String
  description           String
  /// When the company became aware — the notification deadline counts from here.
  discoveredAt          DateTime
  occurredOn            DateTime?          @db.Date
  /// Kinds of data involved (identity, bank details, ...).
  dataCategories        String[]           @default([])
  individualsAffected   Int?
  status                BreachStatus       @default(OPEN)
  assessment            BreachAssessment   @default(UNASSESSED)
  assessmentNote        String?
  assessedBy            String?
  assessedAt            DateTime?
  containedAt           DateTime?
  containmentNote       String?
  rootCause             String?
  remediation           String?
  ndpcNotifiedAt        DateTime?
  ndpcReference         String?
  /// Why the regulator was told after the deadline.
  lateReason            String?
  individualsNotifiedAt DateTime?
  individualsNote       String?
  closedAt              DateTime?
  closedBy              String?
  reportedBy            String
  createdAt             DateTime           @default(now())
  updates               DataBreachUpdate[]

  @@unique([organizationId, incidentNumber])
  @@index([organizationId, status])
}

/// Append-only timeline of a breach: every decision and every note, with who and when.
model DataBreachUpdate {
  id             String     @id @default(cuid())
  organizationId String
  breachId       String
  breach         DataBreach @relation(fields: [breachId], references: [id], onDelete: Cascade)
  note           String
  author         String
  createdAt      DateTime   @default(now())

  @@index([breachId])
}

enum ErasureKind {
  /// The retention period has run out.
  RETENTION
  /// The person asked for their data to be erased.
  REQUEST
}

enum ErasureStatus {
  PENDING
  EXECUTED
  REJECTED
}

/// A request to remove a former employee's personal details once the retention period has passed. One person asks,
/// a different person approves; approving carries it out. What was removed is recorded as counts, never as the data.
model EmployeeErasure {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee      @relation(fields: [employeeId], references: [id])
  kind              ErasureKind
  reason            String
  status            ErasureStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  decidedBy         String?
  decidedByUserId   String?
  decisionNote      String?
  decidedAt         DateTime?
  /// How many records of each kind were changed or removed.
  summary           Json?
  createdAt         DateTime      @default(now())

  @@index([organizationId, status])
  @@index([employeeId])
}

enum AccountingPeriodStatus {
  /// Anyone allowed to post can post.
  OPEN
  /// Only finance staff with the close permission can still post (adjustments while the books are being finished).
  SOFT_CLOSED
  /// Nothing can be posted. Reopening needs a reason and the reopen permission.
  CLOSED
  /// Final. Nothing can be posted and it cannot be reopened.
  LOCKED
}

/// A financial year: twelve monthly accounting periods starting in the organization's first fiscal month.
model FiscalYear {
  id                        String             @id @default(cuid())
  organizationId            String
  organization              Organization       @relation(fields: [organizationId], references: [id])
  name                      String
  startDate                 DateTime           @db.Date
  endDate                   DateTime           @db.Date
  createdAt                 DateTime           @default(now())
  periods                   AccountingPeriod[]
  /// Set when the year-end closing entries have been posted: the profit or loss moved to retained earnings and every income and
  /// expense account brought to nil. While it is set, nothing more can be posted to income or expense accounts dated in the year.
  closedAt                  DateTime?
  closedBy                  String?
  closedByUserId            String?
  closingJournalId          String?            @unique
  closingJournal            JournalEntry?      @relation("YearEndClosing", fields: [closingJournalId], references: [id], onDelete: Restrict)
  /// The equity account the year's profit or loss was moved to.
  retainedEarningsAccountId String?

  @@unique([organizationId, startDate])
}

/// One month of a financial year. Every journal belongs to one; its status decides whether it can be posted to.
model AccountingPeriod {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  fiscalYearId   String
  fiscalYear     FiscalYear              @relation(fields: [fiscalYearId], references: [id])
  number         Int
  name           String
  startDate      DateTime                @db.Date
  endDate        DateTime                @db.Date
  status         AccountingPeriodStatus  @default(OPEN)
  createdAt      DateTime                @default(now())
  journals       JournalEntry[]
  events         AccountingPeriodEvent[]
  snapshots      PeriodSnapshot[]
  checklist      CloseChecklistItem[]
  waivers        CloseWaiver[]

  @@unique([organizationId, startDate])
  @@index([organizationId, status])
  @@index([fiscalYearId])
}

/// The books of a period as they stood when it was closed: trial balance, receivables by client and invoice with ageing, payables
/// by vendor, cash and tax balances. This is the official record: it does not change when later activity posts, and a period that
/// is reopened and closed again gets a new version while the old one is kept, marked superseded.
model PeriodSnapshot {
  id             String           @id @default(cuid())
  organizationId String
  periodId       String
  period         AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  version        Int
  /// The date the figures are as at: the last day of the period.
  asAt           DateTime         @db.Date
  takenAt        DateTime         @default(now())
  takenBy        String
  takenByUserId  String
  data           Json
  arTotal        Decimal          @db.Decimal(16, 2)
  arLedger       Decimal          @db.Decimal(16, 2)
  apTotal        Decimal          @db.Decimal(16, 2)
  apLedger       Decimal          @db.Decimal(16, 2)
  trialDebit     Decimal          @db.Decimal(16, 2)
  trialCredit    Decimal          @db.Decimal(16, 2)
  /// SHA-256 of the data, so a snapshot can be proved unaltered.
  checksum       String
  supersededAt   DateTime?
  supersededBy   String?

  @@unique([periodId, version])
  @@index([organizationId, periodId])
}

/// A sign-off on the close of a period (bank accounts reconciled, accruals reviewed …). Done by a person, with a note.
model CloseChecklistItem {
  id             String           @id @default(cuid())
  organizationId String
  periodId       String
  period         AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  code           String
  label          String
  sortOrder      Int              @default(0)
  done           Boolean          @default(false)
  doneBy         String?
  doneByUserId   String?
  doneAt         DateTime?
  note           String?

  @@unique([periodId, code])
}

/// A pending item on the close checklist that an approver chose to close the period over, with the reason. Append-only.
model CloseWaiver {
  id             String           @id @default(cuid())
  organizationId String
  periodId       String
  period         AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  checkCode      String
  reason         String
  waivedBy       String
  waivedByUserId String
  createdAt      DateTime         @default(now())

  @@index([periodId])
}

/// Append-only trail of everything done to a period: who closed, approved, locked or reopened it, and why.
model AccountingPeriodEvent {
  id             String                 @id @default(cuid())
  organizationId String
  periodId       String
  period         AccountingPeriod       @relation(fields: [periodId], references: [id])
  action         String
  fromStatus     AccountingPeriodStatus
  toStatus       AccountingPeriodStatus
  actor          String
  actorUserId    String
  reason         String?
  createdAt      DateTime               @default(now())

  @@index([periodId])
}

/// A group of accounts within one of the seven account classes (1 Assets … 7 Finance and other).
model AccountGroup {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  /// 1 Assets, 2 Liabilities, 3 Equity, 4 Revenue, 5 Cost of services, 6 Operating expenses, 7 Finance and other.
  classNumber    Int
  code           String
  name           String
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  categories     AccountCategory[]

  @@unique([organizationId, code])
  @@index([organizationId, classNumber])
}

/// A category within a group. Carries the financial-statement line its accounts report under.
model AccountCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  groupId        String
  group          AccountGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  code           String
  name           String
  /// The statement line accounts in this category report under (e.g. TRADE_RECEIVABLES), unless an account overrides it.
  statementLine  String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  accounts       GlAccount[]

  @@unique([organizationId, code])
  @@index([groupId])
}

/// A region of the business (a state, a zone, a territory). A region can sit inside a larger one, so a zone is a region of regions.
model Region {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  parentId       String?
  parent         Region?       @relation("RegionZone", fields: [parentId], references: [id], onDelete: Restrict)
  children       Region[]      @relation("RegionZone")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  branches       Branch[]
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A branch or office, optionally within a region.
model Branch {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  regionId       String?
  region         Region?       @relation(fields: [regionId], references: [id], onDelete: Restrict)
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A part of the business whose profit is judged separately (a division, a service line).
model ProfitCentre {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

/// A project or job that income and cost can be charged to, optionally for one client or contract.
model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  clientId       String?
  contractId     String?
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

enum JournalDocumentKind {
  MANUAL
  ADJUSTMENT
  /// Posts now and reverses itself on a set date.
  ACCRUAL
  /// Moves a balance from one account or dimension to another.
  RECLASSIFICATION
}

enum JournalDocumentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

/// A manual journal as a document: drafted, submitted, approved by someone else, then posted through the posting
/// engine. Only a posted document has a journal; until then nothing touches the ledger. Once submitted its lines can no
/// longer be changed (the database enforces it) until it is rejected back to draft.
model JournalDocument {
  id                 String                @id @default(cuid())
  organizationId     String
  organization       Organization          @relation(fields: [organizationId], references: [id])
  documentNumber     String
  kind               JournalDocumentKind   @default(MANUAL)
  description        String
  postingDate        DateTime              @db.Date
  /// For an accrual: the date its automatic reversal is posted.
  reverseOn          DateTime?             @db.Date
  status             JournalDocumentStatus @default(DRAFT)
  createdBy          String
  createdByUserId    String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  submittedBy        String?
  submittedByUserId  String?
  submittedAt        DateTime?
  decidedBy          String?
  decidedByUserId    String?
  decidedAt          DateTime?
  decisionNote       String?
  postedBy           String?
  postedAt           DateTime?
  journalId          String?               @unique
  journal            JournalEntry?         @relation(fields: [journalId], references: [id], onDelete: Restrict)
  lines              JournalDocumentLine[]
  /// The recurring template that generated this draft, if any. One document per template per posting date.
  recurringJournalId String?
  recurringJournal   RecurringJournal?     @relation(fields: [recurringJournalId], references: [id], onDelete: Restrict)

  @@unique([organizationId, documentNumber])
  @@unique([recurringJournalId, postingDate])
  @@index([organizationId, status])
}

model JournalDocumentLine {
  id          String          @id @default(cuid())
  documentId  String
  document    JournalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accountId   String
  account     GlAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description String
  debit       Decimal         @default(0) @db.Decimal(16, 2)
  credit      Decimal         @default(0) @db.Decimal(16, 2)
  sortOrder   Int             @default(0)
  /// Dimension ids by column name (clientId, contractId, costCenterId …), checked by the posting engine when it posts.
  dimensions  Json?

  @@index([documentId])
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// A template that generates a journal draft each period (rent, insurance, amortisation, standing accruals). The draft
/// goes through the ordinary submit / approve / post path; the template itself never touches the ledger.
model RecurringJournal {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  name             String
  kind             JournalDocumentKind    @default(MANUAL)
  /// May contain {month}, {quarter} and {year}, filled in with the posting date of each generated journal.
  description      String
  frequency        RecurrenceFrequency    @default(MONTHLY)
  /// Post on the last day of the month instead of the first date's day of the month.
  monthEnd         Boolean                @default(false)
  startDate        DateTime               @db.Date
  endDate          DateTime?              @db.Date
  /// The posting date of the next journal to generate; null once the template has run to its end date.
  nextRunDate      DateTime?              @db.Date
  generatedCount   Int                    @default(0)
  /// For an accrual: days after its posting date that it reverses on.
  reverseAfterDays Int?
  /// Submit each generated draft for approval straight away (only when the organization requires approval).
  autoSubmit       Boolean                @default(false)
  active           Boolean                @default(true)
  createdBy        String
  createdByUserId  String
  createdAt        DateTime               @default(now())
  /// Whoever last changed the template: the preparer of every journal it generates after that.
  updatedBy        String
  updatedByUserId  String
  updatedAt        DateTime               @updatedAt
  lastRunAt        DateTime?
  lastRunNote      String?
  lines            RecurringJournalLine[]
  documents        JournalDocument[]

  @@index([organizationId, active, nextRunDate])
}

model RecurringJournalLine {
  id          String           @id @default(cuid())
  templateId  String
  template    RecurringJournal @relation(fields: [templateId], references: [id], onDelete: Cascade)
  accountId   String
  account     GlAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  description String
  debit       Decimal          @default(0) @db.Decimal(16, 2)
  credit      Decimal          @default(0) @db.Decimal(16, 2)
  sortOrder   Int              @default(0)
  dimensions  Json?

  @@index([templateId])
}

/// What a tax is charged on, of a charge-out amount that is split into a direct and an indirect charge.
/// Part of a client receipt applied to one invoice: cash, and tax the client withheld. Never edited or deleted; if it was applied
/// to the wrong invoice it is reversed, with a reason, and the amount goes back to the receipt to be applied again.
model ReceiptAllocation {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  receiptId      String
  receipt        ClientReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  invoiceId      String
  invoice        ClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  cashAmount     Decimal       @db.Decimal(16, 2)
  whtAmount      Decimal       @default(0) @db.Decimal(16, 2)
  /// The date it takes effect (the receipt date, or the day an advance was applied).
  appliedOn      DateTime      @db.Date
  createdBy      String
  createdAt      DateTime      @default(now())
  reversedAt     DateTime?
  reversedOn     DateTime?     @db.Date
  reversedBy     String?
  reversalReason String?

  @@index([organizationId, invoiceId])
  @@index([receiptId])
}

/// A withholding tax credit note or certificate received from a client: the evidence that tax was withheld on what they paid, which
/// is what the tax authority credits. Never edited or deleted: a wrong one is voided, with a reason, and entered again.
model TaxCertificate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  clientId          String
  client            Client       @relation(fields: [clientId], references: [id])
  /// As printed on the certificate.
  certificateNumber String
  /// The number with spaces and punctuation removed and upper-cased, which is what receipts and deductions are matched on.
  numberKey         String
  issueDate         DateTime     @db.Date
  receivedDate      DateTime     @db.Date
  amount            Decimal      @db.Decimal(16, 2)
  /// Where the original is kept (a file reference, a folder, a scan name).
  document          String?
  notes             String?
  recordedBy        String
  createdAt         DateTime     @default(now())
  voidedAt          DateTime?
  voidedBy          String?
  voidReason        String?

  @@index([organizationId, clientId, numberKey])
}

enum ClientNoteType {
  CREDIT
  DEBIT
}

enum ClientNoteReason {
  BILLING_ERROR
  SERVICE_CREDIT
  DISCOUNT
  PRICE_ADJUSTMENT
  PENALTY_OR_FEE
  OTHER
}

enum NoteStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A credit note (reduces what a client owes on an invoice) or a debit note (increases it), raised by one person and approved
/// by another. Approving posts it to the ledger and moves the invoice's balance; the invoice itself is never edited. Once decided
/// a note is never changed: a mistaken credit note is put right with a debit note, and the other way round.
model ClientNote {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id])
  noteNumber        String
  type              ClientNoteType
  invoiceId         String
  invoice           ClientInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  noteDate          DateTime         @db.Date
  reasonCode        ClientNoteReason
  reason            String
  netAmount         Decimal          @db.Decimal(16, 2)
  vatAmount         Decimal          @default(0) @db.Decimal(16, 2)
  totalAmount       Decimal          @db.Decimal(16, 2)
  status            NoteStatus       @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime         @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@unique([organizationId, noteNumber])
  @@index([organizationId, status])
  @@index([invoiceId])
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Money returned to a client out of an advance. Asked for by one person and approved by another; approving it posts the payment.
model ClientRefund {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id])
  refundNumber      String
  receiptId         String
  receipt           ClientReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  amount            Decimal       @db.Decimal(16, 2)
  refundDate        DateTime      @db.Date
  method            String?
  reference         String?
  reason            String
  status            RefundStatus  @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime      @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@unique([organizationId, refundNumber])
  @@index([receiptId])
}

enum BillingBase {
  /// The indirect (management) charge only. The security-and-guarding default for VAT.
  INDIRECT
  /// The direct (pass-through) charge only.
  DIRECT
  /// The whole charge-out amount. The default for expected withholding.
  FULL
  /// Nothing: the tax doesn't apply.
  NONE
}

enum BillingRuleStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A kind of service the organization bills (Security & Guarding, Consulting …). Its billing rule is the default for every
/// contract of the type.
model ServiceType {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  active         Boolean       @default(true)
  createdBy      String
  createdAt      DateTime      @default(now())
  contracts      Contract[]
  rules          BillingRule[]

  @@unique([organizationId, code])
}

/// How a service type, or one contract, is billed from a date: the direct/indirect split and what VAT and withholding are
/// charged on. A rule is proposed by one person and approved by another and is never edited afterwards (a change is a new
/// rule from a later date). A contract's own rule is an override of its service type's. Exactly one of serviceTypeId and
/// contractId is set.
model BillingRule {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id])
  serviceTypeId     String?
  serviceType       ServiceType?        @relation(fields: [serviceTypeId], references: [id], onDelete: Restrict)
  contractId        String?
  contract          Contract?           @relation(fields: [contractId], references: [id], onDelete: Restrict)
  directPct         Decimal             @db.Decimal(5, 2)
  indirectPct       Decimal             @db.Decimal(5, 2)
  vatBase           BillingBase         @default(INDIRECT)
  whtBase           BillingBase         @default(FULL)
  /// A particular tax code for this service or contract; blank = the organization's default code for the type.
  vatTaxCodeId      String?
  whtTaxCodeId      String?
  effectiveFrom     DateTime            @db.Date
  effectiveTo       DateTime?           @db.Date
  status            BillingRuleStatus   @default(PENDING)
  reason            String
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime            @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  lines             ClientInvoiceLine[]

  @@index([organizationId, serviceTypeId, status])
  @@index([organizationId, contractId, status])
}

enum TaxType {
  VAT
  WHT
}

enum TaxRateStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TaxTransactionKind {
  /// VAT charged on a sale: a liability to the tax authority.
  OUTPUT_VAT
  /// Tax the client is expected to withhold on paying an invoice. What they actually withhold is recorded as a deduction.
  EXPECTED_WHT
}

/// A tax the organization charges or is charged (VAT, withholding tax). The rate lives in TaxRate, by date.
model TaxCode {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  code           String
  name           String
  type           TaxType
  /// The ledger account the tax is booked to (output VAT payable, WHT receivable).
  accountCode    String?
  /// The code invoices use when nothing more specific applies. At most one per type.
  isDefault      Boolean          @default(false)
  active         Boolean          @default(true)
  notes          String?
  createdBy      String
  createdAt      DateTime         @default(now())
  rates          TaxRate[]
  transactions   TaxTransaction[]

  @@unique([organizationId, code])
  @@index([organizationId, type])
}

/// One rate of a tax code from a date. Rates are only ever added: a change is a new rate from a later date, proposed by
/// one person and approved by another; the database refuses to edit or delete an approved one.
model TaxRate {
  id                String        @id @default(cuid())
  taxCodeId         String
  taxCode           TaxCode       @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  ratePct           Decimal       @db.Decimal(6, 3)
  effectiveFrom     DateTime      @db.Date
  /// Set when a later rate is approved: the day before it starts.
  effectiveTo       DateTime?     @db.Date
  status            TaxRateStatus @default(PENDING)
  reason            String
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime      @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@index([taxCodeId, status, effectiveFrom])
}

/// One taxed amount on a posted document: what the VAT and withholding reports read. Written with the invoice, in the
/// same transaction, and only ever marked reversed.
model TaxTransaction {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  /// Null for amounts that pre-date the tax engine.
  taxCodeId      String?
  taxCode        TaxCode?           @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)
  kind           TaxTransactionKind
  sourceType     String
  invoiceId      String?
  invoice        ClientInvoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  clientId       String?
  taxDate        DateTime           @db.Date
  taxableAmount  Decimal            @db.Decimal(16, 2)
  ratePct        Decimal            @db.Decimal(6, 3)
  taxAmount      Decimal            @db.Decimal(16, 2)
  reversed       Boolean            @default(false)
  reversedAt     DateTime?
  createdAt      DateTime           @default(now())

  @@index([organizationId, kind, taxDate])
  @@index([invoiceId])
}

enum JournalReversalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to reverse a posted manual journal. Someone else approves; approving posts a mirror journal and links it
/// to the original, which stays in the ledger untouched.
model JournalReversal {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id])
  journalId         String
  journal           JournalEntry          @relation(fields: [journalId], references: [id], onDelete: Restrict)
  reason            String
  /// The date the reversal posts on (must be in a period that accepts postings).
  reverseDate       DateTime              @db.Date
  status            JournalReversalStatus @default(PENDING)
  requestedBy       String
  requestedByUserId String
  createdAt         DateTime              @default(now())
  decidedBy         String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?

  @@index([organizationId, status])
  @@index([journalId])
}

// ─────────────────────────────── SALES AND ACCOUNT MANAGEMENT (a company's own CRM for the clients it serves; see docs/crm) ───────────────────────────────
// Separate from the bureau's own payroll-sales pipeline above (Lead, Proposal, ...): these models are all prefixed Crm and used through the sales.* permissions.

enum CrmMode {
  CLASSIC
  SIMPLE
}

enum CrmRecordStatus {
  ACTIVE
  VOID
}

enum CrmAccountType {
  PROSPECT
  CLIENT
  FORMER_CLIENT
}

enum CrmSource {
  REFERRAL
  WALK_IN
  PHONE
  WEBSITE
  WHATSAPP
  TENDER
  EVENT
  EXISTING_CLIENT
  OTHER
}

enum CrmServiceInterest {
  GUARDING
  CLEANING
  FACILITY
  STAFFING
  OTHER
}

enum CrmDecisionRole {
  DECISION_MAKER
  INFLUENCER
  USER
  FINANCE
  PROCUREMENT
  GATEKEEPER
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  VOID
}

enum CrmConsentPurpose {
  MARKETING
  SERVICE
}

enum CrmConsentStatus {
  GRANTED
  WITHDRAWN
}

enum CrmChannel {
  EMAIL
  WHATSAPP
  SMS
  PHONE
  IN_PERSON
  WEB_FORM
  OTHER
}

/// Whether the sales module is on for an organization (off until a company administrator switches it on) and how enquiries are handled.
model CrmSetting {
  id                  String              @id @default(cuid())
  organizationId      String              @unique
  organization        Organization        @relation(fields: [organizationId], references: [id])
  enabled             Boolean             @default(false)
  mode                CrmMode             @default(CLASSIC)
  /// How new leads with no owner given (created by a manager) are assigned, and where round robin has got to.
  assignmentMethod    CrmAssignmentMethod @default(NONE)
  /// The lowest gross margin (a share of the bill) a quote may have before a designated approver must approve it, in basis points (1500 = 15.00%). 0 = no minimum. A new organization starts at 15%.
  minMarginBps        Int                 @default(1500)
  assignmentCursor    Int                 @default(0)
  /// A contract ending within this many days gets a renewal deal opened for it.
  renewalWindowDays   Int                 @default(90)
  /// The weight of each of the six health-score measures (whole numbers adding up to 100). Empty means the starting weights.
  healthWeights       Json?
  /// An unconverted lead with no activity for this many months is listed for review (keep or erase). Empty means no review.
  leadRetentionMonths Int?
  updatedBy           String
  updatedAt           DateTime            @updatedAt
}

/// A company the organization sells to or serves, as the sales side sees it. It links to the real Client only when a won deal is handed over.
model CrmAccount {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  name            String
  /// The name reduced to what identifies it (no case, punctuation or company ending), to find duplicates.
  normalizedName  String
  industry        String?
  accountType     CrmAccountType  @default(PROSPECT)
  ownerUserId     String
  ownerName       String
  parentAccountId String?
  parent          CrmAccount?     @relation("CrmAccountParent", fields: [parentAccountId], references: [id])
  children        CrmAccount[]    @relation("CrmAccountParent")
  source          CrmSource?
  sourceDetail    String?
  state           String?
  lga             String?
  address         String?
  rcNumber        String?
  emailDomain     String?
  /// The existing Client this became, set only at handover.
  clientId        String?
  /// Set when this account was merged into another (it is then voided).
  mergedIntoId    String?
  mergedInto      CrmAccount?     @relation("CrmAccountMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      CrmAccount[]    @relation("CrmAccountMerge")
  status          CrmRecordStatus @default(ACTIVE)
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?
  createdBy       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contacts      CrmContact[]
  opportunities CrmOpportunity[]
  activities    CrmActivity[]
  tasks         CrmTask[]
  cases         CrmCase[]
  slaPolicies   CrmSlaPolicy[]
  health        CrmAccountHealth?

  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, normalizedName])
  @@index([organizationId, status, name])
  @@index([organizationId, accountType, status])
}

/// A person at an account (or not yet attached to one). Phones are stored as E.164 (+234...).
model CrmContact {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  accountId      String?
  account        CrmAccount?      @relation(fields: [accountId], references: [id])
  firstName      String
  lastName       String
  jobTitle       String?
  roleInDecision CrmDecisionRole?
  phoneE164      String?
  whatsappE164   String?
  email          String?
  isPrimary      Boolean          @default(false)
  ownerUserId    String
  ownerName      String
  status         CrmRecordStatus  @default(ACTIVE)
  /// Set when this contact was merged into another (it is then voided; its consent history is read through the survivor).
  mergedIntoId   String?
  mergedInto     CrmContact?      @relation("CrmContactMerge", fields: [mergedIntoId], references: [id])
  mergedFrom     CrmContact[]     @relation("CrmContactMerge")
  voidedAt       DateTime?
  voidedBy       String?
  voidReason     String?
  createdBy      String
  createdAt      DateTime         @default(now())
  /// Set when the person was erased on a data request: the record stays (so deals and cases keep their links) but holds no personal detail.
  erasedAt       DateTime?
  updatedAt      DateTime         @updatedAt

  consents      CrmConsent[]
  opportunities CrmOpportunity[]
  activities    CrmActivity[]
  tasks         CrmTask[]

  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, phoneE164])
  @@index([organizationId, email])
  @@index([accountId])
  @@index([organizationId, status, lastName, firstName])
}

/// An enquiry not yet known to be real. Becomes an account and contact (and a deal) when converted (a later phase).
model CrmLead {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id])
  number                 String
  companyName            String
  contactName            String?
  jobTitle               String?
  phoneE164              String?
  email                  String?
  industry               String?
  state                  String?
  lga                    String?
  address                String?
  source                 CrmSource          @default(OTHER)
  sourceDetail           String?
  estimatedGuards        Int?
  serviceInterest        CrmServiceInterest @default(OTHER)
  status                 CrmLeadStatus      @default(NEW)
  unqualifiedReason      String?
  ownerUserId            String
  ownerName              String
  convertedAccountId     String?
  convertedContactId     String?
  convertedOpportunityId String?
  convertedAt            DateTime?
  convertedBy            String?
  voidedAt               DateTime?
  voidedBy               String?
  voidReason             String?
  createdBy              String
  createdAt              DateTime           @default(now())
  erasedAt               DateTime?
  /// A lead past the retention period stays until this date once someone has reviewed it and decided to keep it.
  retentionKeepUntil     DateTime?          @db.Date
  updatedAt              DateTime           @updatedAt

  consents   CrmConsent[]
  activities CrmActivity[]
  tasks      CrmTask[]

  @@unique([organizationId, number])
  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, phoneE164])
  @@index([organizationId, email])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, source, status])
}

/// One consent or withdrawal, never changed (the database refuses it). The latest row for a person and purpose decides; none means unknown.
model CrmConsent {
  id               String            @id @default(cuid())
  /// Orders the rows; the latest has the highest number.
  seq              Int               @unique @default(autoincrement())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  contactId        String?
  contact          CrmContact?       @relation(fields: [contactId], references: [id])
  leadId           String?
  lead             CrmLead?          @relation(fields: [leadId], references: [id])
  purpose          CrmConsentPurpose
  status           CrmConsentStatus
  channel          CrmChannel
  source           String
  evidenceRef      String?
  recordedBy       String
  recordedByUserId String
  recordedAt       DateTime          @default(now())

  @@index([contactId, purpose, seq])
  @@index([leadId, purpose, seq])
  @@index([organizationId])
}

enum CrmPipelineKind {
  NEW_BUSINESS
  RENEWAL
  RATE_REVIEW
  EXPANSION
}

enum CrmStageType {
  OPEN
  WON
  LOST
}

enum CrmAssignmentMethod {
  NONE
  ROUND_ROBIN
  BY_STATE
  BY_SERVICE
}

enum CrmAssignmentKind {
  STATE
  SERVICE
}

/// A sales process (new business, later renewal and rate review) made of stages. Each organization has its own copy; the starting stages and probabilities are editable defaults.
model CrmPipeline {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  kind           CrmPipelineKind
  isDefault      Boolean         @default(false)
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())

  stages          CrmStage[]
  opportunities   CrmOpportunity[]
  automationRules CrmAutomationRule[]

  @@unique([organizationId, name])
}

model CrmStage {
  id                 String       @id @default(cuid())
  pipelineId         String
  pipeline           CrmPipeline  @relation(fields: [pipelineId], references: [id])
  name               String
  sortOrder          Int
  stageType          CrmStageType @default(OPEN)
  /// 0 to 100: what a deal entering this stage is given as its probability.
  defaultProbability Int
  /// Field keys that must be filled before a deal may enter this stage (enforced from the board phase).
  requiredFields     Json         @default("[]")
  /// Days without activity after which a card on this stage is flagged.
  rottingDays        Int?
  active             Boolean      @default(true)

  opportunities   CrmOpportunity[]
  automationRules CrmAutomationRule[]

  @@index([pipelineId, sortOrder])
}

/// A specific bid for a client business: "24/7 guarding, 3 sites, 18 guards". Its monthly value is a money amount (Decimal 16,2, whole kobo).
model CrmOpportunity {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  accountId            String
  account              CrmAccount         @relation(fields: [accountId], references: [id])
  primaryContactId     String?
  primaryContact       CrmContact?        @relation(fields: [primaryContactId], references: [id])
  pipelineId           String
  pipeline             CrmPipeline        @relation(fields: [pipelineId], references: [id])
  stageId              String
  stage                CrmStage           @relation(fields: [stageId], references: [id])
  name                 String
  serviceType          CrmServiceInterest @default(OTHER)
  monthlyContractValue Decimal            @default(0) @db.Decimal(16, 2)
  /// 0 to 100; starts as the stage default and the owner may change it.
  probability          Int
  expectedCloseDate    DateTime?          @db.Date
  expectedStartDate    DateTime?          @db.Date
  contractTermMonths   Int?
  source               CrmSource?
  sourceDetail         String?
  ownerUserId          String
  ownerName            String
  /// The lead this deal came from, if it came from one.
  fromLeadId           String?
  /// What happens next on this deal; required every time it moves.
  nextStep             String?
  lostReason           CrmLostReason?
  lostReasonDetail     String?
  competitor           String?
  wonAt                DateTime?
  lostAt               DateTime?
  /// When the deal entered its current stage (days in stage on the board).
  stageEnteredAt       DateTime           @default(now())
  status               CrmRecordStatus    @default(ACTIVE)
  lastActivityAt       DateTime           @default(now())
  voidedAt             DateTime?
  voidedBy             String?
  voidReason           String?
  createdBy            String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  history        CrmStageHistory[]
  quotes         CrmQuote[]
  handovers      CrmHandover[]
  activities     CrmActivity[]
  tasks          CrmTask[]
  automationRuns CrmAutomationRun[]

  @@index([organizationId, ownerUserId, status])
  @@index([organizationId, stageId])
  @@index([accountId])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, pipelineId, status])
  @@index([organizationId, status, lastActivityAt])
}

/// Every move of a deal between stages, with who and when. Never changed (the database refuses it).
model CrmStageHistory {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id])
  opportunityId       String
  opportunity         CrmOpportunity @relation(fields: [opportunityId], references: [id])
  fromStageId         String?
  toStageId           String
  changedBy           String
  changedByUserId     String
  changedAt           DateTime       @default(now())
  daysInPreviousStage Int?

  @@index([opportunityId, changedAt])
  @@index([organizationId, toStageId, changedAt])
}

/// Leads in this state (or wanting this service) go to this person.
model CrmAssignmentRule {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  kind           CrmAssignmentKind
  key            String
  /// The key in lower case with single spaces, so "Lagos" and "lagos" are the same rule.
  keyNorm        String
  userId         String
  userName       String
  createdBy      String
  createdAt      DateTime          @default(now())

  @@unique([organizationId, kind, keyNorm])
}

enum CrmLostReason {
  PRICE
  QUALITY
  RELATIONSHIP
  INCUMBENT_RETAINED
  NO_DECISION
  BUDGET
  OTHER
}

enum CrmQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
}

/// A priced bid for a deal: posts, guards and bill rates, with what the guards cost the company and the margin. Only a DRAFT can be changed (the database
/// refuses to change the lines of any other); a new version is made to change a sent quote. The costs are saved with the rule versions they used.
model CrmQuote {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id])
  opportunityId       String
  opportunity         CrmOpportunity @relation(fields: [opportunityId], references: [id])
  /// Shared by every version of the same quote.
  number              String
  versionNo           Int
  status              CrmQuoteStatus @default(DRAFT)
  validUntil          DateTime?      @db.Date
  notes               String?
  monthlyBill         Decimal        @default(0) @db.Decimal(16, 2)
  monthlyCost         Decimal        @default(0) @db.Decimal(16, 2)
  monthlyMargin       Decimal        @default(0) @db.Decimal(16, 2)
  /// Margin as basis points of the bill (905 = 9.05%).
  marginBps           Int            @default(0)
  /// The minimum margin in force when the quote was priced, and whether this quote is below it.
  minMarginBpsAtQuote Int            @default(0)
  belowMinimum        Boolean        @default(false)
  belowMarginApproved Boolean        @default(false)
  approvedBy          String?
  approvedByUserId    String?
  approvedAt          DateTime?
  approvalNote        String?
  createdBy           String
  createdByUserId     String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sentAt              DateTime?
  sentBy              String?
  decidedAt           DateTime?
  decidedBy           String?
  decisionNote        String?

  lines    CrmQuoteLine[]
  handover CrmHandover?

  @@unique([organizationId, number, versionNo])
  @@index([opportunityId, status])
}

model CrmQuoteLine {
  id                  String   @id @default(cuid())
  quoteId             String
  quote               CrmQuote @relation(fields: [quoteId], references: [id])
  sortOrder           Int
  siteName            String
  siteAddress         String?
  postLabel           String?
  /// A label only (24/7, Day 12h): it changes no sum. The headcount is what the client pays for.
  shiftPattern        String?
  salaryStructureId   String
  structureName       String
  businessLine        String
  /// The guards the client pays for (revenue is billed on this).
  headcount           Int
  /// The people actually needed to cover the agreed shifts (cost follows this). Often more than the billed headcount, for example on a 24/7 post.
  requiredPersonnel   Int
  billPerHead         Decimal  @db.Decimal(16, 2)
  operativeSharePct   Decimal  @db.Decimal(5, 2)
  grossPerHead        Decimal  @db.Decimal(16, 2)
  employerCostPerHead Decimal  @db.Decimal(16, 2)
  costPerHead         Decimal  @db.Decimal(16, 2)
  lineBill            Decimal  @db.Decimal(16, 2)
  lineCost            Decimal  @db.Decimal(16, 2)
  lineMargin          Decimal  @db.Decimal(16, 2)
  /// Every part of the employer cost as worked out, so the figure can be explained later.
  costBreakdown       Json
  /// The versions of the pension and employer-cost rules the figures came from.
  ruleVersions        Json
  estimatedOn         DateTime @db.Date

  @@index([quoteId, sortOrder])
}

/// A person formally designated to approve a quote below the minimum margin. Only a designated approver (never the quote's maker) can approve one.
model CrmQuoteApprover {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  userName       String
  active         Boolean      @default(true)
  designatedBy   String
  designatedAt   DateTime     @default(now())
  removedBy      String?
  removedAt      DateTime?

  @@unique([organizationId, userId])
}

enum CrmHandoverStatus {
  DRAFT
  SUBMITTED
  RETURNED
  ACCEPTED
}

enum CrmHandoverEventKind {
  CREATED
  SUBMITTED
  RETURNED
  ACCEPTED
}

/// What an accepted quote hands over to Operations: the agreed scope, the client's requirements, the sites, headcount, shifts, pricing, start date, equipment
/// and service-level obligations. One per deal. Sales prepares and submits it; Operations accepts it (or returns it with questions); only on acceptance are the
/// client, contract (a draft), rates and sites created. The quote facts are copied in and never change; once ACCEPTED nothing can change (the database refuses).
/// It holds no cost and no margin.
model CrmHandover {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id])
  number             String
  opportunityId      String
  opportunity        CrmOpportunity    @relation(fields: [opportunityId], references: [id])
  quoteId            String            @unique
  quote              CrmQuote          @relation(fields: [quoteId], references: [id])
  accountId          String
  status             CrmHandoverStatus @default(DRAFT)
  /// Goes up every time the handover is edited. Operations accepts only the revision it was sent.
  revisionNo         Int               @default(1)
  submittedRevision  Int?
  /// From the accepted quote, copied in: never changes.
  quoteNumber        String
  quoteVersion       Int
  monthlyBill        Decimal           @db.Decimal(16, 2)
  validUntil         DateTime?         @db.Date
  /// Entered in the handover.
  scope              String?
  clientRequirements String?
  startDate          DateTime?         @db.Date
  termMonths         Int?
  /// Special service-level obligations: lines of { obligation, measure, consequence }. noSpecialSla says there are none (an explicit answer).
  serviceLevels      Json              @default("[]")
  noSpecialSla       Boolean           @default(false)
  preparedBy         String
  preparedByUserId   String
  submittedAt        DateTime?
  submittedBy        String?
  submittedByUserId  String?
  returnedAt         DateTime?
  returnedBy         String?
  returnNote         String?
  acceptedAt         DateTime?
  acceptedBy         String?
  acceptedByUserId   String?
  acceptanceNote     String?
  acceptedRevision   Int?
  /// The real records made on acceptance.
  clientId           String?
  contractId         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sites  CrmHandoverSite[]
  posts  CrmHandoverPost[]
  events CrmHandoverEvent[]

  @@unique([organizationId, number])
  @@unique([opportunityId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
}

/// One client site named on the quote. The address, state, local government, the client's site contact and the equipment are entered in the handover.
model CrmHandoverSite {
  id               String            @id @default(cuid())
  handoverId       String
  handover         CrmHandover       @relation(fields: [handoverId], references: [id])
  sortOrder        Int
  name             String
  address          String?
  state            String?
  lga              String?
  contactName      String?
  contactRole      String?
  contactPhoneE164 String?
  contactEmail     String?
  /// Lines of { item, quantity }. noEquipment says none is needed (an explicit answer).
  equipment        Json              @default("[]")
  noEquipment      Boolean           @default(false)
  /// The site (Beat) made on acceptance.
  beatId           String?
  posts            CrmHandoverPost[]

  @@index([handoverId, sortOrder])
}

/// One quote line, copied in with its billed guards, the personnel needed, the shift and the bill rate (never the cost or margin). Only the employee category is entered.
model CrmHandoverPost {
  id                String          @id @default(cuid())
  handoverId        String
  handover          CrmHandover     @relation(fields: [handoverId], references: [id])
  siteId            String
  site              CrmHandoverSite @relation(fields: [siteId], references: [id])
  quoteLineId       String
  sortOrder         Int
  postLabel         String?
  shiftPattern      String?
  salaryStructureId String
  structureName     String
  businessLine      String
  headcount         Int
  requiredPersonnel Int
  billPerHead       Decimal         @db.Decimal(16, 2)
  operativeSharePct Decimal         @db.Decimal(5, 2)
  /// The employee category the contract rate is made for (entered).
  categoryId        String?

  @@index([handoverId, sortOrder])
}

/// Who did what to a handover and when: submitted, returned (with the question), accepted. Never changed (the database refuses it).
model CrmHandoverEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  handoverId     String
  handover       CrmHandover          @relation(fields: [handoverId], references: [id])
  kind           CrmHandoverEventKind
  revisionNo     Int
  byUserId       String
  byName         String
  note           String?
  at             DateTime             @default(now())

  @@index([handoverId, at])
}

/// A person formally designated to accept a handover for Operations (the Executive Director, Operations, or the Operations Manager). Never the person who prepared it.
model CrmHandoverAcceptor {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  userName       String
  active         Boolean      @default(true)
  designatedBy   String
  designatedAt   DateTime     @default(now())
  removedBy      String?
  removedAt      DateTime?

  @@unique([organizationId, userId])
}

enum CrmActivityKind {
  CALL
  MEETING
  SITE_SURVEY
  WHATSAPP
  EMAIL
  NOTE
}

enum CrmCallOutcome {
  REACHED
  NO_ANSWER
  CALLBACK
  WRONG_NUMBER
}

/// Whether an outbound message is a service message (about an active contract) or marketing (needs the person's consent).
enum CrmMessagePurpose {
  SERVICE
  MARKETING
}

enum CrmTaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Something that happened with a lead, contact, account or deal: a call, meeting, site survey, WhatsApp, email or note. Never deleted and its content never
/// changed (the database refuses both); a mistaken one is voided with a reason and stays on the timeline.
model CrmActivity {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id])
  kind            CrmActivityKind
  leadId          String?
  lead            CrmLead?           @relation(fields: [leadId], references: [id])
  accountId       String?
  account         CrmAccount?        @relation(fields: [accountId], references: [id])
  contactId       String?
  contact         CrmContact?        @relation(fields: [contactId], references: [id])
  opportunityId   String?
  opportunity     CrmOpportunity?    @relation(fields: [opportunityId], references: [id])
  occurredAt      DateTime           @default(now())
  subject         String?
  body            String?
  /// A call's result; empty while a call started from a link has not yet been written up.
  callOutcome     CrmCallOutcome?
  /// A site survey's checklist: site type, entry points, existing guards, risk notes, photo links.
  survey          Json?
  /// For a WhatsApp or an email: service or marketing.
  purpose         CrmMessagePurpose?
  /// Logged automatically by using a call or WhatsApp link.
  viaLink         Boolean            @default(false)
  createdBy       String
  createdByUserId String
  createdAt       DateTime           @default(now())
  voidedAt        DateTime?
  voidedBy        String?
  voidReason      String?

  @@index([organizationId, leadId, occurredAt])
  @@index([organizationId, accountId, occurredAt])
  @@index([organizationId, contactId, occurredAt])
  @@index([organizationId, opportunityId, occurredAt])
  @@index([organizationId, occurredAt])
}

/// Something to do, by a date and time, for one person, optionally about a lead, contact, account or deal.
model CrmTask {
  id              String          @id @default(cuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id])
  title           String
  notes           String?
  dueAt           DateTime
  /// Brings the task into that morning's digest; there is no push notification.
  reminderAt      DateTime?
  status          CrmTaskStatus   @default(OPEN)
  ownerUserId     String
  ownerName       String
  leadId          String?
  lead            CrmLead?        @relation(fields: [leadId], references: [id])
  accountId       String?
  account         CrmAccount?     @relation(fields: [accountId], references: [id])
  contactId       String?
  contact         CrmContact?     @relation(fields: [contactId], references: [id])
  opportunityId   String?
  opportunity     CrmOpportunity? @relation(fields: [opportunityId], references: [id])
  completedAt     DateTime?
  completedBy     String?
  createdBy       String
  createdByUserId String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([organizationId, ownerUserId, status, dueAt])
  @@index([opportunityId])
  @@index([leadId])
  @@index([contactId])
  @@index([accountId])
}

/// One row for each user and day the digest email was sent, so it is never sent twice in a day.
model CrmDigestRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  /// The Lagos day it was for.
  forDate        DateTime     @db.Date
  sentAt         DateTime     @default(now())

  @@unique([organizationId, userId, forDate])
}

enum CrmAutomationTrigger {
  STAGE_ENTRY
  QUOTE_ACCEPTED
  HANDOVER_ACCEPTED
  NO_ACTIVITY
}

enum CrmAutomationAction {
  CREATE_TASK
  NOTIFY
  SEND_EMAIL
  CHANGE_OWNER
  SET_FIELD
  CREATE_FOLLOW_UP
  MOVE_TO_STAGE
}

enum CrmAutomationRunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  CANCELLED
  SKIPPED
}

/// When something happens to a deal (it enters a stage, its quote or handover is accepted, or it goes quiet), do one thing, at once or after a delay,
/// if the condition holds. Starts switched off. Changed by switching it off and making a new one, so the run log stays true.
model CrmAutomationRule {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  name           String
  trigger        CrmAutomationTrigger
  pipelineId     String
  pipeline       CrmPipeline          @relation(fields: [pipelineId], references: [id])
  /// For a stage-entry rule: the stage.
  stageId        String?
  stage          CrmStage?            @relation(fields: [stageId], references: [id])
  /// How long after the trigger the action runs (0 = at once).
  delayMinutes   Int                  @default(0)
  /// For a no-activity rule: how many quiet days.
  quietDays      Int?
  /// { field, op, value }: the rule acts only if it holds when the run is due.
  condition      Json?
  actionType     CrmAutomationAction
  actionParams   Json
  enabled        Boolean              @default(false)
  /// One of the rules offered to every organization (all start off).
  isStarter      Boolean              @default(false)
  createdBy      String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  updatedBy      String?

  runs CrmAutomationRun[]

  @@index([organizationId, trigger, enabled])
}

/// One carrying-out of a rule for a deal and a stage entry (or quote, handover, quiet spell). The database allows one per rule, deal and entry, so a rule never
/// fires twice for the same entry. Holds ids and figures, never message text.
model CrmAutomationRun {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  ruleId         String
  rule           CrmAutomationRule      @relation(fields: [ruleId], references: [id])
  opportunityId  String
  opportunity    CrmOpportunity         @relation(fields: [opportunityId], references: [id])
  /// What this run is for: the stage-history row of the entry, the quote or handover, or the last-activity moment of a quiet spell.
  entryKey       String
  status         CrmAutomationRunStatus @default(PENDING)
  runAt          DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  durationMs     Int?
  inputs         Json?
  outputs        Json?
  error          String?
  createdAt      DateTime               @default(now())

  @@unique([ruleId, opportunityId, entryKey])
  @@index([organizationId, status, runAt])
  @@index([organizationId, createdAt])
}

/// A message to a person inside the app (the email goes separately).
model CrmNotification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  title          String
  body           String
  href           String?
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([organizationId, userId, readAt])
  @@index([organizationId, userId, createdAt])
}

enum CrmCasePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum CrmCaseCategory {
  SERVICE_QUALITY
  STAFFING
  BILLING
  COMPLAINT
  REQUEST
  OTHER
}

enum CrmCaseStatus {
  OPEN
  RESOLVED
}

enum CrmCaseEventKind {
  OPENED
  RESPONDED
  NOTE
  REASSIGNED
  RESOLVED
  REOPENED
  WARNING
  BREACH
  ESCALATED
}

/// How quickly a case of a priority must be answered and resolved. A policy for an account wins over the organization's default for that priority.
model CrmSlaPolicy {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id])
  /// Empty for the organization's default.
  accountId            String?
  account              CrmAccount?     @relation(fields: [accountId], references: [id])
  /// The account's id, or empty for the default: lets the database allow one policy for each account and priority.
  accountKey           String          @default("")
  priority             CrmCasePriority
  firstResponseMinutes Int
  resolutionMinutes    Int
  /// The clock runs only in business hours (not at night, at weekends or on holidays).
  businessHoursOnly    Boolean         @default(true)
  active               Boolean         @default(true)
  createdBy            String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  updatedBy            String?

  @@unique([organizationId, accountKey, priority])
}

/// When the organization is open, in Lagos time. Without a row: Monday to Friday, 08:00 to 17:00.
model CrmBusinessHours {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id])
  openMinute     Int          @default(480)
  closeMinute    Int          @default(1020)
  /// ISO weekdays, 1 = Monday to 7 = Sunday.
  workDays       Int[]        @default([1, 2, 3, 4, 5])
  updatedBy      String
  updatedAt      DateTime     @updatedAt
}

/// A day the organization is closed. Entered by an administrator: public holidays differ by year and are announced by government.
model CrmHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  name           String
  createdBy      String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
}

/// A problem or request from a client account. The SLA deadlines are worked out when it opens and kept on the case, so a later change to a policy never moves them.
model CrmCase {
  id                      String          @id @default(cuid())
  organizationId          String
  organization            Organization    @relation(fields: [organizationId], references: [id])
  number                  String
  accountId               String
  account                 CrmAccount      @relation(fields: [accountId], references: [id])
  contactId               String?
  opportunityId           String?
  /// The client site (Beat) it is about, if any.
  beatId                  String?
  category                CrmCaseCategory
  priority                CrmCasePriority
  status                  CrmCaseStatus   @default(OPEN)
  subject                 String
  description             String?
  ownerUserId             String
  ownerName               String
  openedAt                DateTime        @default(now())
  slaPolicyId             String?
  slaFirstResponseMinutes Int?
  slaResolutionMinutes    Int?
  slaBusinessHoursOnly    Boolean         @default(false)
  firstResponseDueAt      DateTime?
  firstResponseWarnAt     DateTime?
  firstRespondedAt        DateTime?
  firstResponseWarnedAt   DateTime?
  firstResponseBreachedAt DateTime?
  /// When the resolution clock last started: the opening, or the latest reopening.
  resolutionStartedAt     DateTime        @default(now())
  resolutionDueAt         DateTime?
  resolutionWarnAt        DateTime?
  resolvedAt              DateTime?
  resolutionWarnedAt      DateTime?
  resolutionBreachedAt    DateTime?
  /// Reported separately, so closing cases early is not rewarded.
  reopenedCount           Int             @default(0)
  createdBy               String
  createdByUserId         String
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  events CrmCaseEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status, priority])
  @@index([organizationId, accountId])
  @@index([organizationId, openedAt])
  @@index([contactId])
}

/// Everything that happens to a case, in order. Never changed (the database refuses it).
model CrmCaseEvent {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  caseId         String
  case           CrmCase          @relation(fields: [caseId], references: [id])
  kind           CrmCaseEventKind
  byUserId       String?
  byName         String
  note           String?
  at             DateTime         @default(now())

  @@index([caseId, at])
}

/// The renewal deal opened for a contract: one for each contract, so the daily job can never open two.
model CrmRenewalLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  contractId     String       @unique
  opportunityId  String
  createdAt      DateTime     @default(now())
}

enum CrmHealthBand {
  HEALTHY
  WATCH
  AT_RISK
}

/// The latest health score of a client account (0 to 100) with what each measure found, and when its band last changed. Recomputed nightly and when a case on the account changes.
model CrmAccountHealth {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  accountId      String         @unique
  account        CrmAccount     @relation(fields: [accountId], references: [id])
  score          Int
  band           CrmHealthBand
  /// Each measure: its weight, its sub-score (empty when there was no data), and a sentence on what it found.
  components     Json
  previousBand   CrmHealthBand?
  bandChangedAt  DateTime?
  computedAt     DateTime

  @@index([organizationId, band, score])
}

enum CrmSuppressionKind {
  EMAIL
  PHONE
}

enum CrmDataRequestKind {
  ACCESS
  ERASURE
  RETENTION
}

enum CrmDataRequestStatus {
  OPEN
  COMPLETED
  REFUSED
}

/// An email address or phone number that must receive no marketing, kept as a KEYED HASH (never the address), so it still works after the person has been erased.
model CrmSuppression {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  kind           CrmSuppressionKind
  valueHash      String
  /// UNSUBSCRIBED, WITHDRAWN or ERASED.
  reason         String
  source         String
  createdAt      DateTime           @default(now())

  @@unique([organizationId, kind, valueHash])
}

/// A request about the personal data held on a contact or lead: a copy (ACCESS), erasure (ERASURE), or erasure at the end of the retention period (RETENTION).
model CrmDataRequest {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id])
  number           String
  kind             CrmDataRequestKind
  /// CONTACT or LEAD.
  subjectType      String
  subjectId        String
  /// Who asked: replaced with a note once the person has been erased.
  requesterName    String?
  channel          String?
  receivedOn       DateTime             @db.Date
  dueOn            DateTime             @db.Date
  status           CrmDataRequestStatus @default(OPEN)
  identityVerified Boolean              @default(false)
  identityNote     String?
  verifiedBy       String?
  /// Who recorded the identity check (by id, so the person who erases can be told apart from them).
  verifiedByUserId String?
  exportedAt       DateTime?
  /// SHA-256 of the file generated, and how many records each section held.
  exportChecksum   String?
  exportSections   Json?
  /// Records that may still mention the person in free text and need a person's review after an erasure (ids by kind, never the text).
  reviewList       Json?
  handledBy        String?
  completedOn      DateTime?
  outcomeNote      String?
  createdBy        String
  createdAt        DateTime             @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, subjectType, subjectId])
}

/// A sales team: one manager (a sales manager) and its members. A team is closed, not deleted; closing it removes its members.
model CrmTeam {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  name             String
  managerUserId    String
  active           Boolean         @default(true)
  /// Where this team's round robin has got to: each new lead a manager adds goes to the next member.
  assignmentCursor Int             @default(0)
  createdBy        String
  createdAt        DateTime        @default(now())
  members          CrmTeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId, managerUserId, active])
}

/// A person in a team. A person is in at most one team.
model CrmTeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  teamId         String
  team           CrmTeam      @relation(fields: [teamId], references: [id])
  userId         String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([teamId])
}

// ───────────────────────────── Modules, plans and subscriptions (docs/plans/module-entitlements-e2.md) ─────────────────────────────
// What each company has bought. The catalogue (src/lib/entitlements/catalogue.ts) says what a module is; these tables say who has which, from when to when.
// Nothing reads them to switch anything on or off yet (that is a later step).

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  ENDED
}

enum SubscriptionModuleSource {
  PLAN
  ADD_ON
  /// Given to a company that existed before subscriptions did, so nothing it used stopped; to be reviewed and given a real plan.
  GRANDFATHERED
}

/// One per company. Changed only by platform staff, or by a bureau for its own clients; a company cannot change its own.
model Subscription {
  id               String             @id @default(cuid())
  organizationId   String             @unique
  organization     Organization       @relation(fields: [organizationId], references: [id])
  /// A key of PLANS in the catalogue.
  planKey          String
  status           SubscriptionStatus @default(ACTIVE)
  /// The catalogue version the plan was chosen from.
  catalogueVersion String
  /// Stored now and checked in a later step. Empty means no limit.
  employeeLimit    Int?
  crmUserLimit     Int?
  createdBy        String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  modules SubscriptionModule[]
  events  SubscriptionEvent[]
}

/// A module a company has, with the days it was on. A module that is taken away is given an end date, never deleted, so what a company had on any day can be answered.
model SubscriptionModule {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  subscriptionId String
  subscription   Subscription             @relation(fields: [subscriptionId], references: [id])
  /// A key of MODULES in the catalogue.
  moduleKey      String
  source         SubscriptionModuleSource
  startsOn       DateTime
  endsOn         DateTime?
  /// After the end date the module's data can still be read until this day (a later step); empty means not at all.
  readOnlyUntil  DateTime?
  createdAt      DateTime                 @default(now())

  @@index([subscriptionId, moduleKey])
  @@index([organizationId])
}

/// Every change to a subscription: append-only at the database (a trigger refuses any update or delete). Keys and plan names only; nothing personal.
model SubscriptionEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  /// CREATED, PLAN_CHANGED, MODULE_ADDED, MODULE_REMOVED, LIMITS_CHANGED or GRANDFATHERED.
  kind           String
  reason         String?
  byUserId       String?
  byName         String
  detail         Json?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
  @@index([organizationId])
}

/// What was proposed to a prospect: the plan and modules chosen from the answers to the configurator's questions, and why. Kept so that what the client was told can be shown later.
model ClientBlueprint {
  id                        String       @id @default(cuid())
  /// The selling organization (the bureau or company that made the proposal), not the prospect.
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id])
  /// The bureau's own lead and proposal this blueprint is for (ThreeRoots sells through its own pipeline, not a company's sales module).
  leadId                    String?
  lead                      Lead?        @relation(fields: [leadId], references: [id])
  proposalId                String?
  proposal                  Proposal?    @relation(fields: [proposalId], references: [id])
  prospectName              String
  planKey                   String
  modules                   Json
  answers                   Json
  reasons                   Json
  /// Everything the configurator computed (plan, add-ons, runner-up, notes, limits), as it was when saved.
  configured                Json         @default("{}")
  /// The quote as it was given, with the price book version it used. A snapshot: a later price change never rewrites it.
  quote                     Json?
  /// DRAFT, SENT, ACCEPTED or DROPPED.
  status                    String       @default("DRAFT")
  /// Set once, when the blueprint is applied to the client it became (its plan, add-ons and limits become that client's subscription). The client's id is kept as text: a blueprint is a record.
  provisionedAt             DateTime?
  provisionedOrganizationId String?
  createdBy                 String
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@index([proposalId])
}

// ───────────────────────────── The module switch (docs/plans/module-entitlements-e3.md, step E3b) ─────────────────────────────
// Platform-wide, not per company: whether a company's modules are checked at all, module by module. No row means OFF.

enum EntitlementMode {
  OFF
  /// Let the request through and log that it would have been refused.
  REPORT
  /// Refuse a company that did not buy the module.
  ENFORCE
}

/// One row per module that is not OFF. Changed only by platform staff, and not turned on while a company has no subscription.
model EntitlementSwitch {
  moduleKey String          @id
  mode      EntitlementMode
  updatedBy String
  updatedAt DateTime        @updatedAt
}

/// Every change to the switch: append-only at the database (a trigger refuses any update or delete). Module keys and modes only, nothing personal.
model EntitlementSwitchEvent {
  id        String          @id @default(cuid())
  moduleKey String
  fromMode  EntitlementMode
  toMode    EntitlementMode
  reason    String
  byUserId  String?
  byName    String
  createdAt DateTime        @default(now())

  @@index([createdAt])
}

// ───────────────────────────── The software price book (docs/plans/module-entitlements-e4.md, step E4b) ─────────────────────────────
// What the platform charges for each module, as dated versions: platform-wide, not per company. Starts EMPTY: every amount is the founder's, entered through the screen.
// A version needs a second person to verify it, and once verified it can never be changed or deleted (a trigger refuses): a price change is a new version from a later date.

model SoftwarePriceBook {
  id               String    @id @default(cuid())
  /// An ISO currency code from CURRENCIES in src/lib/money.ts.
  currency         String    @default("NGN")
  effectiveFrom    DateTime  @db.Date
  /// The least the whole monthly quote can be; 0 for none.
  minimumMonthly   Decimal   @default(0) @db.Decimal(16, 2)
  note             String?
  createdBy        String
  createdByUserId  String
  createdAt        DateTime  @default(now())
  /// Set by a second person; the database refuses the maker, and refuses any change to a version once this is set.
  verifiedBy       String?
  verifiedByUserId String?
  verifiedAt       DateTime?

  lines SoftwarePriceLine[]

  @@unique([currency, effectiveFrom])
}

/// One price in a version: per employee, per CRM user or flat, per month, by the way the catalogue charges the module (kept here so a later change in how a module is charged cannot silently reinterpret an old price).
model SoftwarePriceLine {
  id        String            @id @default(cuid())
  bookId    String
  book      SoftwarePriceBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  moduleKey String
  /// active_employee, crm_user or flat.
  basis     String
  amount    Decimal           @db.Decimal(16, 2)

  @@unique([bookId, moduleKey])
}

/// A pension fund administrator on a company's own list (Settings → Pension fund administrators). The company administrator and the HR manager keep it; an employee's `pfa` (still the name, as typed on payroll records and schedules) is chosen from it.
/// Switching one off stops it being chosen for anyone new; the people who already have it keep it. The PenCom number is the regulator's licence number for the PFA, recorded for the company's reference.
model PensionFundAdministrator {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  penComNumber   String?
  active         Boolean      @default(true)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
}

enum PaidDaysBasis {
  CALENDAR_DAYS
  WORKING_DAYS
}

/// How a contract's pay is divided over the month, as agreed with the client (docs/plans/paid-days-basis.md). Effective-dated from the first day of a pay month; PROPOSED by someone who manages clients and
/// APPROVED by a second person (the payroll manager) before it counts. A contract with no approved row keeps the company's payroll rule, so nothing existing changes.
model ContractPayBasis {
  id                    String                @id @default(cuid())
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id])
  contractId            String
  contract              Contract              @relation(fields: [contractId], references: [id])
  basis                 PaidDaysBasis
  /// Working-days basis only: the confirmed public holidays are not working days (work on them is overtime).
  excludePublicHolidays Boolean               @default(false)
  /// Working-days basis only: 5 = Monday to Friday, 6 = Monday to Saturday, 7 = every day. Empty: the company's "working days per week" in the leave policy.
  workingDaysPerWeek    Int?
  effectiveFrom         DateTime              @db.Date
  effectiveTo           DateTime?             @db.Date
  reason                String
  status                PayRateProposalStatus @default(PENDING)
  proposedBy            String
  proposedByUserId      String
  createdAt             DateTime              @default(now())
  decidedBy             String?
  decidedByUserId       String?
  decidedAt             DateTime?
  decisionNote          String?

  @@index([organizationId, contractId, status])
}

/// A public holiday the company has entered (some are announced each year, so the dates are the company's data, never in the code).
model PublicHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  date           DateTime     @db.Date
  name           String
  createdBy      String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, date])
}

/// The company's confirmation that its list of public holidays for a year is complete and right. A contract that excludes public holidays cannot be paid cleanly for a month in an unconfirmed year.
model HolidayCalendarYear {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  year              Int
  confirmedBy       String
  confirmedByUserId String
  confirmedAt       DateTime     @default(now())

  @@unique([organizationId, year])
}

// ─────────────────────────── CONTINUOUS FEEDBACK ───────────────────────────

enum FeedbackKind {
  RECOGNITION
  COACHING
}

/// A short, dated note about an employee from their reporting manager or HR. The employee always sees it (no private notes about performance) and may reply once.
/// Never edited: a mistake is voided with a reason, and kept. It changes no pay, status, discipline or appraisal score.
model PerformanceFeedback {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id])
  authorUserId     String
  authorName       String
  authorEmployeeId String?
  kind             FeedbackKind
  body             String
  /// The day the feedback is about (not in the future).
  relatesOn        DateTime     @db.Date
  employeeReply    String?
  employeeReplyAt  DateTime?
  voidedAt         DateTime?
  voidedByUserId   String?
  voidedBy         String?
  voidReason       String?
  createdAt        DateTime     @default(now())

  @@index([organizationId, employeeId, relatesOn])
  @@index([organizationId, authorUserId])
}

// ─────────────────────────── PERFORMANCE IMPROVEMENT PLANS ───────────────────────────

enum PipStatus {
  DRAFT
  AWAITING_APPROVAL
  ACTIVE
  OUTCOME_PROPOSED
  CLOSED
  WITHDRAWN
}

enum PipOutcome {
  SUCCESSFUL
  EXTENDED
  UNSUCCESSFUL
}

enum PipObjectiveResult {
  OPEN
  MET
  PARTLY_MET
  NOT_MET
}

/// A structured plan to bring an employee's performance up to the standard (capability, not conduct: it is not a sanction and changes no pay or status).
/// Drafted by HR, started by a second person, reviewed at milestones, and closed with an outcome that a second person approves. At most one open plan per employee (checked in the service).
model PerformanceImprovementPlan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])
  /// The appraisal this plan was started from, if any (a plan is never started automatically by an appraisal).
  appraisalId    String?
  appraisal      Appraisal?   @relation(fields: [appraisalId], references: [id])
  status         PipStatus    @default(DRAFT)
  concerns       String
  startDate      DateTime     @db.Date
  endDate        DateTime     @db.Date
  originalEndDate DateTime    @db.Date
  extensionsUsed Int          @default(0)
  ownerUserId    String
  ownerName      String
  draftedByUserId String
  draftedBy      String
  submittedAt    DateTime?
  activatedAt    DateTime?
  activatedByUserId String?
  activatedBy    String?
  activationNote String?
  returnNote     String?
  nextReviewDue  DateTime?    @db.Date
  proposedOutcome PipOutcome?
  proposedEndDate DateTime?   @db.Date
  proposedNote   String?
  proposedByUserId String?
  proposedBy     String?
  proposedAt     DateTime?
  outcome        PipOutcome?
  outcomeNote    String?
  outcomeApprovedByUserId String?
  outcomeApprovedBy String?
  closedAt       DateTime?
  withdrawnAt    DateTime?
  withdrawnBy    String?
  withdrawReason String?
  acknowledgedAt DateTime?
  employeeAgreed Boolean?
  employeeResponse String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  objectives PipObjective[]
  reviews    PipReview[]

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
  @@index([ownerUserId])
}

/// One thing the employee is to put right: the gap, the measurable target, the support the company gives, and when.
model PipObjective {
  id             String                     @id @default(cuid())
  organizationId String
  organization   Organization               @relation(fields: [organizationId], references: [id])
  planId         String
  plan           PerformanceImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  sortOrder      Int                        @default(0)
  gap            String
  target         String
  support        String?
  dueDate        DateTime                   @db.Date
  createdAt      DateTime                   @default(now())

  assessments PipReviewAssessment[]

  @@index([planId])
}

/// A review at a milestone. Append-only: once recorded it is never edited (the employee may add one comment of their own).
model PipReview {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id])
  planId            String
  plan              PerformanceImprovementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewedOn        DateTime                   @db.Date
  summary           String
  recordedByUserId  String
  recordedBy        String
  employeeComment   String?
  employeeCommentAt DateTime?
  createdAt         DateTime                   @default(now())

  assessments PipReviewAssessment[]

  @@index([planId, reviewedOn])
}

model PipReviewAssessment {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  reviewId       String
  review         PipReview          @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      PipObjective       @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  result         PipObjectiveResult
  note           String?

  @@unique([reviewId, objectiveId])
  @@index([objectiveId])
}

// ─────────────────────────── PROBATION DECISIONS ───────────────────────────

/// One probation decision (confirm, extend or fail), append-only: who, when, why, and a snapshot of the probation appraisal that supported it.
/// The contract keeps its current outcome (probationOutcome) exactly as before; this is the history behind it.
model ProbationDecision {
  id                        String                   @id @default(cuid())
  organizationId            String
  organization              Organization             @relation(fields: [organizationId], references: [id])
  employeeId                String
  employee                  Employee                 @relation(fields: [employeeId], references: [id])
  contractId                String
  contract                  EmploymentContract       @relation(fields: [contractId], references: [id])
  decision                  ProbationOutcome
  decidedByUserId           String
  decidedBy                 String
  decidedAt                 DateTime                 @default(now())
  note                      String?
  /// Confirm: months not used. Extend: the months added.
  extensionMonths           Int?
  /// Confirm: the date the permanent contract starts. Extend: the new probation end date. Fail: none.
  effectiveDate             DateTime?                @db.Date
  /// The signed-off probation appraisal behind the decision, as it stood then (no foreign key: a snapshot).
  appraisalId               String?
  /// Its overall score in hundredths (3.80 = 380).
  appraisalScore            Int?
  appraisalRecommendation   AppraisalRecommendation?
  /// The decision went against that recommendation (and so carried the fuller reason).
  againstRecommendation     Boolean                  @default(false)
  /// When HR told the employee: only then does the employee see a line about it.
  informedAt                DateTime?
  informedBy                String?
  /// The review (recommendation, HR review) this decision completed, when the workflow is on.
  reviewId                  String?                  @unique
  review                    ProbationReview?         @relation(fields: [reviewId], references: [id])

  @@index([organizationId, employeeId])
  @@index([contractId, decidedAt])
}

enum ProbationRecommendation {
  CONFIRM
  EXTEND
  NOT_CONFIRM
}

enum ProbationReviewStatus {
  /// The reporting manager has recommended; HR has not reviewed it yet.
  RECOMMENDED
  /// HR returned it to the manager; a new round starts with a new recommendation.
  RETURNED
  /// HR forwarded it to the independent decider.
  FORWARDED
  /// The decider decided (the contract changed through the existing decision).
  DECIDED
}

/// One round of the probation workflow: the manager's recommendation, HR's review, the decision, the feedback the employee receives and their one response. Each step fills its own
/// fields once and is never overwritten; a returned recommendation stays as it was and a new round is a new row.
model ProbationReview {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee                @relation(fields: [employeeId], references: [id])
  contractId     String
  contract       EmploymentContract      @relation(fields: [contractId], references: [id])
  round          Int
  status         ProbationReviewStatus   @default(RECOMMENDED)

  recommendation      ProbationRecommendation
  /// For Extend: the months proposed.
  recommendedMonths   Int?
  recommendationNote  String
  recommendedByUserId String
  recommendedBy       String
  recommendedAt       DateTime                @default(now())
  /// HR recorded it because the employee has no reporting manager.
  recordedByHr        Boolean                 @default(false)

  reviewNote       String?
  reviewedByUserId String?
  reviewedBy       String?
  reviewedAt       DateTime?
  /// What the policy checks showed when HR reviewed it (null = not applicable or not reviewed yet).
  appraisalSignedOff Boolean?
  minScoreMet        Boolean?
  withinMaxMonths    Boolean?

  decision                     ProbationDecision?
  decidedAt                    DateTime?
  /// The decision was not the one the manager recommended (and so carried the fuller reason).
  decidedAgainstRecommendation Boolean            @default(false)

  /// The statement the employee receives (separate from the internal reason).
  feedbackText     String?
  feedbackByUserId String?
  feedbackAt       DateTime?

  responseAgreed Boolean?
  responseText   String?
  respondedAt    DateTime?
  /// The decider recorded that they read the response.
  responseReadByUserId String?
  responseReadBy       String?
  responseReadAt       DateTime?

  @@unique([contractId, round])
  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

/// A user the Company Administrator designated to make final probation decisions (for example a department head), optionally for one department. The Company Administrator and platform staff
/// may always decide. Live until revoked.
model ProbationDecider {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id])
  reason          String
  grantedByUserId String
  grantedBy       String
  grantedAt       DateTime     @default(now())
  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       String?
  revokeReason    String?

  @@index([organizationId, userId])
}

// ─────────────────────────── TRAINING NEEDS AND CALENDAR ───────────────────────────

enum TrainingSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TrainingAttendance {
  ENROLLED
  ATTENDED
  ABSENT
}

enum TrainingNeedSource {
  COMPLIANCE
  APPRAISAL
  REQUEST
  OTHER
}

enum TrainingNeedStatus {
  OPEN
  PLANNED
  MET
  DROPPED
}

enum TrainingPriority {
  LOW
  NORMAL
  HIGH
}

/// A course the company runs or buys. Its name is the course name a certificate carries, so attending a session of it satisfies a required course of the same name.
model TrainingProgramme {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  provider       String?
  /// How long the certificate stays valid, in months (null = it does not expire).
  validityMonths Int?
  active         Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())

  sessions TrainingSession[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// A dated occurrence of a programme, with seats (a hard limit; no waiting list).
model TrainingSession {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  programmeId     String
  programme       TrainingProgramme     @relation(fields: [programmeId], references: [id])
  sessionDate     DateTime              @db.Date
  startTime       String?
  venue           String?
  trainer         String?
  seats           Int
  status          TrainingSessionStatus @default(SCHEDULED)
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdBy       String
  createdAt       DateTime              @default(now())

  enrolments TrainingEnrolment[]

  @@index([organizationId, sessionDate])
  @@index([programmeId])
}

/// One person in one session, and whether they attended. Marking Attended creates the certificate record (EmployeeTraining.enrolmentId).
model TrainingEnrolment {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  sessionId      String
  session        TrainingSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id])
  status         TrainingAttendance @default(ENROLLED)
  absenceReason  String?
  enrolledBy     String
  markedBy       String?
  markedAt       DateTime?
  createdAt      DateTime           @default(now())

  certificate EmployeeTraining?
  evaluations TrainingEvaluation[]

  @@unique([sessionId, employeeId])
  @@index([organizationId, employeeId])
}

/// A person who needs a course: from a compliance gap, an appraisal recommendation, a request or anything else. Added by HR, never automatically.
model TrainingNeed {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id])
  courseName     String
  source         TrainingNeedSource
  note           String?
  priority       TrainingPriority   @default(NORMAL)
  dueBy          DateTime?          @db.Date
  status         TrainingNeedStatus @default(OPEN)
  /// The appraisal it came from, if any (no foreign key: a reference only).
  appraisalId    String?
  droppedReason  String?
  metAt          DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  /// The manager's request this need came from, if it did.
  request        TrainingRequest?

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── WELFARE AND RECOGNITION ───────────────────────────

enum WelfareKind {
  BEREAVEMENT
  FINANCIAL_HARDSHIP
  HEALTH_WELLBEING
  FAMILY
  HOUSING_TRANSPORT
  OTHER
}

enum RecognitionStatus {
  NOMINATED
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A kind of award the company gives (Employee of the month, Safety star, 5 years' service). The company starts with none. Handles no money.
model RecognitionAwardType {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  name             String
  description      String?
  /// For a long-service award: the years it marks (a prompt for HR; never awarded automatically).
  longServiceYears Int?
  /// Whether an approved award of this kind may appear on the recognition board, if the recipient agrees.
  mayAnnounce      Boolean      @default(false)
  active           Boolean      @default(true)
  createdBy        String
  createdAt        DateTime     @default(now())

  awards RecognitionAward[]

  @@unique([organizationId, name])
  @@index([organizationId, active])
}

/// A nomination and, once a second person approves it, an award. Never edited: a mistake is a withdrawal with a reason.
model RecognitionAward {
  id                String               @id @default(cuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee             @relation(fields: [employeeId], references: [id])
  typeId            String
  type              RecognitionAwardType @relation(fields: [typeId], references: [id])
  citation          String
  status            RecognitionStatus    @default(NOMINATED)
  nominatedByUserId String
  nominatedBy       String
  nominatedAt       DateTime             @default(now())
  decidedByUserId   String?
  decidedBy         String?
  decidedAt         DateTime?
  /// The reason for a rejection.
  decisionNote      String?
  awardedOn         DateTime?            @db.Date
  withdrawnByUserId String?
  withdrawnBy       String?
  withdrawnAt       DateTime?
  withdrawReason    String?
  /// The recipient's answer to being shown on the recognition board (null = not asked or not answered).
  announceAgreed    Boolean?
  announceAnsweredAt DateTime?

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

enum PromotionStatus {
  PROPOSED
  APPROVED
  DECLINED
  WITHDRAWN
  APPLIED
}

enum SuccessionReadiness {
  READY_NOW
  READY_1_2_YEARS
  READY_3_PLUS
}

enum SuccessionStatus {
  PROPOSED
  APPROVED
}

/// A move the company says one role (employee category) can lead to, with what it asks first. Guidance only: it warns, it never blocks a proposal.
model CareerPath {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  fromCategoryId  String
  fromCategory    EmployeeCategory @relation("CareerPathFrom", fields: [fromCategoryId], references: [id])
  toCategoryId    String
  toCategory      EmployeeCategory @relation("CareerPathTo", fields: [toCategoryId], references: [id])
  /// Months of service in the current role the company asks for (null = none asked).
  minMonths       Int?
  /// A course (by its training-requirement name) the company asks for (null = none asked).
  requiredCourse  String?
  active          Boolean          @default(true)
  createdBy       String
  createdAt       DateTime         @default(now())

  @@unique([organizationId, fromCategoryId, toCategoryId])
  @@index([organizationId, active])
}

/// A proposal that an employee moves to another role (category), and the decision on it. A record of a decision only: approving it changes no category, pay or payroll figure.
model PromotionProposal {
  id                String            @id @default(cuid())
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee          @relation(fields: [employeeId], references: [id])
  fromCategoryId    String
  fromCategory      EmployeeCategory  @relation("PromotionFrom", fields: [fromCategoryId], references: [id])
  toCategoryId      String
  toCategory        EmployeeCategory  @relation("PromotionTo", fields: [toCategoryId], references: [id])
  reason            String
  intendedOn        DateTime          @db.Date
  status            PromotionStatus   @default(PROPOSED)
  /// The warning codes that applied when it was proposed (never text).
  warnings          String[]          @default([])
  proposedByUserId  String
  proposedBy        String
  proposedAt        DateTime          @default(now())
  decidedByUserId   String?
  decidedBy         String?
  decidedAt         DateTime?
  /// The reason for a decline, or for approving despite a warning.
  decisionNote      String?
  withdrawnByUserId String?
  withdrawnBy       String?
  withdrawnAt       DateTime?
  withdrawReason    String?
  appliedByUserId   String?
  appliedBy         String?
  appliedAt         DateTime?

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

/// A critical role (an employee category) the HR administrator keeps successors for. Read only by the HR administrator.
model SuccessionRole {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])
  categoryId     String
  category       EmployeeCategory      @relation(fields: [categoryId], references: [id])
  active         Boolean               @default(true)
  createdBy      String
  createdAt      DateTime              @default(now())

  candidates SuccessionCandidate[]

  @@unique([organizationId, categoryId])
}

/// One named successor for a critical role, with how ready they are. Kept by a person; nothing is scored or suggested.
model SuccessionCandidate {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id])
  roleId         String
  role           SuccessionRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id])
  readiness      SuccessionReadiness
  reason         String?
  createdBy      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  /// A new nomination is PROPOSED until a different holder of the succession function approves it, and counts only once APPROVED. Every row before this rule is APPROVED.
  status         SuccessionStatus    @default(APPROVED)
  proposedByUserId String?
  decidedByUserId  String?
  decidedAt        DateTime?
  /// Approved by the person who proposed it, being the only holder (flagged, with the reason kept).
  singleHolder     Boolean             @default(false)
  singleReason     String?

  @@unique([roleId, employeeId])
  @@index([organizationId, employeeId])
}

// ─────────────────────────── TRAINING REQUESTS AND EVALUATION ───────────────────────────

enum TrainingRequestStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum TrainingEvaluationKind {
  PARTICIPANT
  MANAGER
}

/// A manager's request for a course for one of their direct reports (HR for anyone). HR decides; accepting only adds a training need.
model TrainingRequest {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id])
  employeeId        String
  employee          Employee              @relation(fields: [employeeId], references: [id])
  courseName        String
  reason            String
  status            TrainingRequestStatus @default(REQUESTED)
  requestedByUserId String
  requestedBy       String
  requestedAt       DateTime              @default(now())
  decidedByUserId   String?
  decidedBy         String?
  decidedAt         DateTime?
  /// The reason for a decline.
  decisionNote      String?
  withdrawReason    String?
  /// The training need an accepted request created.
  needId            String?               @unique
  need              TrainingNeed?         @relation(fields: [needId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, employeeId])
}

/// One answer about a course that was attended: the participant's (was it useful?) or the manager's (was it applied on the job?). Changes nothing about the person.
model TrainingEvaluation {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id])
  enrolmentId    String
  enrolment      TrainingEnrolment      @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  kind           TrainingEvaluationKind
  rating         Int
  comment        String?
  byUserId       String
  byName         String
  createdAt      DateTime               @default(now())

  @@unique([enrolmentId, kind])
  @@index([organizationId, kind])
}

// ─────────────────────────── SKILLS AND SKILL GAPS ───────────────────────────

/// A skill the company cares about (Shift supervision, First aid response). The company starts with none. Linked to the courses that build it by course name.
model Skill {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  /// The courses that build this skill, by course name (matched the way training compliance matches course names).
  courses        String[]     @default([])
  active         Boolean      @default(true)
  createdBy      String
  createdAt      DateTime     @default(now())

  roleSkills  RoleSkill[]
  assessments SkillAssessment[]

  @@unique([organizationId, name])
}

/// The level of a skill a role (employee category) needs, 1 (Aware) to 4 (Expert).
model RoleSkill {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  categoryId     String
  category       EmployeeCategory @relation(fields: [categoryId], references: [id])
  skillId        String
  skill          Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  requiredLevel  Int
  createdBy      String
  createdAt      DateTime         @default(now())

  @@unique([categoryId, skillId])
  @@index([organizationId])
}

/// One assessment of one person's level of one skill. Append-only: the current level is the latest; a correction is a new assessment. The employee reads all of it.
model SkillAssessment {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  employeeId       String
  employee         Employee     @relation(fields: [employeeId], references: [id])
  skillId          String
  skill            Skill        @relation(fields: [skillId], references: [id])
  level            Int
  comment          String?
  assessedOn       DateTime     @db.Date
  assessedByUserId String
  assessedBy       String
  createdAt        DateTime     @default(now())

  @@index([organizationId, employeeId, skillId])
}

// ─────────────────────────── ENGAGEMENT SURVEYS ───────────────────────────
// Anonymous by design: an ANSWER carries no person, no user, no time and a random id (a UUID, not an id that orders by time). Who has taken part is kept only on the
// access-code row, and no page lists it: HR sees counts. The code and the answer are separated in one step: the code is marked used, the answer is stored without it.

enum SurveyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum SurveyQuestionKind {
  SCALE
  COMMENT
}

enum SurveyCodeStatus {
  ACTIVE
  USED
  CANCELLED
}

/// An engagement survey: a few five-point statements and optional comments, for everyone, one role or one department.
model Survey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  intro          String?
  /// The audience: everyone when both are null, otherwise one role or one department.
  categoryId     String?
  departmentId   String?
  opensOn        DateTime     @db.Date
  closesOn       DateTime     @db.Date
  status         SurveyStatus @default(DRAFT)
  /// Employees invited when it was opened.
  invitedCount   Int          @default(0)
  closedAt       DateTime?
  /// What the company is doing about the results; every invited employee can read it.
  followUp       String?
  /// When the raw answers were deleted (the anonymised results are kept in SurveyAggregate).
  rawDeletedAt   DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())

  questions SurveyQuestion[]
  codes     SurveyAccessCode[]
  sessions  SurveyKioskSession[]
  aggregate SurveyAggregate?

  @@index([organizationId, status])
}

model SurveyQuestion {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  surveyId       String
  survey         Survey             @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  position       Int
  kind           SurveyQuestionKind
  text           String

  answers SurveyAnswer[]

  @@index([surveyId, position])
}

/// One invited employee's single-use access code (stored only as a hash). It is the participation record: HR sees counts of used and unused, never which.
model SurveyAccessCode {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  surveyId       String
  survey         Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id])
  /// The group the person belonged to when invited (for a breakdown, shown only when safe).
  categoryId     String?
  departmentId   String?
  codeHash       String           @unique
  status         SurveyCodeStatus @default(ACTIVE)
  /// The day it was used (a day only).
  usedOn         DateTime?        @db.Date
  createdAt      DateTime         @default(now())

  @@index([surveyId, status])
  @@index([surveyId, employeeId])
}

/// One submitted survey. NO person, NO user, NO time: only the survey and the group labels used for a breakdown. The id is a random UUID.
model SurveyResponse {
  id           String  @id @default(uuid())
  surveyId     String
  categoryId   String?
  departmentId String?

  answers SurveyAnswer[]

  @@index([surveyId])
}

/// One answer. No time, a random id. A comment HR hides (for example one that names a person) stays out of the results.
model SurveyAnswer {
  id           String         @id @default(uuid())
  responseId   String
  response     SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId   String
  question     SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value        Int?
  comment      String?
  hidden       Boolean        @default(false)
  hiddenReason String?

  @@index([questionId])
}

/// A record that an authorised HR representative ran an assisted session: the survey, the day and the device. Never who took part.
model SurveyKioskSession {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  surveyId        String
  survey          Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  day             DateTime     @db.Date
  deviceLabel     String
  startedByUserId String
  createdAt       DateTime     @default(now())
}

/// The anonymised results kept after the raw answers are deleted.
model SurveyAggregate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  surveyId       String       @unique
  survey         Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  summary        Json
  createdAt      DateTime     @default(now())
}

// ─────────────────────────── DELEGATED HR OFFICER ───────────────────────────

enum HrFunction {
  WELFARE
  SURVEYS
  SURVEY_ASSIST
  SUCCESSION
}

/// One of four fixed HR functions granted to a Delegated HR Officer by the Company Administrator. Live until revoked or past its end date.
model UserFunctionGrant {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  function         HrFunction
  /// Why it was granted (kept; never shown outside Settings > HR officers).
  reason           String
  grantedByUserId  String
  grantedBy        String
  grantedAt        DateTime     @default(now())
  /// The last day it counts (null = no end).
  endsOn           DateTime?    @db.Date
  revokedAt        DateTime?
  revokedByUserId  String?
  revokedBy        String?
  revokeReason     String?

  @@index([userId, function])
  @@index([organizationId])
}

// ─────────────────────────── RETENTION SCHEDULE AND LEGAL HOLDS ───────────────────────────

enum RetentionCategory {
  EMPLOYEE_FILE
  APPRAISALS
  PROBATION
  FEEDBACK
  IMPROVEMENT_PLANS
  DISCIPLINARY
  TRAINING
  SKILLS
  WELFARE_CASES
  SUCCESSION
  RAW_SURVEYS
  SURVEY_REPORTS
  AUDIT_LOGS
  UNSUCCESSFUL_APPLICANTS
  ACCESS_LOGS
}

enum RetentionTrigger {
  AFTER_EXIT
  AFTER_CLOSURE
  AFTER_RECORD_DATE
  AFTER_SURVEY_CLOSE
  AFTER_RECRUITMENT_CLOSE
  AFTER_ACCOUNT_CLOSURE
}

enum RetentionAction {
  DELETE
  ANONYMISE
  REVIEW
  KEEP
}

enum RetentionHoldScope {
  EMPLOYEE
  CATEGORY
  COMPANY
}

/// How long one category of record is kept, counted from what, and what happens then. The founder’s proposed defaults are loaded UNVERIFIED (verifiedOn null) until the legal adviser has seen them;
/// changing a rule clears its verification. A company has at most one rule per category.
model RetentionRule {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  category       RetentionCategory
  periodMonths   Int
  trigger        RetentionTrigger
  action         RetentionAction
  /// Why this is the rule, in a line (for the legal adviser).
  note           String?
  /// "Legal adviser verified on and by": the day, and the adviser’s name as given (not a user of the system).
  verifiedOn     DateTime?         @db.Date
  verifiedBy     String?
  verifiedNote   String?
  /// The user who recorded the verification, or last changed the rule.
  updatedByUserId String?
  updatedBy       String?
  updatedAt       DateTime         @updatedAt

  @@unique([organizationId, category])
}

/// A legal hold: deletion is suspended for one person, one category of record, or the whole company, with a reason and a day to review it. Any HR administrator may place one; only the
/// Company Administrator may release it. The deletions that exist check for a live hold before they run.
model RetentionHold {
  id              String             @id @default(cuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id])
  scope           RetentionHoldScope
  employeeId      String?
  employee        Employee?          @relation(fields: [employeeId], references: [id])
  category        RetentionCategory?
  reason          String
  reviewOn        DateTime           @db.Date
  placedByUserId  String
  placedBy        String
  placedAt        DateTime           @default(now())
  releasedAt      DateTime?
  releasedByUserId String?
  releasedBy      String?
  releaseReason   String?

  @@index([organizationId, releasedAt])
}

// ─────────────────────────── RETENTION RUNS (governance step 3b-2) ───────────────────────────

enum RetentionRunStatus {
  PROPOSED
  EXECUTED
  REJECTED
}

/// One retention run for one kind of record: HR proposes it, a different person (the Company Administrator) confirms it, and confirming clears the WORDS of the records past their period and keeps the shape.
/// It records the rule as it stood, who proposed and who confirmed, the written acceptance where the rule was unverified, and what was done. Counts and ids only: no name and no record text.
model RetentionRun {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id])
  category           RetentionCategory
  status             RetentionRunStatus @default(PROPOSED)
  /// The rule as it stood when proposed: confirming checks it has not changed since.
  periodMonths       Int
  trigger            RetentionTrigger
  action             RetentionAction
  ruleVerified       Boolean            @default(false)
  /// What the proposal covered, and what it left out (held by a legal hold, or someone with a case or a data request still open).
  itemCount          Int
  skippedHeld        Int                @default(0)
  skippedOpen        Int                @default(0)
  proposedAt         DateTime           @default(now())
  proposedByUserId   String
  proposedBy         String
  decidedAt          DateTime?
  decidedByUserId    String?
  decidedBy          String?
  /// The confirmer's note, or the reason a run was turned down. Where the rule was unverified or the confirmer was the only holder it is the written acceptance or reason (at least 20 characters).
  decisionNote       String?
  acceptedUnverified Boolean            @default(false)
  singleHolder       Boolean            @default(false)
  /// What confirming did: how many items were cleared, how many were left out because a hold or an open case appeared since the proposal, and the records touched by kind.
  clearedItems       Int?
  skippedAtConfirm   Int?
  summary            Json?
  items              RetentionRunItem[]

  @@index([organizationId, status])
  @@index([organizationId, category])
}

/// What one run covered, one row per person (or per record): the ledger that stops a second run redoing the same items and keeps them out of the "what is due" count once cleared.
model RetentionRunItem {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  runId          String
  run            RetentionRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  category       RetentionCategory
  /// The person (employee id) or, for a welfare case or a succession entry counted per record, the record id.
  subjectId      String
  employeeId     String?
  clearedAt      DateTime?
  skippedReason  String?

  @@unique([runId, subjectId])
  @@index([organizationId, category, clearedAt])
}
