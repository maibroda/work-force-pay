  journalApprovalRequired   Boolean                    @default(true)
  /// Whether invoices are generated as drafts that a second person approves before they post. Off: invoices post when generated.
  invoiceApprovalRequired   Boolean                    @default(false)
  /// Whether every sign-off on a period's close checklist must be done before the period can be closed.
  closeChecklistRequired    Boolean                    @default(false)
  /// Three-way match: how far above the order's price (percent) a bill line may be before it needs a second person's approval.
  matchPricePct             Decimal                    @default(1) @db.Decimal(5, 2)
  /// Three-way match: how far above the quantity received (percent) a bill line may be. Zero means exact.
  matchQtyPct               Decimal                    @default(0) @db.Decimal(5, 2)
  /// A bill with no purchase order behind it needs a second person's approval at or above this amount (zero: every such bill).
  billApprovalThreshold     Decimal                    @default(500000) @db.Decimal(16, 2)
  /// Whether a payroll must be reconciled to the previous one and signed off before it can be submitted for approval.
  reconciliationRequired    Boolean                    @default(false)
  /// Payroll variance checks against the previous payroll: a change beyond these needs a written explanation before submission.
  varianceHeadcountPct      Decimal                    @default(5) @db.Decimal(5, 2)
  varianceEmployeePct       Decimal                    @default(20) @db.Decimal(5, 2)
  varianceTotalPct          Decimal                    @default(10) @db.Decimal(5, 2)
  /// An employee's net pay must move by at least this much (naira) to be flagged, so small amounts don't drown the real changes.
  varianceMinAmount         Decimal                    @default(5000) @db.Decimal(16, 2)
}

/// How a client's payroll month runs, agreed once: the dates below are worked out from it for each month.
model PayrollCalendarSetting {
  id                  String       @id @default(cuid())
  organizationId      String       @unique
  organization        Organization @relation(fields: [organizationId], references: [id])
  inputCutoffDay      Int          @default(20)
  draftWorkingDays    Int          @default(3)
  approvalWorkingDays Int          @default(2)
  payDayOfMonth       Int          @default(28)
  remittanceDueDay    Int          @default(10)
  /// Which inputs the client is expected to send each month.
  expectedInputs      String[]     @default(["ATTENDANCE", "OVERTIME", "ALLOWANCES", "DEDUCTIONS", "LOANS", "JOINERS_LEAVERS"])
  updatedBy           String?
  updatedAt           DateTime     @updatedAt
}

