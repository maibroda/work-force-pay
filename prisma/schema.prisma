// WorkforcePay — multi-tenant workforce deployment & payroll platform
// Hierarchy: Organization → Client → Contract → Beat (location)
// Every organization-owned record carries organizationId.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["queryCompiler", "driverAdapters"]
  engineType      = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

