# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforcepay?schema=public"
# Used only by automated tests (a separate database that tests reset)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforcepay_test?schema=public"
# Session signing secret — use a long random string in production (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-secret-string-of-at-least-32-chars"

# Optional — error tracking (https://sentry.io, free tier). Leave unset to disable entirely;
# the app runs identically either way, it just won't report unexpected errors anywhere.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# Optional — only needed to upload source maps to Sentry during `npm run build`.
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_xxxx"

# Optional — transactional email (password reset) via Resend (https://resend.com). Leave unset in
# development: reset links are logged to the server console instead of actually being emailed.
# RESEND_API_KEY="re_xxxx"
# EMAIL_FROM="WorkforcePay <noreply@yourdomain.com>"
# Base URL used to build links inside emails (defaults to http://localhost:3000).
# APP_URL="https://your-production-domain.com"
# Behind a proxy or a CDN? Say so, or the public unsubscribe address cannot tell visitors apart (it trusts no forwarding header by default, because anyone can send one).
# Either how many proxies the app sits behind (the n-th address from the right of x-forwarded-for is taken), or the one header your proxy sets:
# TRUSTED_PROXY_HOPS=1
# TRUSTED_IP_HEADER="cf-connecting-ip"

# Optional — switches on the daily HR digest job. A scheduler calls GET /api/cron/hr-digest with
# "Authorization: Bearer <this value>" (Vercel Cron sends it automatically). Leave unset to disable the endpoint.
# CRON_SECRET="a-long-random-string"

# Seals the audit log so any later change to it can be detected (rule 5). 32+ random characters; keep it OFF the database server and back it up
# separately: without it old seals cannot be checked. A scheduler calls /api/cron/audit-seal every minute, /api/cron/audit-verify daily and
# /api/cron/audit-heads weekly (see docs/going-live.md). Never reuse the example value.
# AUDIT_SEAL_KEY="change-me-generate-a-long-random-string-of-at-least-32-chars"

# Encrypts the stored employee documents (AES-256-GCM) and signs the short-lived download links. Exactly 32 random bytes, base64: generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it OFF the database server and back it up SEPARATELY from the database: without it the stored files cannot be read, and a lost key means the files are lost.
# Uploads and downloads are refused until it is set. Never reuse the example value, and never put the real key in the repository.
# DOCUMENT_ENCRYPTION_KEY="change-me-32-random-bytes-in-base64"
