# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforcepay?schema=public"
# Used only by automated tests (a separate database that tests reset)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workforcepay_test?schema=public"
# Session signing secret — use a long random string in production (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-secret-string-of-at-least-32-chars"

# Optional — error tracking (https://sentry.io, free tier). Leave unset to disable entirely;
# the app runs identically either way, it just won't report unexpected errors anywhere.
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"
# Optional — only needed to upload source maps to Sentry during `npm run build`.
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_xxxx"

# Optional — transactional email (password reset) via Resend (https://resend.com). Leave unset in
# development: reset links are logged to the server console instead of actually being emailed.
# RESEND_API_KEY="re_xxxx"
# EMAIL_FROM="WorkforcePay <noreply@yourdomain.com>"
# Base URL used to build links inside emails (defaults to http://localhost:3000).
# APP_URL="https://your-production-domain.com"
